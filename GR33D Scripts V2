        isOpen = not isOpen
        groupHeader.Text = " " .. groupTitle .. (isOpen and " ^" or " v")
        contentBox.Visible = isOpen
    end)
    return contentBox, startY + 32 + contentHeight
end

local function createToggleInGroup(parent, name, yPos, callback)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, 0, 0, 26)
    row.Position = UDim2.new(0, 0, 0, yPos)
    row.BackgroundTransparency = 1

    local label = Instance.new("TextLabel", row)
    label.Size = UDim2.new(0.65, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Color3.fromRGB(190, 190, 205)
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 10
    label.TextXAlignment = Enum.TextXAlignment.Left

    local switchBg = Instance.new("TextButton", row)
    switchBg.Size = UDim2.new(0, 32, 0, 16)
    switchBg.Position = UDim2.new(1, -32, 0.5, -8)
    switchBg.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
    switchBg.Text = ""
    Instance.new("UICorner", switchBg).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame", switchBg)
    knob.Size = UDim2.new(0, 12, 0, 12)
    knob.Position = UDim2.new(0, 2, 0.5, -6)
    knob.BackgroundColor3 = Color3.fromRGB(200, 200, 215)
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local activeState = false
    switchBg.MouseButton1Click:Connect(function()
        activeState = not activeState
        switchBg.BackgroundColor3 = activeState and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(40, 40, 52)
        knob:TweenPosition(activeState and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6),
            Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        callback(activeState)
    end)
end

local function createInputInGroup(parent, name, yPos, defaultVal, callback)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, 0, 0, 26)
    row.Position = UDim2.new(0, 0, 0, yPos)
    row.BackgroundTransparency = 1

    local label = Instance.new("TextLabel", row)
    label.Size = UDim2.new(0.5, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Color3.fromRGB(190, 190, 205)
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 10
    label.TextXAlignment = Enum.TextXAlignment.Left

    local textBox = Instance.new("TextBox", row)
    textBox.Size = UDim2.new(0, 48, 0, 20)
    textBox.Position = UDim2.new(1, -48, 0.5, -10)
    textBox.BackgroundColor3 = Color3.fromRGB(26, 26, 35)
    textBox.Text = tostring(defaultVal)
    textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    textBox.Font = Enum.Font.GothamBold
    textBox.TextSize = 10
    Instance.new("UICorner", textBox).CornerRadius = UDim.new(0, 4)

    textBox:GetPropertyChangedSignal("Text"):Connect(function() callback(textBox.Text) end)
    textBox.FocusLost:Connect(function() callback(textBox.Text) end)
end

local function createActionButtonInGroup(parent, name, yPos, color, callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, 0, 0, 24)
    btn.Position = UDim2.new(0, 0, 0, yPos)
    btn.BackgroundColor3 = color
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold    btn.TextSize = 10
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

