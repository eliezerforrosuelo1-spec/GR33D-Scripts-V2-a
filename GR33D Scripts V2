            or humanoid:GetState() == Enum.HumanoidStateType.Jumping) then
            setFlying(true)
        end
        lastJumpTapTime = 0
    else
        lastJumpTapTime = now
    end
    if jumpEnabled and not flyToggleEnabled then
        applyJump()
    end
end)

-- ==========================================
-- CHARACTER SETUP
-- ==========================================

local function setupCharacter(char)
    character = char
    rootPart = char:WaitForChild("HumanoidRootPart")
    humanoid = char:WaitForChild("Humanoid")

    originalCollision = {}
    lastBaseSpeed = humanoid.WalkSpeed
    lastBoostedWS = humanoid.WalkSpeed

    if rootPart:FindFirstChild("FlightAttachment") then rootPart.FlightAttachment:Destroy() end
    if rootPart:FindFirstChild("FlightVelocity") then rootPart.FlightVelocity:Destroy() end

    attachment = Instance.new("Attachment", rootPart)
    attachment.Name = "FlightAttachment"

    linearVelocity = Instance.new("LinearVelocity", rootPart)
    linearVelocity.Name = "FlightVelocity"
    linearVelocity.Attachment0 = attachment
    linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    linearVelocity.MaxForce = 0
    linearVelocity.VectorVelocity = Vector3.zero

    if not firstSpawnCaptured and rootPart then
        realSpawnCFrame = rootPart.CFrame
        firstSpawnCaptured = true
    end

    if noclipEnabled then applyNoclip(true) end
    watchCharacterForInvisibility(char)
    if invisibleEnabled then applyInvisibility(true) end
    if flyToggleEnabled then setFlying(true) end

    if promptExtenderEnabled then
        task.defer(function() enablePromptExtenderAll() end)
    end

    humanoid.Died:Connect(function()
        character = nil
        rootPart = nil
        humanoid = nil
        if invisConnection then invisConnection:Disconnect() invisConnection = nil end
    end)
end

task.spawn(function()
    setupCharacter(player.Character or player.CharacterAdded:Wait())
end)

player.CharacterAdded:Connect(function(c)
    isFlying = false
    isTPBusy = false
    originalTransparency = {}
    originalCollision = {}
    if linearVelocity then linearVelocity.MaxForce = 0 end
    setupCharacter(c)
end)
