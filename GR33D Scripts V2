-- ─────────────────────────────────────────

local function startMonsterScanner()
    if monsterScannerThread then return end
    monsterScannerThread = task.spawn(function()
        while aimbotEnabled do
            local list = {}
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("Model") and obj ~= character and not Players:GetPlayerFromCharacter(obj) then
                    local nameLower = obj.Name:lower()
                    local isFriendly = nameLower:find("shop") or nameLower:find("npc") or nameLower:find("dummy")
                        or nameLower:find("merchant") or nameLower:find("guide") or nameLower:find("bank") or nameLower:find("quest")
                    if not isFriendly then
                        local hum = obj:FindFirstChildOfClass("Humanoid")
                        local hrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("PrimaryPart")
                        if hum and hrp and hum.Health > 0 then table.insert(list, hrp) end
                    end
                end
            end
            cachedMonsters = list
            task.wait(1)
        end
        monsterScannerThread = nil
    end)
end

-- ─────────────────────────────────────────
-- 9. SUPER SPEED (lazy — only when toggled ON)
-- ─────────────────────────────────────────

local function startSpeedLoop()
    if speedConnection then return end
    speedConnection = RunService.Heartbeat:Connect(function(dt)
        if not humanoid then return end
        if runSpeedEnabled and not isFlying then
            local now = os.clock()
            if now - lastSpeedUpdate > 1 then
                local jitter = math.random(45, 60) / 10
                humanoid.WalkSpeed = runSpeedValue + jitter
                lastSpeedUpdate = now
            end
        end
    end)
end

local function stopSpeedLoop()
    if speedConnection then
        speedConnection:Disconnect()
        speedConnection = nil
        if humanoid then humanoid.WalkSpeed = defaultWalkSpeed end
    end
end

-- ─────────────────────────────────────────
-- 10. NOCLIP (lazy — only when toggled ON)
-- ─────────────────────────────────────────

local function startNoclipLoop()
    if noclipConnection then return end
    noclipConnection = RunService.Stepped:Connect(function()
        if character then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end)
end

local function stopNoclipLoop()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
        if character then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = true
                end
            end
        end
    end
end

-- ─────────────────────────────────────────
-- 11. MAIN RENDER LOOP (lazy — only starts when any feature ON)
-- ─────────────────────────────────────────

local function mainRenderStep(dt)
    if not camera or not camera.Parent then camera = workspace.CurrentCamera return end

    if godModeEnabled and humanoid then
        pcall(function()
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        end)
    end

    if isFlying and bodyVelocity and humanoid and rootPart then
        if humanoid.FloorMaterial ~= Enum.Material.Air then
            -- flight toggle ON but landed — do not auto re-fly
        else
            local ctrl = getControls()
            if ctrl then
                local moveVector = ctrl:GetMoveVector()
                if moveVector.Magnitude > 0 then
                    local camCFrame = camera.CFrame
                    local flightDir = (camCFrame.RightVector * moveVector.X) - (camCFrame.LookVector * moveVector.Z)
                    bodyVelocity.Velocity = flightDir.Unit * FLY_SPEED + Vector3.new(0, -2, 0)
                else
                    bodyVelocity.Velocity = Vector3.new(0, -2, 0)
                end
            end
        end
    end

    if jumpEnabled and humanoid then
        pcall(function()
            humanoid.UseJumpPower = true
            humanoid.JumpPower    = jumpPowerValue
        end)
    end

    if rapidHealingEnabled and humanoid and humanoid.Health < humanoid.MaxHealth and humanoid.Health > 0 then
        humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + (humanoid.MaxHealth * 0.02))
    end

    if noFallDamageEnabled and rootPart and humanoid then
        if humanoid:GetState() == Enum.HumanoidStateType.Freefall
            or humanoid:GetState() == Enum.HumanoidStateType.FallingDown then
            pcall(function()
                if rootPart.AssemblyLinearVelocity.Y < -45 then
                    rootPart.AssemblyLinearVelocity = Vector3.new(rootPart.AssemblyLinearVelocity.X, 0, rootPart.AssemblyLinearVelocity.Z)
                end
            end)
        end
    end

    if antiMeleeEnabled and rootPart and humanoid then
        local currentVel = rootPart.AssemblyLinearVelocity
        if humanoid.MoveDirection.Magnitude == 0 and not isFlying and not runSpeedEnabled then
            if math.abs(currentVel.X) > 4 or math.abs(currentVel.Z) > 4 then
                rootPart.AssemblyLinearVelocity = Vector3.new(0, currentVel.Y, 0)
            end
        end
    end

    if hitboxEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = p.Character.HumanoidRootPart
                if not originalHitboxSizes[hrp] then originalHitboxSizes[hrp] = hrp.Size end
                hrp.Size = Vector3.new(5, 5, 5)
            end
        end
    end

    if slimHitboxEnabled and rootPart then
        rootPart.Size = Vector3.new(1.3, 2, 0.7)
    elseif not slimHitboxEnabled and rootPart and originalRootSize and rootPart.Size ~= originalRootSize then
        rootPart.Size = originalRootSize
    end

    if aimbotEnabled and rootPart then
        local nearestTarget, shortestDist = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local isTeammate = false
                if player.Team and p.Team then
                    if p.Team == player.Team or p.TeamColor == player.TeamColor then isTeammate = true end
                end
                if p:GetAttribute("Team") and player:GetAttribute("Team")
                    and p:GetAttribute("Team") == player:GetAttribute("Team") then isTeammate = true end
                if not isTeammate then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    if hrp and hum and hum.Health > 0 and not p.Character:FindFirstChildOfClass("ForceField") then
                        local dist = (hrp.Position - rootPart.Position).Magnitude
                        if dist < shortestDist then shortestDist = dist nearestTarget = hrp end
                    end
                end
            end
        end
        for _, hrp in ipairs(cachedMonsters) do
            if hrp and hrp.Parent then
                local hum = hrp.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local dist = (hrp.Position - rootPart.Position).Magnitude
                    if dist < shortestDist then shortestDist = dist nearestTarget = hrp end
                end
            end
        end
        if nearestTarget then
            local goalCFrame = CFrame.new(camera.CFrame.Position, nearestTarget.Position)
            camera.CFrame = camera.CFrame:Lerp(goalCFrame, math.clamp(dt * 8, 0.05, 0.3))
        end
    end
end

local function ensureMainLoopRunning()
    if mainRenderConnection then return end
    mainRenderConnection = RunService.RenderStepped:Connect(mainRenderStep)
end

local function stopMainLoopIfIdle()
    if not isAnyFeatureActive() and mainRenderConnection then
        mainRenderConnection:Disconnect()
        mainRenderConnection = nil
    end
end

-- ─────────────────────────────────────────
-- 12. RAPID FIRE (lazy — only on tool equip when ON)
-- ─────────────────────────────────────────

local function applyRapidFire(tool)
    for _, v in ipairs(tool:GetDescendants()) do
        if (v:IsA("NumberValue") or v:IsA("IntValue")) then
            local n = v.Name:lower()
            if n:find("cooldown") or n:find("delay") or n:find("fire") or n:find("rate")
                or n:find("speed") or n:find("mine") or n:find("dig") or n:find("swing")
                or n:find("hit") or n:find("power") then
                if not originalToolValues[v] then originalToolValues[v] = v.Value end
                if n:find("power") or n:find("speed") then
                    v.Value = originalToolValues[v] * 5
                else
                    v.Value = math.max(0.05, originalToolValues[v] * 0.15)
                end
            end
        end
    end
end

local function monitorTool(tool)
    if not rapidFireEnabled then return end
    if tool:IsA("Tool") then
        applyRapidFire(tool)
    end
end

-- ─────────────────────────────────────────
-- 13. FLIGHT
-- ─────────────────────────────────────────

local function setFlying(state)
    if not rootPart or not humanoid then return end
    isFlying = state
    if isFlying then
        if not bodyVelocity then
            bodyVelocity = Instance.new("BodyVelocity")
            bodyVelocity.Name = "FlightBV"
            bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            bodyVelocity.Velocity = Vector3.zero
            bodyVelocity.Parent = rootPart
        end
        humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
        ensureMainLoopRunning()
    else
        if bodyVelocity then
            bodyVelocity.Velocity = Vector3.zero
            bodyVelocity:Destroy()
            bodyVelocity = nil
        end
        if humanoid.FloorMaterial ~= Enum.Material.Air then
            humanoid:ChangeState(Enum.HumanoidStateType.Running)
        end
        stopMainLoopIfIdle()
    end
end

local function handleJumpTap()
    if not flyToggleEnabled then return end
    local currentTime = os.clock()
    local timeSinceLastTap = currentTime - lastJumpTapTime
    if timeSinceLastTap <= DOUBLE_TAP_WINDOW then
        if isFlying then setFlying(false)
        elseif humanoid and (humanoid:GetState() == Enum.HumanoidStateType.Freefall
            or humanoid:GetState() == Enum.HumanoidStateType.Jumping) then
            setFlying(true)
        end
        lastJumpTapTime = 0
    else
        lastJumpTapTime = currentTime
    end
end

UserInputService.JumpRequest:Connect(function()
    if not flyToggleEnabled then return end
    local currentTime = os.clock()
    if (currentTime - lastJumpReqTime) > 0.1 then handleJumpTap() end
    lastJumpReqTime = currentTime
end)

