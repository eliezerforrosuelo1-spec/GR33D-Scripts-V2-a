local function SafeTeleport(targetCFrame, options)
  refreshCharacterState()
  if not character or not rootPart then
    return
  end

  if runtimeState.teleportLock then
    return
  end

  options=options or {}
  local duration=type(options.duration)=="number" and math.max(0.25, options.duration) or 0.7
  local easingStyle=options.easingStyle or Enum.EasingStyle.Quad
  local easingDirection=options.easingDirection or Enum.EasingDirection.Out
  local finalCFrame=targetCFrame and targetCFrame+Vector3.new(0,2,0) or rootPart.CFrame

  if activeTeleportConnection then
    activeTeleportConnection:Disconnect()
    activeTeleportConnection=nil
  end

  runtimeState.teleportLock=true
  local startCFrame=rootPart.CFrame
  local startTime=os.clock()
  local currentConnection=RunService.RenderStepped:Connect(function()
    if not rootPart or not character then
      currentConnection:Disconnect()
      activeTeleportConnection=nil
      runtimeState.teleportLock=false
      return
    end

    local elapsed=os.clock()-startTime
    local alpha=math.clamp(elapsed/duration,0,1)
    local eased=alpha*alpha*(3-(2*alpha))

    if easingStyle==Enum.EasingStyle.Linear then
      eased=alpha
    elseif easingStyle==Enum.EasingStyle.Quad then
      eased=easingDirection==Enum.EasingDirection.In and (alpha*alpha) or (1-(1-alpha)*(1-alpha))
    elseif easingStyle==Enum.EasingStyle.Cubic then
      eased=easingDirection==Enum.EasingDirection.In and (alpha*alpha*alpha) or (1-math.pow(1-alpha,3))
    end

    rootPart.CFrame=startCFrame:Lerp(finalCFrame,eased)

    if alpha>=1 then
      currentConnection:Disconnect()
      activeTeleportConnection=nil
      rootPart.CFrame=finalCFrame
      runtimeState.teleportLock=false
    end
  end)

  activeTeleportConnection=currentConnection
end

