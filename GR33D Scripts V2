-- 4. CONTROLS (only needed for flight)
-- ─────────────────────────────────────────

local controls = nil
local function getControls()
    if controls then return controls end
    pcall(function()
        local playerScripts = player:WaitForChild("PlayerScripts", 5)
        if playerScripts then
            local playerModuleScript = playerScripts:WaitForChild("PlayerModule", 5)
            if playerModuleScript then
                controls = require(playerModuleScript):GetControls()
            end
        end
    end)
    return controls
end

-- ─────────────────────────────────────────
-- 5. HEALTH HOOK (lazy — only when God/Mega enabled)
-- ─────────────────────────────────────────

local function installHealthHook()
    if healthHookInstalled then return end
    healthHookInstalled = true
    pcall(function()
        local mt = getrawmetatable(game)
        oldNewIndex = hookfunction(mt.__newindex, newcclosure(function(t, k, v)
            if not checkcaller() and typeof(t) == "Instance" and t:IsA("Humanoid") then
                local char = game.Players.LocalPlayer.Character
                if char and t:IsDescendantOf(char) then
                    if k == "Health" and (godModeEnabled or megaHealthEnabled) then
                        local safeVal = math.max(1, math.min(v, t.MaxHealth))
                        return oldNewIndex(t, k, safeVal)
                    end
                    if k == "MaxHealth" and megaHealthEnabled and v < 10000 then
                        return oldNewIndex(t, k, v)
                    end
                end
            end
            return oldNewIndex(t, k, v)
        end))
    end)
end

-- ─────────────────────────────────────────
-- 6. KICK HOOK (lazy — only when God/Mega enabled)
-- ─────────────────────────────────────────

local kickSpoofReasons = {
    "Disconnected due to network error",
    "Lost connection to the server",
    "Network timeout, please rejoin",
}

local function installKickHook()
    if kickHookInstalled then return end
    kickHookInstalled = true
    pcall(function()
        oldKick = hookfunction(player.Kick, newcclosure(function(self, ...)
            local args = {...}
            if args[1] then args[1] = kickSpoofReasons[math.random(#kickSpoofReasons)] end
            return oldKick(self, unpack(args))
        end))
    end)
end

-- ─────────────────────────────────────────
-- 7. STEALTH TELEPORT (pure function — only runs when called)
-- ─────────────────────────────────────────

local function stealthTeleport(destCFrame, duration)
    if not rootPart then return end
    duration = math.max(duration or 0.05, 0.03)
    local startCFrame = rootPart.CFrame
    local steps = math.max(4, math.floor(duration / 0.008))
    local stepTime = math.max(duration / steps, 0.008)

    for i = 1, steps do
        local alpha = i / steps
        local newCF = startCFrame:Lerp(destCFrame, alpha)
        local delta = newCF.Position - rootPart.Position
        if delta.Magnitude > 1e-4 then
            rootPart.AssemblyLinearVelocity = delta / stepTime
        else
            rootPart.AssemblyLinearVelocity = Vector3.zero
        end
        rootPart.CFrame = newCF
        RunService.Heartbeat:Wait()
    end
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
end

