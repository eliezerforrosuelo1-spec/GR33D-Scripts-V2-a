-- ---------- DRAG HANDLER (mobile + PC) ----------

local function clampPanelPosition()
    local cam = workspace.CurrentCamera
    if not cam then return end

    local vp = cam.ViewportSize
    local abs = mainFrame.AbsolutePosition

    local minX = VIEWPORT_PADDING
    local maxX = math.max(minX, vp.X - PANEL_W - VIEWPORT_PADDING)
    local minY = VIEWPORT_PADDING
    local maxY = math.max(minY, vp.Y - PANEL_H - VIEWPORT_PADDING)

    local x = math.clamp(abs.X, minX, maxX)
    local y = math.clamp(abs.Y, minY, maxY)

    mainFrame.Position = UDim2.fromOffset(x, y)
end

local dragging   = false
local dragStart  = nil
local startPos   = nil

local function beginDrag(input)
    dragging = true
    dragStart = input.Position

    -- Convert the initial scale-based position into absolute offsets before drag
    -- math so clamping cannot jump when the first drag begins.
    local abs = mainFrame.AbsolutePosition
    mainFrame.Position = UDim2.fromOffset(abs.X, abs.Y)
    startPos = mainFrame.Position
end

local function updateDrag(input)
    if not dragging or not dragStart or not startPos then return end
    local delta = input.Position - dragStart
    mainFrame.Position = UDim2.new(
        startPos.X.Scale, startPos.X.Offset + delta.X,
        startPos.Y.Scale, startPos.Y.Offset + delta.Y
    )
    clampPanelPosition()
end

local function endDrag()
    dragging = false
    dragStart = nil
    startPos  = nil
end

