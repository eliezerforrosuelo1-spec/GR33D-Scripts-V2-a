RunService.RenderStepped:Connect(function(dt)
  if not camera or not camera.Parent then camera=workspace.CurrentCamera return end
  if godModeEnabled and humanoid then
    humanoid.Health=humanoid.MaxHealth
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead,false)
    if character then
      for _,part in ipairs(character:GetDescendants())do if part:IsA("BasePart")then part.Transparency=1 end end
    end
  elseif character and not godModeEnabled then
    for _,part in ipairs(character:GetDescendants())do if part:IsA("BasePart")and part.Transparency==1 then part.Transparency=0 end end
  end
  if megaHealthEnabled and humanoid and humanoid.Health<humanoid.MaxHealth then humanoid.Health=humanoid.MaxHealth end
  
  if isFlying and linearVelocity and humanoid and rootPart then
    if humanoid.FloorMaterial~=Enum.Material.Air then setFlying(false)
    elseif controls then
      local mv=controls:GetMoveVector()
      if mv.Magnitude>0 then
        local cc=camera.CFrame
        local fd=(cc.RightVector*mv.X)-(cc.LookVector*mv.Z)
        local targetVel=fd.Unit*FLY_SPEED
        local currentVel=linearVelocity.VectorVelocity
        local newVel=currentVel:Lerp(targetVel,0.3)
        linearVelocity.VectorVelocity=newVel+Vector3.new((math.random()-0.5)*1,(math.random()-0.5)*0.5,(math.random()-0.5)*1)
      else
        linearVelocity.VectorVelocity=linearVelocity.VectorVelocity*0.9
      end
    end
  end

  if jumpEnabled and humanoid then pcall(function() humanoid.UseJumpPower=true humanoid.JumpPower=jumpPowerValue end)
  elseif not jumpEnabled and humanoid then pcall(function() if humanoid.JumpPower~=defaultJumpPower then humanoid.JumpPower=defaultJumpPower end end) end

  if rapidHealingEnabled and humanoid and humanoid.Health<humanoid.MaxHealth and humanoid.Health>0 then
    humanoid.Health=math.min(humanoid.MaxHealth,humanoid.Health+(humanoid.MaxHealth*0.15))
  end

  if noFallDamageEnabled and rootPart and humanoid then
    if humanoid:GetState()==Enum.HumanoidStateType.Freefall or humanoid:GetState()==Enum.HumanoidStateType.FallingDown then
      pcall(function() if rootPart.AssemblyLinearVelocity.Y<-45 then rootPart.AssemblyLinearVelocity=Vector3.new(rootPart.AssemblyLinearVelocity.X,0,rootPart.AssemblyLinearVelocity.Z) end end)
    end
  end

  if antiMeleeEnabled and rootPart and humanoid then
    local cv=rootPart.AssemblyLinearVelocity
    local moveDir=humanoid.MoveDirection
    if humanoid.State~=Enum.HumanoidStateType.Freefall and humanoid.State~=Enum.HumanoidStateType.Jumping then
      if moveDir.Magnitude<0.1 then
        if math.abs(cv.X)>4 or math.abs(cv.Z)>4 then rootPart.AssemblyLinearVelocity=Vector3.new(0,cv.Y,0) end
      end
    end
  end

  if hitboxEnabled then
    for _,p in ipairs(Players:GetPlayers())do
      if p~=player and p.Character and p.Character:FindFirstChild("HumanoidRootPart")then
        local hrp=p.Character.HumanoidRootPart
        if not originalHitboxSizes[hrp]then originalHitboxSizes[hrp]=hrp.Size end
        hrp.Size=Vector3.new(8,8,8) hrp.Transparency=0.7 hrp.CanCollide=false
      end
    end
  end

  if slimHitboxEnabled and rootPart then rootPart.Size=Vector3.new(1.3,2,0.7)
  elseif not slimHitboxEnabled and rootPart and originalRootSize and rootPart.Size~=originalRootSize then rootPart.Size=originalRootSize end

  if thirdPersonCamEnabled and rootPart then
    camera.CameraType=Enum.CameraType.Scriptable
    local head=character and character:FindFirstChild("Head")or rootPart
    camera.CFrame=CFrame.new(head.Position+Vector3.new(0,1,0))*camera.CFrame.Rotation*CFrame.new(0,3.5,-8)
  elseif not thirdPersonCamEnabled and camera.CameraType==Enum.CameraType.Scriptable then
    camera.CameraType=Enum.CameraType.Custom
  end

  if aimbotEnabled and rootPart and character then
    local nt,sd=nil,math.huge
    local maxAimbotRange=150

    for _,p in ipairs(Players:GetPlayers())do
      if p~=player and p.Character then
        local isTeammate=false
        if player.Team and p.Team and(p.Team==player.Team or p.TeamColor==player.TeamColor)then isTeammate=true end
        if p:GetAttribute("Team")and player:GetAttribute("Team")and p:GetAttribute("Team")==player:GetAttribute("Team")then isTeammate=true end

        if not isTeammate then
          local hrp=p.Character:FindFirstChild("HumanoidRootPart") or p.Character:FindFirstChild("Head")
          local hum=p.Character:FindFirstChildOfClass("Humanoid")
          if hrp and hum and hum.Health>0 and not p.Character:FindFirstChildOfClass("ForceField")then
            local d=(hrp.Position-rootPart.Position).Magnitude
            if d<sd and d<maxAimbotRange then
              sd=d
              nt=hrp
            end
          end
        end
      end
    end

    for _,targetPart in ipairs(cachedMonsters)do
      if targetPart and targetPart.Parent then
        local model=targetPart.Parent
        local hum=model:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health>0 then
          local d=(targetPart.Position-rootPart.Position).Magnitude
          if d<sd and d<maxAimbotRange then
            sd=d
            nt=targetPart
          end
        end
      end
    end

    if nt then
      local targetPos=nt.Position
      local myPos=rootPart.Position
      local direction=Vector3.new(targetPos.X-myPos.X, 0, targetPos.Z-myPos.Z).Unit
      if direction.Magnitude>0 then
        local newCFrame=CFrame.new(rootPart.Position, rootPart.Position+direction)
        rootPart.CFrame=rootPart.CFrame:Lerp(newCFrame, math.clamp(dt*12, 0, 1))
      end
    end
  end
end)

