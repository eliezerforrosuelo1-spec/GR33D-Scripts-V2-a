RunService.Stepped:Connect(function()
    if not humanoid then return end
    if runSpeedEnabled and not isFlying then
        local target = math.min(runSpeedValue, MAX_WALKSPEED)
        humanoid.WalkSpeed = target
    elseif not runSpeedEnabled then
        -- Only reset once when off
        if humanoid.WalkSpeed > DEFAULT_WALKSPEED + 1 then
            humanoid.WalkSpeed = DEFAULT_WALKSPEED
        end
    end
end)

-- ==========================================
-- JUMP (velocity impulse = 107 from working cheat)
-- ==========================================

local function applyJump()
    if not jumpEnabled or not rootPart or not humanoid then return end
    if humanoid.FloorMaterial == Enum.Material.Air then return end
    if os.clock() - lastJumpReqTime < 0.15 then return end
    lastJumpReqTime = os.clock()

    local impulse = math.min(jumpPowerValue, 107)
    rootPart.AssemblyLinearVelocity = Vector3.new(
        rootPart.AssemblyLinearVelocity.X,
        impulse,
        rootPart.AssemblyLinearVelocity.Z
    )
    log("JUMP", string.format("impulse=%.1f", impulse))
end

-- ==========================================
-- AUTO RUN (move toward a target position continuously)
-- ==========================================

RunService.RenderStepped:Connect(function(dt)
    if not autoRunEnabled or not rootPart or not autoRunTarget then return end
    if isTPBusy then return end

    local delta = autoRunTarget - rootPart.Position
    local dist = delta.Magnitude
    if dist < 5 then
        autoRunTarget = nil
        return
    end

    local step = delta.Unit * math.min(MAX_HOP_STUDS, dist)
    rootPart.CFrame = rootPart.CFrame + step
end)

