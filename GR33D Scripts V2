local function removePromptExtender(prompt)
    local saved = trackedPrompts[prompt]
    if not saved then return end
    pcall(function()
        if prompt and prompt.Parent then
            prompt.MaxActivationDistance = saved.MaxActivationDistance
            prompt.HoldDuration          = saved.HoldDuration
            prompt.RequiresLineOfSight   = saved.RequiresLineOfSight
        end
    end)
    trackedPrompts[prompt] = nil
end

local function applyPromptExtender(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end

    local playerRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local playerPos = playerRoot and playerRoot.Position or Vector3.zero
    local promptPos = prompt.WorldPosition or (prompt.Parent and prompt.Parent.Position) or playerPos
    local dist = (promptPos - playerPos).Magnitude

    if not trackedPrompts[prompt] then
        trackedPrompts[prompt] = {
            MaxActivationDistance = prompt.MaxActivationDistance,
            HoldDuration          = prompt.HoldDuration,
            RequiresLineOfSight   = prompt.RequiresLineOfSight,
        }
    end

    if dist <= PROMPT_MAX_DISTANCE + 10 then
        pcall(function()
            prompt.MaxActivationDistance = PROMPT_MAX_DISTANCE
            prompt.HoldDuration = PROMPT_HOLD_DURATION
            prompt.RequiresLineOfSight = PROMPT_REQUIRES_LOS
        end)
    else
        removePromptExtender(prompt)
    end
end

local function enablePromptExtenderAll()
    local count = 0
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            applyPromptExtender(obj)
            count = count + 1
        end
    end
    log("PROMPT", "Extended " .. count .. " prompts")
end

local function disablePromptExtenderAll()
    for prompt, _ in pairs(trackedPrompts) do
        removePromptExtender(prompt)
    end
    trackedPrompts = {}
    log("PROMPT", "Disabled")
end

workspace.DescendantAdded:Connect(function(obj)
    if promptExtenderEnabled and obj:IsA("ProximityPrompt") then
        applyPromptExtender(obj)
    end
end)

local function refreshPromptExtender()
    if not promptExtenderEnabled then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            applyPromptExtender(obj)
        end
    end
end

-- ==========================================
-- NOCLIP
-- ==========================================

local function applyNoclip(state)
    noclipEnabled = state
    if not character then return end
    if state then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if originalCollision[part] == nil then
                    originalCollision[part] = part.CanCollide
                end
                if part.CanCollide then
                    pcall(function()
                        part.CanCollide = false
                    end)
                end
            end
        end
    else
        task.defer(function()
            for part, orig in pairs(originalCollision) do
                if part and part.Parent then
                    pcall(function()
                        part.CanCollide = orig
                    end)
                end
            end
            originalCollision = {}
        end)
    end
end

RunService.Stepped:Connect(function()
    if not character or not noclipEnabled then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            if originalCollision[part] == nil then
                originalCollision[part] = true
            end
            part.CanCollide = false
        end
    end
end)

-- ==========================================
-- SPEED (CFrame Offset - Anti-Rubberband)
-- ==========================================

local function restoreNormalMovementState()
    if not humanoid then return end
    humanoid.AutoRotate = true
    humanoid.WalkSpeed = originalWalkSpeed
    if rootPart then
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
    end
    if speedLinearVelocity then
        speedLinearVelocity.MaxForce = 0
        speedLinearVelocity.VectorVelocity = Vector3.zero
    end
end

local function applyRapidDashStep(moveDir, dt)
    if not rootPart or not humanoid then return end
    local steer = Vector3.new(moveDir.X, 0, moveDir.Z)
    if steer.Magnitude <= 0.01 then return end

    local clampedSpeed = math.clamp(runSpeedValue, 0, MAX_SPEED_INPUT)
    local speedRatio = clampedSpeed / MAX_SPEED_INPUT
    local effectiveSpeed = 85 + (speedRatio * MAX_EFFECTIVE_SPEED)

    local stepDistance = math.clamp((effectiveSpeed * dt * RAPID_DASH_DAMPING), RAPID_DASH_MIN_STEP, RAPID_DASH_MAX_STEP)
    local moveVector = steer.Unit * stepDistance

    rootPart.CFrame = rootPart.CFrame + moveVector
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero

    if speedLinearVelocity then
        speedLinearVelocity.MaxForce = 0
        speedLinearVelocity.VectorVelocity = Vector3.zero
    end

    humanoid.WalkSpeed = 0
    humanoid.AutoRotate = false
    pcall(function()
        humanoid:Move(Vector3.zero, false)
    end)
end

RunService.RenderStepped:Connect(function(dt)
    if not humanoid or not rootPart then return end

    if not runSpeedEnabled then
        if observeCheatMode then
            startCheatObserver()
        end
        return
    end

    if speedLinearVelocity then
        if isFlying or isTPBusy then
            speedLinearVelocity.MaxForce = 0
            speedLinearVelocity.VectorVelocity = Vector3.zero
            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
            humanoid.WalkSpeed = 0
            humanoid.AutoRotate = false
        else
            local st = humanoid:GetState()
            if st == Enum.HumanoidStateType.Dead
                or st == Enum.HumanoidStateType.Ragdoll
                or st == Enum.HumanoidStateType.Climbing
                or st == Enum.HumanoidStateType.Swimming
                or humanoid.Sit then
                speedLinearVelocity.MaxForce = 0
                speedLinearVelocity.VectorVelocity = Vector3.zero
                rootPart.AssemblyLinearVelocity = Vector3.zero
                rootPart.AssemblyAngularVelocity = Vector3.zero
                humanoid.WalkSpeed = 0
                humanoid.AutoRotate = false
            else
                humanoid.WalkSpeed = 0
                humanoid.AutoRotate = false
                autoRotateWasEnabled = true

                local moveDir = humanoid.MoveDirection
                if moveDir.Magnitude > 0 then
                    applyRapidDashStep(moveDir, dt)

                    if observeCheatMode then
                        logPhysicsSnapshot("SPEED_MOVE")
                    end
                else
                    speedLinearVelocity.MaxForce = 0
                    speedLinearVelocity.VectorVelocity = Vector3.zero
                    rootPart.AssemblyLinearVelocity = Vector3.zero
                    rootPart.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end
    end

    if observeCheatMode and not runSpeedEnabled then
        startCheatObserver()
    end
end)

-- ==========================================
-- JUMP (Direct Impulse)
-- ==========================================

local function applyJump()
    if not jumpEnabled or not rootPart or not humanoid then return end

    local state = humanoid:GetState()
    if state == Enum.HumanoidStateType.Dead
        or state == Enum.HumanoidStateType.Ragdoll
        or state == Enum.HumanoidStateType.Freefall
        or state == Enum.HumanoidStateType.FallingDown
        or state == Enum.HumanoidStateType.Swimming
        or state == Enum.HumanoidStateType.Climbing then
        return
    end

    if os.clock() - lastJumpReqTime < 0.15 then return end
    lastJumpReqTime = os.clock()

    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    local impulse = math.min(jumpPowerValue, MAX_JUMP_IMPULSE)
    local vel = rootPart.AssemblyLinearVelocity
    rootPart.AssemblyLinearVelocity = Vector3.new(
        vel.X,
        impulse,
        vel.Z
    )
end

-- ==========================================
-- ADVANCED TELEPORT SYSTEM
-- ==========================================

local function getSafeGroundPosition(targetCFrame)
    local origin = targetCFrame.Position + Vector3.new(0, 15, 0)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    if character then
        raycastParams.FilterDescendantsInstances = {character}
    end

    local rayResult = workspace:Raycast(origin, Vector3.new(0, -60, 0), raycastParams)
    if rayResult then
        return CFrame.new(rayResult.Position + Vector3.new(0, 3.5, 0)) * targetCFrame.Rotation
    end
    return targetCFrame + Vector3.new(0, 3, 0)
end

local function absoluteTeleport(targetCFrame, useInterpolation)
    if not character or not rootPart or not humanoid then return end
    if isTPBusy then return end
    isTPBusy = true

    local wasRunSpeedEnabled = runSpeedEnabled
    runSpeedEnabled = false
    if speedLinearVelocity then
        speedLinearVelocity.MaxForce = 0
        speedLinearVelocity.VectorVelocity = Vector3.zero
    end

    local safeCFrame = getSafeGroundPosition(targetCFrame)
    local startCFrame = rootPart.CFrame
    local distance = (safeCFrame.Position - startCFrame.Position).Magnitude
    local riskyMode = shouldUseInstantTeleport() or (useInterpolation == false)

    log("TP", string.format("Starting TP | Mode: %s | Distance: %.1f studs | Risky: %s",
        riskyMode and "Risky" or "Safe", distance, tostring(riskyMode)))
    if observeCheatMode then
        logPhysicsSnapshot("TP_BEFORE")
    end

    local wasNoFall = noFallDamageEnabled
    noFallDamageEnabled = true
    freezeCharacterForTeleport()

    if riskyMode then
        character:PivotTo(safeCFrame)
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
        task.wait(0.03)
    else
        local stepDistance = 16
        local stepWait = 0.012
        local steps = math.max(math.ceil(distance / stepDistance), 4)

        for i = 1, steps do
            if not rootPart or not rootPart.Parent then break end
            local alpha = i / steps
            local nextCFrame = startCFrame:Lerp(safeCFrame, alpha)
            character:PivotTo(nextCFrame)
            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
            lockRootToStableState()
            task.wait(stepWait)
        end
    end

    character:PivotTo(safeCFrame)
    rootPart.CFrame = safeCFrame
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
    lockRootToStableState()
    task.wait(0.04)

    if observeCheatMode then
        logPhysicsSnapshot("TP_AFTER")
    end

    releaseCharacterAfterTeleport(wasRunSpeedEnabled)
    task.delay(0.2, function()
        noFallDamageEnabled = wasNoFall
        isTPBusy = false
    end)
end

-- ==========================================
-- SPAWN LOOKUP
-- ==========================================

local function getEntrySpawn()
    if player.RespawnLocation and player.RespawnLocation:IsA("SpawnLocation") then
        return player.RespawnLocation.CFrame
    end

    local bestSpawn = nil
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") and obj.Enabled then
            if player.Team and obj.Neutral == false then
                if obj.TeamColor == player.TeamColor then
                    return obj.CFrame
                end
            else
                bestSpawn = obj.CFrame
            end
        end
    end

    if bestSpawn then return bestSpawn end
    if realSpawnCFrame then return realSpawnCFrame end

    return (rootPart and rootPart.CFrame) or CFrame.new(0, 10, 0)
end

-- ==========================================
-- FLY (smooth, no false exits — FIXED)
-- ==========================================

local function setFlying(state)
    if not rootPart or not humanoid or not linearVelocity then return end
    if isFlying == state then return end
    isFlying = state

    if isFlying then
        linearVelocity.MaxForce = 100000
        linearVelocity.VectorVelocity = Vector3.zero
        flyVelocity = Vector3.zero
        pcall(function()
            humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
        end)
        log("FLY", "Flight ON")
    else
        linearVelocity.MaxForce = 0
        linearVelocity.VectorVelocity = Vector3.zero
        flyVelocity = Vector3.zero

        -- Gently return to normal movement
        if rootPart and humanoid then
            local cur = rootPart.AssemblyLinearVelocity
            rootPart.AssemblyLinearVelocity = Vector3.new(cur.X * 0.2, 0, cur.Z * 0.2)
            rootPart.AssemblyAngularVelocity = Vector3.zero
        end
        log("FLY", "Flight OFF")
    end
end

-- Fly update loop (smooth acceleration + damping)
RunService.RenderStepped:Connect(function(dt)
    if not isFlying or not rootPart or not humanoid or not linearVelocity then
        return
    end
    if not controls then return end

    local st = humanoid:GetState()
    if st == Enum.HumanoidStateType.Dead or st == Enum.HumanoidStateType.Ragdoll then
        setFlying(false)
        return
    end

    local mv = controls:GetMoveVector()
    local camCF = camera.CFrame

    local targetVel = Vector3.zero
    if mv.Magnitude > 0 then
        local flightDir = (camCF.RightVector * mv.X) - (camCF.LookVector * mv.Z)
        targetVel = flightDir.Unit * FLY_SPEED
    end

    -- Smooth accelerate / decelerate
    flyVelocity = flyVelocity:Lerp(targetVel, math.clamp(FLY_ACCEL * dt, 0, 1))
    if targetVel.Magnitude < 0.1 and flyVelocity.Magnitude < 0.5 then
        flyVelocity = Vector3.zero
    end

    linearVelocity.VectorVelocity = flyVelocity
end)

-- Ground / landing exit check (with real hover test via raycast)
RunService.Heartbeat:Connect(function()
    if not isFlying or not humanoid or not rootPart then return end

    local st = humanoid:GetState()
    local vy = rootPart.AssemblyLinearVelocity.Y

    if st == Enum.HumanoidStateType.Landed
        or (st == Enum.HumanoidStateType.Running and math.abs(vy) < 0.5) then
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        if character then rp.FilterDescendantsInstances = {character} end
        local hit = workspace:Raycast(rootPart.Position, Vector3.new(0, -4, 0), rp)
        if hit then
            setFlying(false)
        end
    end
end)

