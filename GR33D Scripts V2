local function setFlying(active)
	isFlying = active
	if not rootPart then return end
	if active then
		if linearVelocity then linearVelocity.MaxForce = 999999999 end
		if humanoid then humanoid.PlatformStand = true end
	else
		if linearVelocity then linearVelocity.MaxForce = 0 end
		if humanoid then humanoid.PlatformStand = false end
	end
end
local function SafeTeleport(targetCFrame)
	if not rootPart then return end
	local startCFrame = rootPart.CFrame
	local distance = (targetCFrame.Position - startCFrame.Position).Magnitude
	local duration = math.clamp(distance / 250, 0.1, 0.8)

	setFlying(false)
	rootPart.Anchored = true

	local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
	
	tween:Play()
	tween.Completed:Wait()
	
	rootPart.Anchored = false
	if humanoid then
		humanoid.AssemblyLinearVelocity = Vector3.zero
	end
end

local function parseStatValue(str)
	if type(str) ~= "string" then return 0 end
	str = str:upper():gsub(",", "")
	local num = tonumber(str:match("[%d%.]+"))
	if not num then return 0 end
	if str:find("K") then num = num * 1000
	elseif str:find("M") then num = num * 1000000
	elseif str:find("B") then num = num * 1000000000
	elseif str:find("T") then num = num * 1000000000000 end
	return num
end

local function executeAutoGrabRoutine()
	local targetVal = getgenv().TargetValue or 0
	local targetLuck = getgenv().TargetLuck or 0
	local targetSize = getgenv().TargetSize or 0
	
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") then
			local parentPart = obj.Parent
			if parentPart and parentPart:IsA("BasePart") then
				local dist = (parentPart.Position - rootPart.Position).Magnitude
				if dist <= (obj.MaxActivationDistance + 15) then
					local pass = true
					if targetVal > 0 then
						local vAttr = obj:GetAttribute("Value") or parentPart:GetAttribute("Value") or 0
						if vAttr < targetVal then pass = false end
					end
					if pass and targetLuck > 0 then
						local lAttr = obj:GetAttribute("Luck") or parentPart:GetAttribute("Luck") or 0
						if lAttr < targetLuck then pass = false end
					end
					if pass and targetSize > 0 then
						local sAttr = obj:GetAttribute("Size") or parentPart:GetAttribute("Size") or 0
						if sAttr < targetSize then pass = false end
					end
					if pass then
						fireproximityprompt(obj, 1)
					end
				end
			end
		end
	end
end

