        if panicActive then
            if humanoid then
                humanoid.WalkSpeed = defaultWalkSpeed
                humanoid.JumpPower = defaultJumpPower
                humanoid.MaxHealth = 100
                humanoid.Health = math.min(humanoid.Health, 100)
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
            end
            if rootPart and originalRootSize then rootPart.Size = originalRootSize end
            for hrp, size in pairs(originalHitboxSizes) do
                if hrp and hrp.Parent then hrp.Size = size end
            end
            originalHitboxSizes = {}
            for valObj, origVal in pairs(originalToolValues) do
                if valObj and valObj.Parent then valObj.Value = origVal end
            end
            originalToolValues = {}

            flyToggleEnabled = false
            isFlying = false
            if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
            godModeEnabled = false
            megaHealthEnabled = false
            rapidHealingEnabled = false
            noFallDamageEnabled = false
            runSpeedEnabled = false
            jumpEnabled = false
            hitboxEnabled = false
            slimHitboxEnabled = false
            aimbotEnabled = false
            rapidFireEnabled = false
            antiMeleeEnabled = false

            if noclipConnection then stopNoclipLoop() end
            if speedConnection then stopSpeedLoop() end
            if mainRenderConnection then
                mainRenderConnection:Disconnect()
                mainRenderConnection = nil
            end

            print("[PANIC] All features disabled, values restored.")
        end
