local function scanAndExtractStats(prompt)
  local statData={Value=0,Luck=0,Size=0,Weight=0,RarityScore=0}
  local tm=prompt.Parent if not tm then return statData end
  pcall(function()
    if tm:IsA("Model") then statData.Size=tm:GetExtentsSize().Magnitude
    elseif tm:IsA("BasePart") then statData.Size=tm.Size.Magnitude end
  end)
  pcall(function()
    for attr,val in pairs(tm:GetAttributes()) do
      local nl,vs,nv,wv=attr:lower(),tostring(val):lower(),parseStatValue(val),parseWeightValue(val)
      if nl:find("val") or nl:find("value") or nl:find("price") or nl:find("cash") or nl:find("money") or nl:find("$") then
        if nv>statData.Value then statData.Value=nv end
      elseif nl:find("luck") then
        if nv>statData.Luck then statData.Luck=nv end
      elseif nl:find("weight") or nl:find("mass") then
        if wv>statData.Weight then statData.Weight=wv end
      elseif nl:find("size") then
        if nv>statData.Size then statData.Size=nv end
      elseif nl:find("rarity") or nl:find("quality") or nl:find("tier") then
        if vs:find("legendary") or vs:find("mythic") or vs:find("secret") or vs:find("rare") or vs:find("epic") then statData.RarityScore=statData.RarityScore+100 end
      end
    end
  end)
  pcall(function()
    for _,desc in ipairs(tm:GetDescendants()) do
      if desc:IsA("TextLabel") and (desc.Parent:IsA("BillboardGui") or desc.Parent:IsA("SurfaceGui")) then
        local tl=desc.Text:lower()
        local pv,pw=parseStatValue(desc.Text),parseWeightValue(desc.Text)
        if tl:find("luck") or tl:find("%%") then
          if pv>statData.Luck then statData.Luck=pv end
        elseif tl:find("ton") or tl:find("kg") or tl:find("weight") or tl:find("mass") then
          if pw>statData.Weight then statData.Weight=pw end
        elseif tl:find("$") or tl:find("value") or tl:find("worth") or tl:find("price") then
          if pv>0 and pv>statData.Value then statData.Value=pv end
        else
          if pv>0 and pv>statData.Value then statData.Value=pv end
        end
        if tl:find("secret") or tl:find("mythic") or tl:find("godly") or tl:find("legendary") or tl:find("epic") or tl:find("rare") then statData.RarityScore=statData.RarityScore+500 end
      end
