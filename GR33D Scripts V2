-- ==========================================
-- FLIGHT DOUBLE-TAP
-- ==========================================

local function handleJumpTap()
    if not flyToggleEnabled then return end
    local currentTime = os.clock()
    local timeSinceLastTap = currentTime - lastJumpTapTime
    if timeSinceLastTap <= DOUBLE_TAP_WINDOW then
        if isFlying then
            setFlying(false)
        elseif humanoid and (humanoid:GetState() == Enum.HumanoidStateType.Freefall
            or humanoid:GetState() == Enum.HumanoidStateType.Jumping) then
            setFlying(true)
        end
        lastJumpTapTime = 0
    else
        lastJumpTapTime = currentTime
    end
end

UserInputService.JumpRequest:Connect(function()
    local currentTime = os.clock()
    if (currentTime - lastJumpReqTime) > 0.1 then
        handleJumpTap()
        if jumpEnabled and not flyToggleEnabled then
            anchorTrickJump()
        end
    end
    lastJumpReqTime = currentTime
end)

-- ==========================================
-- RUBBERBAND DETECTOR
-- ==========================================

local function detectRubberband()
    if not rootPart then return end
    local now = os.clock()
    if now - lastPositionCheck < 0.1 then return end

    local currentPos = rootPart.Position
    if lastKnownPosition == Vector3.zero then
        lastKnownPosition = currentPos
        lastPositionCheck = now
        return
    end

    local delta = (currentPos - lastKnownPosition).Magnitude
    -- If position jumped backward by a large amount, it's a rubberband
    local timeDelta = now - lastPositionCheck
    local expectedMax = 350 * timeDelta  -- 350 studs/s max reasonable

    if delta > expectedMax + 50 then
        rubberbandEvents = rubberbandEvents + 1
        log("RUBBERBAND", string.format("Detected! Moved %.1f studs in %.3fs (max expected %.1f) at (%.1f, %.1f, %.1f)",
            delta, timeDelta, expectedMax,
            currentPos.X, currentPos.Y, currentPos.Z))
    end

    lastKnownPosition = currentPos
    lastPositionCheck = now
end

-- ==========================================
-- MAIN LOOPS
-- ==========================================

RunService.Stepped:Connect(function()
    if not character or not rootPart then return end

    if rootPart.Anchored and not isAnchorBusy then
        log("STATE", "Server/engine anchored us unexpectedly - unanchoring")
        rootPart.Anchored = false
    end

    if noclipEnabled then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
                part.CanTouch = false
                part.CanQuery = false
            end
        end
    end

    if rootPart.Position.Y < -50 then
        log("STATE", "Fell through world - teleporting to spawn")
        longDistanceTeleport(getEntrySpawn())
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if not camera or not camera.Parent then
        camera = workspace.CurrentCamera
        return
    end

    if runSpeedEnabled and not isFlying then
        anchorTrickStep(dt)
    end

    if isFlying and linearVelocity and humanoid and rootPart then
        if humanoid.FloorMaterial ~= Enum.Material.Air then
            setFlying(false)
        elseif controls then
            local moveVector = controls:GetMoveVector()
            if moveVector.Magnitude > 0 then
                local camCFrame = camera.CFrame
                local flightDir = (camCFrame.RightVector * moveVector.X) - (camCFrame.LookVector * moveVector.Z)
                linearVelocity.VectorVelocity = flightDir.Unit * FLY_SPEED
            else
                linearVelocity.VectorVelocity = Vector3.zero
            end
        end
    end

    if humanoid and rootPart then
        local state = humanoid:GetState()
        if (noFallDamageEnabled or isJumping) and
            (state == Enum.HumanoidStateType.Freefall
            or state == Enum.HumanoidStateType.FallingDown) then
            local currentVel = rootPart.AssemblyLinearVelocity
            if currentVel.Y < -MAX_SAFE_FALL then
                rootPart.AssemblyLinearVelocity = Vector3.new(
                    currentVel.X,
                    -MAX_SAFE_FALL,
                    currentVel.Z
                )
            end
        end
    end

    -- Rubberband check
    detectRubberband()
end)

-- ==========================================
-- CHARACTER SETUP
-- ==========================================

local function setupCharacter(char)
    character = char
    rootPart = char:WaitForChild("HumanoidRootPart")
    humanoid = char:WaitForChild("Humanoid")

    log("CHAR", "Character setup: " .. char.Name)

    rootPart.CanCollide = false
    rootPart.Anchored = false

    if rootPart:FindFirstChild("FlightAttachment") then rootPart.FlightAttachment:Destroy() end
    if rootPart:FindFirstChild("FlightVelocity") then rootPart.FlightVelocity:Destroy() end

    attachment = Instance.new("Attachment")
    attachment.Name = "FlightAttachment"
    attachment.Parent = rootPart

    linearVelocity = Instance.new("LinearVelocity")
    linearVelocity.Name = "FlightVelocity"
    linearVelocity.Attachment0 = attachment
    linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    linearVelocity.MaxForce = 0
    linearVelocity.VectorVelocity = Vector3.zero
    linearVelocity.Parent = rootPart

    watchCharacterForInvisibility(char)

    if invisibleEnabled then applyInvisibility(true) end
    if flyToggleEnabled then setFlying(true) end

    lastKnownPosition = rootPart.Position
    lastPositionCheck = os.clock()
end

task.spawn(function()
    setupCharacter(player.Character or player.CharacterAdded:Wait())
end)

player.CharacterAdded:Connect(function(newChar)
    log("CHAR", "Respawn detected")
    flyToggleEnabled = false
    isFlying = false
    isAnchorBusy = false
    isJumping = false
    if linearVelocity then linearVelocity.MaxForce = 0 end
    originalTransparency = {}
    setupCharacter(newChar)
end)

