local oldNamecall, oldNewIndex
local remoteCooldowns = {}
local kickSpoofReasons = {
    "Disconnected due to network error",
    "Lost connection to the server",
    "Network timeout, please rejoin",
}

pcall(function()
    local mt = getrawmetatable(game)

    -- Loophole: use hookfunction instead of setreadonly + raw override
    -- This is the executor-standard API and is far less detectable
    oldNamecall = hookfunction(mt.__namecall, newcclosure(function(self, ...)
        local method = getnamecallmethod()

        -- LOOPHOLE #1: Don't block Kick — spoof the reason
        if not checkcaller() and (method == "Kick" or method == "kick") and self == game.Players.LocalPlayer then
            local args = {...}
            if args[1] then
                args[1] = kickSpoofReasons[math.random(#kickSpoofReasons)]
            end
            return oldNamecall(self, unpack(args))
        end

        -- LOOPHOLE #2: Don't drop FireServer — delay + jitter to mimic lag
        if not checkcaller() and (method == "FireServer" or method == "InvokeServer") then
            local remoteName = tostring(self):lower()
            local suspicious = remoteName:find("anticheat") or remoteName:find("ban")
                or remoteName:find("report") or remoteName:find("detect")
                or remoteName:find("cheat") or remoteName:find("exploit")
                or remoteName:find("integrity") or remoteName:find("client")

            if suspicious then
                -- Rate-limit with realistic jitter (80–250ms)
                local now = tick()
                local last = remoteCooldowns[self] or 0
                if now - last < 0.08 then
                    task.wait(math.random(80, 250) / 1000)
                end
                remoteCooldowns[self] = tick()
                -- Let it through with legit-looking args
                return oldNamecall(self, ...)
            end
        end

        return oldNamecall(self, ...)
    end))

    -- LOOPHOLE #3: Health writes — clamp to survivable, never block
    oldNewIndex = hookfunction(mt.__newindex, newcclosure(function(t, k, v)
        if not checkcaller() and typeof(t) == "Instance" and t:IsA("Humanoid") then
            local char = game.Players.LocalPlayer.Character
            if char and t:IsDescendantOf(char) then
                if k == "Health" and (getgenv().GodModeActive or getgenv().MegaHealthActive) then
                    -- Server thinks it damaged you; you stay alive
                    local safeVal = math.max(1, math.min(v, t.MaxHealth))
                    return oldNewIndex(t, k, safeVal)
                end
                if k == "MaxHealth" and getgenv().MegaHealthActive and v < 900000000 then
                    -- Accept server value to avoid desync detection
                    return oldNewIndex(t, k, v)
                end
            end
        end
        return oldNewIndex(t, k, v)
    end))
end)

