-- ==========================================
-- FLIGHT (uses LinearVelocity — legit physics)
-- ==========================================

local function setFlying(state)
    if not rootPart or not humanoid or not linearVelocity then return end
    log("FLY", "setFlying: " .. tostring(state))
    isFlying = state
    if isFlying then
        linearVelocity.MaxForce = 100000
        humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
    else
        linearVelocity.MaxForce = 0
        linearVelocity.VectorVelocity = Vector3.zero
        if humanoid.FloorMaterial ~= Enum.Material.Air then
            humanoid:ChangeState(Enum.HumanoidStateType.Running)
        end
    end
end

-- ==========================================
-- MAIN RENDER LOOP
-- ==========================================

RunService.RenderStepped:Connect(function(dt)
    if not camera or not camera.Parent then
        camera = workspace.CurrentCamera
        return
    end

    -- FLIGHT
    if isFlying and linearVelocity and humanoid and rootPart then
        if humanoid.FloorMaterial ~= Enum.Material.Air then
            setFlying(false)
        else
            local controls = nil
            pcall(function()
                controls = require(player.PlayerScripts.PlayerModule):GetControls()
            end)
            if controls then
                local moveVector = controls:GetMoveVector()
                if moveVector.Magnitude > 0 then
                    local camCFrame = camera.CFrame
                    local flightDir = (camCFrame.RightVector * moveVector.X) - (camCFrame.LookVector * moveVector.Z)
                    linearVelocity.VectorVelocity = flightDir.Unit * 50
                else
                    linearVelocity.VectorVelocity = Vector3.zero
                end
            end
        end
    end

    -- SAFE FALL
    if humanoid and rootPart then
        local state = humanoid:GetState()
        if noFallDamageEnabled and
            (state == Enum.HumanoidStateType.Freefall
            or state == Enum.HumanoidStateType.FallingDown) then
            local v = rootPart.AssemblyLinearVelocity
            if v.Y < -MAX_SAFE_FALL then
                rootPart.AssemblyLinearVelocity = Vector3.new(v.X, -MAX_SAFE_FALL, v.Z)
            end
        end
    end
end)

