-- ==========================================

player:GetAttributeChangedSignal("Carrying"):Connect(function()
    local val = player:GetAttribute("Carrying")
    isCarryingEgg = (val ~= nil and val ~= false)
    log("CARRY", "Attribute Carrying: " .. tostring(val))
end)

-- Watch for egg items in character (when carrying)
local function watchForCarryItems(char)
    char.ChildAdded:Connect(function(child)
        local n = child.Name:lower()
        if n:find("egg") or n:find("carry") or n:find("steal") or n:find("hold") then
            isCarryingEgg = true
            log("CARRY", "Detected: " .. child.Name)
            -- Reset when removed
            child.AncestryChanged:Connect(function()
                if not child:IsDescendantOf(char) then
                    isCarryingEgg = false
                    log("CARRY", "Released")
                end
            end)
        end
    end)
end

-- Watch UI for carry indicators
protectedParent.DescendantAdded:Connect(function(obj)
    if obj:IsA("TextLabel") then
        local t = (obj.Text or ""):lower()
        if t:find("carrying") or t:find("holding") or t:find("steal") then
            isCarryingEgg = true
            log("CARRY", "UI: " .. obj.Text)
        end
    end
end)

-- ==========================================
-- SPEED (WalkSpeed 231.4 + carry detection)
-- ==========================================

RunService.RenderStepped:Connect(function(dt)
    if not runSpeedEnabled or not rootPart or not humanoid then return end

    if humanoid.WalkSpeed ~= WALKSPEED_BOOST then
        humanoid.WalkSpeed = WALKSPEED_BOOST
    end

    if isFlying or isTPBusy then return end

    local moveDir = humanoid.MoveDirection
    if moveDir.Magnitude < 0.01 then return end

    local speedMult = runSpeedValue / 100
    -- Reduce speed when carrying egg to prevent rubberband
    if isCarryingEgg then
        speedMult = speedMult * CARRY_SPEED_REDUCTION
    end

    local step = moveDir.Unit * (SPEED_STEP * speedMult * (dt * 60))

    local newPos = rootPart.Position + step
    rootPart.CFrame = CFrame.new(newPos, newPos + moveDir.Unit)

    local now = os.clock()
    if now - lastSpeedLogTime > 1 then
        lastSpeedLogTime = now
        log("SPEED", string.format("WalkSpeed=%.1f + step=%.2f%s | pos=(%.1f, %.1f, %.1f)",
            humanoid.WalkSpeed, step.Magnitude,
            isCarryingEgg and " [CARRY]" or "",
            newPos.X, newPos.Y, newPos.Z))
    end
end)

-- ==========================================
-- JUMP
-- ==========================================

local function applyJump()
    if not jumpEnabled or not rootPart or not humanoid then return end
    if humanoid.FloorMaterial == Enum.Material.Air then return end
    if os.clock() - lastJumpReqTime < 0.15 then return end
    lastJumpReqTime = os.clock()
    local impulse = math.min(jumpPowerValue, MAX_JUMP_IMPULSE)
    rootPart.AssemblyLinearVelocity = Vector3.new(
        rootPart.AssemblyLinearVelocity.X,
        impulse,
        rootPart.AssemblyLinearVelocity.Z
    )
    log("JUMP", string.format("impulse=%.1f", impulse))
end

