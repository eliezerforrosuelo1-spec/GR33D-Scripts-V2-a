-- 14. CHARACTER SETUP
-- ─────────────────────────────────────────

local function setupCharacter(char)
    character = char
    rootPart  = char:WaitForChild("HumanoidRootPart")
    humanoid  = char:WaitForChild("Humanoid")
    rootPart.Anchored = false

    if humanoid then
        defaultJumpPower = humanoid.JumpPower > 0 and humanoid.JumpPower or 50
        defaultWalkSpeed = humanoid.WalkSpeed > 0 and humanoid.WalkSpeed or 16
    end

    if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
    if jumpConnection then jumpConnection:Disconnect() jumpConnection = nil end

    jumpConnection = humanoid.Jumping:Connect(function(isActive)
        if jumpEnabled and isActive and rootPart and humanoid.FloorMaterial ~= Enum.Material.Air then
            local currentVel = rootPart.AssemblyLinearVelocity
            rootPart.AssemblyLinearVelocity = Vector3.new(currentVel.X, jumpPowerValue, currentVel.Z)
        end
    end)

    task.defer(function()
        if rootPart then
            pristineRootSize = Vector3.new(2, 2, 1)
            originalRootSize = pristineRootSize
        end
        if megaHealthEnabled and humanoid then
            humanoid.MaxHealth = 10000
            humanoid.Health    = 10000
        end
    end)

    if not InitialSpawnCFrame then
        task.delay(0.8, function()
            if rootPart and not InitialSpawnCFrame then InitialSpawnCFrame = rootPart.CFrame end
        end)
    end
end

