createToggleRow("Stealth Mode", 400, function(state)
    stealthModeEnabled = state
end)

-- Inside the speed loop:
local effectiveSpeed = runSpeedValue
if stealthModeEnabled then
    -- Check if any player is within 100 studs
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (p.Character.HumanoidRootPart.Position - rootPart.Position).Magnitude
            if dist < 100 then
                effectiveSpeed = math.min(effectiveSpeed, 50) -- drop to safe speed
                break
            end
        end
    end
end
