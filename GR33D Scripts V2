local function setupCharacter(char)
    if not char or char ~= player.Character then return end
    if character == char and rootPart and rootPart.Parent and humanoid and humanoid.Parent then
        return
    end

    character = char
    rootPart = char:WaitForChild("HumanoidRootPart")
    humanoid = char:WaitForChild("Humanoid")

    originalCollision = {}
    noclipSuspended = false
    originalWalkSpeed = humanoid.WalkSpeed > 0 and humanoid.WalkSpeed or 16

    -- Clean up leftovers from previous versions before creating the current mover.
    local oldFlightAttachment = rootPart:FindFirstChild("FlightAttachment")
    if oldFlightAttachment then oldFlightAttachment:Destroy() end

    local oldFlightVelocity = rootPart:FindFirstChild("FlightVelocity")
    if oldFlightVelocity then oldFlightVelocity:Destroy() end

    local oldSpeedAttachment = rootPart:FindFirstChild("SpeedAttachment")
    if oldSpeedAttachment then oldSpeedAttachment:Destroy() end

    local oldSpeedVelocity = rootPart:FindFirstChild("SpeedVelocity")
    if oldSpeedVelocity then oldSpeedVelocity:Destroy() end

    attachment = Instance.new("Attachment")
    attachment.Name = "FlightAttachment"
    attachment.Parent = rootPart

    linearVelocity = Instance.new("LinearVelocity")
    linearVelocity.Name = "FlightVelocity"
    linearVelocity.Attachment0 = attachment
    linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    linearVelocity.MaxForce = 0
    linearVelocity.VectorVelocity = Vector3.zero
    linearVelocity.Parent = rootPart

    if not firstSpawnCaptured then
        realSpawnCFrame = rootPart.CFrame
        firstSpawnCaptured = true
    end

    if runSpeedEnabled then
        humanoid.WalkSpeed = 0
        humanoid.AutoRotate = false
    else
        restoreNormalMovementState()
    end

    if noclipEnabled then
        enforceNoclip()
    end

    if flyToggleEnabled then
        setFlying(true)
    end

    if promptExtenderEnabled then
        task.defer(enablePromptExtenderAll)
    end

    humanoid.Died:Connect(function()
        -- Invalidate any TP coroutine that still references this character.
        teleportSerial = teleportSerial + 1
        isTPBusy = false
        noclipSuspended = false
        isFlying = false
        flyVelocity = Vector3.zero

        if linearVelocity then
            linearVelocity.MaxForce = 0
            linearVelocity.VectorVelocity = Vector3.zero
        end

        if character == char then
            character = nil
            rootPart = nil
            humanoid = nil
        end
    end)
end

player.CharacterAdded:Connect(function(c)
