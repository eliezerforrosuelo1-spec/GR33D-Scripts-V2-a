RunService.RenderStepped:Connect(function(dt)
	if not camera or not camera.Parent then camera = workspace.CurrentCamera return end

	if godModeEnabled and humanoid then
		humanoid.Health = humanoid.MaxHealth
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	end

	if isFlying and linearVelocity and humanoid and rootPart then
		if humanoid.FloorMaterial ~= Enum.Material.Air then
			setFlying(false)
		elseif controls then
			local moveVector = controls:GetMoveVector()
			if moveVector.Magnitude > 0 then
				local camCFrame = camera.CFrame
				local flightDir = (camCFrame.RightVector * moveVector.X) - (camCFrame.LookVector * moveVector.Z)
				linearVelocity.VectorVelocity = flightDir.Unit * FLY_SPEED
			else
				linearVelocity.VectorVelocity = Vector3.zero
			end
		end
	end

	if jumpEnabled and humanoid then
		pcall(function() 
			humanoid.UseJumpPower = true 
			humanoid.JumpPower = jumpPowerValue 
		end)
	elseif not jumpEnabled and humanoid then
		pcall(function()
			if humanoid.JumpPower ~= defaultJumpPower then
				humanoid.JumpPower = defaultJumpPower
			end
		end)
	end

	if rapidHealingEnabled and humanoid and humanoid.Health < humanoid.MaxHealth and humanoid.Health > 0 then
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + (humanoid.MaxHealth * 0.05))
	end

	if noFallDamageEnabled and rootPart and humanoid then
		if humanoid:GetState() == Enum.HumanoidStateType.Freefall or humanoid:GetState() == Enum.HumanoidStateType.FallingDown then
			pcall(function()
				if rootPart.AssemblyLinearVelocity.Y < -45 then
					rootPart.AssemblyLinearVelocity = Vector3.new(rootPart.AssemblyLinearVelocity.X, 0, rootPart.AssemblyLinearVelocity.Z)
				end
			end)
		end
	end

	if antiMeleeEnabled and rootPart and humanoid then
		local currentVel = rootPart.AssemblyLinearVelocity
		if humanoid.MoveDirection.Magnitude == 0 and not isFlying and not runSpeedEnabled then
			if math.abs(currentVel.X) > 4 or math.abs(currentVel.Z) > 4 then
				rootPart.AssemblyLinearVelocity = Vector3.new(0, currentVel.Y, 0)
			end
		end
	end

	if hitboxEnabled then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local hrp = p.Character.HumanoidRootPart
				if not originalHitboxSizes[hrp] then originalHitboxSizes[hrp] = hrp.Size end
				hrp.Size = Vector3.new(8, 8, 8)
				hrp.Transparency = 0.7
				hrp.CanCollide = false
			end
		end
	end

	if slimHitboxEnabled and rootPart then
		rootPart.Size = Vector3.new(1.3, 2, 0.7)
	elseif not slimHitboxEnabled and rootPart and originalRootSize and rootPart.Size ~= originalRootSize then
		rootPart.Size = originalRootSize
	end

	if thirdPersonCamEnabled and rootPart then
		camera.CameraType = Enum.CameraType.Scriptable
		local head = character and character:FindFirstChild("Head") or rootPart
		local currentCamRot = camera.CFrame.Rotation
		local focusPos = head.Position + Vector3.new(0, 1, 0)
		local targetCFrame = CFrame.new(focusPos) * currentCamRot * CFrame.new(0, 3.5, -8)
		camera.CFrame = targetCFrame
	elseif not thirdPersonCamEnabled and camera.CameraType == Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Custom
	end
end)

