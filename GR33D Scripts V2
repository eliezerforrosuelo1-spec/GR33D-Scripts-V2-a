local runSpeedValue       = DEFAULT_SPEED
local jumpPowerValue      = DEFAULT_JUMP

local lastJumpTapTime     = 0
local lastJumpReqTime     = 0
local lastSpeedLogTime    = 0
local realSpawnCFrame     = nil
