local function freezeCharacterForTeleport()
    if not humanoid or not rootPart then return end
    humanoid.Sit = false
    humanoid.PlatformStand = true
    humanoid.AutoRotate = false
    humanoid.WalkSpeed = 0
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
    rootPart.Anchored = true
end

local function releaseCharacterAfterTeleport()
    if not humanoid or not rootPart then return end

    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
    rootPart.Anchored = false

    humanoid.PlatformStand = false
    humanoid.Sit = false

    -- Restore a usable movement state. V10.2 always set WalkSpeed to 0 here,
    -- which could freeze the player after a Risky TP when Super Speed was off.
    if runSpeedEnabled then
        humanoid.WalkSpeed = 0
        humanoid.AutoRotate = false
    else
        humanoid.WalkSpeed = originalWalkSpeed
        humanoid.AutoRotate = true
    end
end

local function logPhysicsSnapshot(label)
    if not rootPart or not humanoid then return end
    local pos = rootPart.Position
    local vel = rootPart.AssemblyLinearVelocity
    local ang = rootPart.AssemblyAngularVelocity
    local state = humanoid:GetState()
    local moveDir = humanoid.MoveDirection
    local delta = 0
    if lastObservedPos then
        delta = (pos - lastObservedPos).Magnitude
    end
    log("OBS", string.format("%s | pos=(%.2f, %.2f, %.2f) vel=(%.2f, %.2f, %.2f) ang=(%.2f, %.2f, %.2f) ws=%.1f state=%s move=(%.2f, %.2f, %.2f) delta=%.3f anchored=%s",
        label,
        pos.X, pos.Y, pos.Z,
        vel.X, vel.Y, vel.Z,
        ang.X, ang.Y, ang.Z,
        humanoid.WalkSpeed,
        tostring(state),
        moveDir.X, moveDir.Y, moveDir.Z,
        delta,
        tostring(rootPart.Anchored)
    ))
    lastObservedPos = pos
    lastObservedTick = os.clock()
end

local function startCheatObserver()
    if not observeCheatMode then return end
    if not rootPart or not humanoid then return end
    local now = os.clock()
    if now - lastObservedTick < 0.25 then return end
    logPhysicsSnapshot("CHEAT_OBSERVER")
end

