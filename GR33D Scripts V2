-- JUMP
-- ==========================================

local function applyJump()
    if not jumpEnabled or not rootPart or not humanoid then return end
    if humanoid.FloorMaterial == Enum.Material.Air then return end
    if os.clock() - lastJumpReqTime < 0.15 then return end
    lastJumpReqTime = os.clock()
    local impulse = math.min(jumpPowerValue, MAX_JUMP_IMPULSE)
    rootPart.AssemblyLinearVelocity = Vector3.new(
        rootPart.AssemblyLinearVelocity.X,
        impulse,
        rootPart.AssemblyLinearVelocity.Z
    )
end

-- ==========================================
-- ADVANCED TELEPORT SYSTEM (SERVER-SYNC FIXED)
-- ==========================================

local function getSafeGroundPosition(targetCFrame)
    local origin = targetCFrame.Position + Vector3.new(0, 15, 0)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    if character then
        raycastParams.FilterDescendantsInstances = {character}
    end
    
    local rayResult = workspace:Raycast(origin, Vector3.new(0, -60, 0), raycastParams)
    if rayResult then
        return CFrame.new(rayResult.Position + Vector3.new(0, 3.5, 0)) * targetCFrame.Rotation
    end
    return targetCFrame + Vector3.new(0, 3, 0)
end

local function absoluteTeleport(targetCFrame, useInterpolation)
    if not character or not rootPart or not humanoid then return end
    if isTPBusy then return end
    isTPBusy = true

    local safeCFrame = getSafeGroundPosition(targetCFrame)
    local startCFrame = rootPart.CFrame
    local distance = (safeCFrame.Position - startCFrame.Position).Magnitude

    log("TP", string.format("Starting TP | Distance: %.1f studs | Step-TP: %s", distance, tostring(useInterpolation)))

    local wasNoFall = noFallDamageEnabled
    noFallDamageEnabled = true

    -- Stand up and anchor immediately to lock network control
    humanoid.Sit = false
    rootPart.Anchored = true
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero

    if not useInterpolation or distance < 20 then
        character:PivotTo(safeCFrame)
        task.wait(0.1)
    else
        -- Step size capped at 15 studs per ~35ms step to stay under server movement caps
        local stepDistance = 15
        local steps = math.max(math.floor(distance / stepDistance), 6)
        
        for i = 1, steps do
            if not rootPart or not rootPart.Parent then break end
            local alpha = i / steps
            local nextCFrame = startCFrame:Lerp(safeCFrame, alpha)
            character:PivotTo(nextCFrame)
            task.wait(0.035) -- Delays step to allow server network buffer to register each frame
        end
    end

    -- Force exact destination position
    character:PivotTo(safeCFrame)
    
    -- CRITICAL: Hold anchor briefly so the server registers the stationary final position
    task.wait(0.3)

    -- Flush residual momentum before restoring server physics control
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
    rootPart.Anchored = false

    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)

    -- Multi-frame zero velocity enforcement loop post-unanchor
    task.spawn(function()
        for _ = 1, 8 do
            if rootPart and rootPart.Parent then
                rootPart.AssemblyLinearVelocity = Vector3.zero
                rootPart.AssemblyAngularVelocity = Vector3.zero
            end
            task.wait(0.05)
        end

        if humanoid and humanoid.Parent then
            humanoid:ChangeState(Enum.HumanoidStateType.Running)
        end

        log("TP", string.format("Arrived and synchronized at (%.1f, %.1f, %.1f)",
            rootPart.Position.X, rootPart.Position.Y, rootPart.Position.Z))

        task.delay(0.5, function()
            noFallDamageEnabled = wasNoFall
        end)

        isTPBusy = false
    end)
end

