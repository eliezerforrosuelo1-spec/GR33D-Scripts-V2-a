-- SPEED
-- ==========================================

RunService.Stepped:Connect(function()
    if not humanoid or not rootPart then return end

    local st = humanoid:GetState()
    if st == Enum.HumanoidStateType.Dead
        or st == Enum.HumanoidStateType.Ragdoll
        or st == Enum.HumanoidStateType.Climbing
        or st == Enum.HumanoidStateType.Swimming then
        return
    end
    if humanoid.Sit then return end

    if not runSpeedEnabled or isFlying or isTPBusy then
        if wasSpeedEnabled then
            humanoid.WalkSpeed = lastBaseSpeed
            wasSpeedEnabled = false
        end
        return
    end

    wasSpeedEnabled = true

    local currentWS = humanoid.WalkSpeed
    if math.abs(currentWS - lastBoostedWS) > 0.1 and currentWS ~= (lastBaseSpeed + runSpeedValue) then
        lastBaseSpeed = currentWS
    end

    local targetSpeed = lastBaseSpeed + runSpeedValue
    if humanoid.WalkSpeed ~= targetSpeed then
        humanoid.WalkSpeed = targetSpeed
        lastBoostedWS = targetSpeed
    end
end)

