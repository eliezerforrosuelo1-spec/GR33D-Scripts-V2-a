local function applyRapidFire(tool)
    for _, v in ipairs(tool:GetDescendants()) do
        if (v:IsA("NumberValue") or v:IsA("IntValue")) then
            local n = v.Name:lower()
            if n:find("cooldown") or n:find("delay") or n:find("fire") or n:find("rate")
                or n:find("speed") or n:find("mine") or n:find("dig") or n:find("swing")
                or n:find("hit") or n:find("power") then
                if not originalToolValues[v] then originalToolValues[v] = v.Value end
                if n:find("power") or n:find("speed") then
                    v.Value = originalToolValues[v] * 5
                else
                    v.Value = math.max(0.05, originalToolValues[v] * 0.15)
                end
            end
        end
    end
end

local function monitorTool(tool)
    if tool:IsA("Tool") then
        if rapidFireEnabled then applyRapidFire(tool) end
        tool.DescendantAdded:Connect(function(v)
            if rapidFireEnabled and (v:IsA("NumberValue") or v:IsA("IntValue")) then
                applyRapidFire(tool)
            end
        end)
    end
end

