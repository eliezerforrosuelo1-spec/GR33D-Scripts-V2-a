local DEFAULT_SPEED          = 100
local MAX_SPEED              = 100
local SPEED_TWEEN_INTERVAL   = 0.016   -- ~60 Hz
local SPEED_BASE_DIST        = 4       -- studs per 0.016s at speed 100 → 250 studs/s
local TP_EFFECTIVE_SPEED     = 1500
local TP_MAX_HOP             = 150     -- smaller hops
local TP_HOP_COOLDOWN        = 0.3     -- seconds between hops
local MAX_JUMP_IMPULSE       = 107
local DEFAULT_JUMP           = 100
local MAX_SAFE_FALL          = 50
local DOUBLE_TAP_WINDOW      = 0.35

