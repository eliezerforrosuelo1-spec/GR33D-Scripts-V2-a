local function isAnyFeatureActive()
    return godModeEnabled or megaHealthEnabled or rapidHealingEnabled
        or noFallDamageEnabled or runSpeedEnabled or jumpEnabled
        or hitboxEnabled or slimHitboxEnabled or aimbotEnabled
        or rapidFireEnabled or antiMeleeEnabled or flyToggleEnabled
end

