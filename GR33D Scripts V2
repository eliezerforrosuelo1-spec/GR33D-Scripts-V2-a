-- ==========================================
-- INVISIBILITY
-- ==========================================

local function installInvisibilityHook()
    if invisibilityHookInstalled then return end
    invisibilityHookInstalled = true
    pcall(function()
        local mt = getrawmetatable(game)
        oldNewIndex = hookfunction(mt.__newindex, newcclosure(function(t, k, v)
            if not checkcaller() and typeof(t) == "Instance" and t:IsA("BasePart") then
                local char = player.Character
                if char and t:IsDescendantOf(char) and invisibleEnabled then
                    if k == "Transparency" and v < 1 then return end
                    if k == "LocalTransparencyModifier" and v < 1 then return end
                end
            end
            return oldNewIndex(t, k, v)
        end))
    end)
end

local function applyInvisibility(state)
    invisibleEnabled = state
    log("INVIS", "Invisibility: " .. tostring(state))
    if not character then return end
    if state then
        installInvisibilityHook()
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("Decal") then
                if not originalTransparency[part] then
                    originalTransparency[part] = part.Transparency
                end
                part.Transparency = 1
                part.LocalTransparencyModifier = 1
            end
        end
    else
        for part, orig in pairs(originalTransparency) do
            if part and part.Parent then
                part.Transparency = orig
                part.LocalTransparencyModifier = 0
            end
        end
        originalTransparency = {}
    end
end

local function watchCharacterForInvisibility(char)
    if invisConnection then invisConnection:Disconnect() end
    invisConnection = char.DescendantAdded:Connect(function(desc)
        if invisibleEnabled and (desc:IsA("BasePart") or desc:IsA("Decal")) then
            originalTransparency[desc] = desc.Transparency
            desc.Transparency = 1
            desc.LocalTransparencyModifier = 1
        end
    end)
end

-- ==========================================
-- PROMPT EXTENDER
-- ==========================================

local function applyPromptExtender(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end
    if trackedPrompts[prompt] then return end
    trackedPrompts[prompt] = {
        MaxActivationDistance = prompt.MaxActivationDistance,
        HoldDuration          = prompt.HoldDuration,
        RequiresLineOfSight   = prompt.RequiresLineOfSight,
    }
    pcall(function()
        prompt.MaxActivationDistance = PROMPT_MAX_DISTANCE
        prompt.HoldDuration          = PROMPT_HOLD_DURATION
        prompt.RequiresLineOfSight   = PROMPT_REQUIRES_LOS
    end)
end

local function removePromptExtender(prompt)
    local saved = trackedPrompts[prompt]
    if not saved then return end
    pcall(function()
        if prompt and prompt.Parent then
            prompt.MaxActivationDistance = saved.MaxActivationDistance
            prompt.HoldDuration          = saved.HoldDuration
            prompt.RequiresLineOfSight   = saved.RequiresLineOfSight
        end
    end)
    trackedPrompts[prompt] = nil
end

local function enablePromptExtenderAll()
    local count = 0
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            applyPromptExtender(obj)
            count = count + 1
        end
    end
    log("PROMPT", "Extended " .. count .. " prompts")
end

local function disablePromptExtenderAll()
    for prompt, _ in pairs(trackedPrompts) do
        removePromptExtender(prompt)
    end
    trackedPrompts = {}
    log("PROMPT", "Disabled")
end

workspace.DescendantAdded:Connect(function(obj)
    if promptExtenderEnabled and obj:IsA("ProximityPrompt") then
        applyPromptExtender(obj)
    end
end)

-- ==========================================
-- NOCLIP
-- ==========================================

local function applyNoclip(state)
    noclipEnabled = state
    if not character then return end
    if state then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if originalCollision[part] == nil then
                    originalCollision[part] = part.CanCollide
                end
                part.CanCollide = false
            end
        end
    else
        for part, orig in pairs(originalCollision) do
            if part and part.Parent then
                part.CanCollide = orig
            end
        end
        originalCollision = {}
    end
end

RunService.Stepped:Connect(function()
    if not character or not noclipEnabled then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            if originalCollision[part] == nil then
                originalCollision[part] = true
            end
            part.CanCollide = false
        end
    end
end)

-- ==========================================
-- SPEED (via LinearVelocity constraint)
-- This overpowers the server's authority over
-- AssemblyLinearVelocity. Same trick as fly.
-- ==========================================

RunService.Stepped:Connect(function(_, dt)
    if not rootPart or not humanoid or not linearVelocity then return end

    local st = humanoid:GetState()
    if st == Enum.HumanoidStateType.Dead
        or st == Enum.HumanoidStateType.Ragdoll
        or st == Enum.HumanoidStateType.Climbing
        or st == Enum.HumanoidStateType.Swimming then
        speedVec = Vector3.zero
        linearVelocity.MaxForce = 0
        linearVelocity.VectorVelocity = Vector3.zero
        return
    end
    if humanoid.Sit then
        speedVec = Vector3.zero
        linearVelocity.MaxForce = 0
        linearVelocity.VectorVelocity = Vector3.zero
        return
    end

    -- Speed OFF: clear LinearVelocity contribution
    if not runSpeedEnabled or isFlying or isTPBusy then
        speedVec = Vector3.zero
        linearVelocity.MaxForce = 0
        linearVelocity.VectorVelocity = Vector3.zero
        return
    end

    -- Ramp our bonus toward (moveDir * bonus)
    local moveDir = humanoid.MoveDirection
    if moveDir.Magnitude > 0.01 then
        local desired = moveDir.Unit * runSpeedValue  -- bonus only
        local delta   = desired - speedVec
        local step    = SPEED_ACCEL * dt

        if delta.Magnitude <= step then
            speedVec = desired
        else
            speedVec = speedVec + delta.Unit * step
        end
    else
        local step = SPEED_DECEL * dt
        if speedVec.Magnitude <= step then
            speedVec = Vector3.zero
        else
            speedVec = speedVec - speedVec.Unit * step
        end
    end

    -- Apply via LinearVelocity (continuous force, server can't override easily)
    linearVelocity.MaxForce = 100000
    linearVelocity.VectorVelocity = speedVec

    local now = os.clock()
    if now - lastSpeedLogTime > 1 then
        lastSpeedLogTime = now
        log("SPEED", string.format(
            "bonus=%.1f base_ws=%.1f est_total=%.1f | pos=(%.1f, %.1f, %.1f)",
            speedVec.Magnitude,
            humanoid.WalkSpeed,
            humanoid.WalkSpeed + speedVec.Magnitude,
            rootPart.Position.X, rootPart.Position.Y, rootPart.Position.Z))
    end
end)

-- ==========================================
-- JUMP
-- ==========================================

local function applyJump()
    if not jumpEnabled or not rootPart or not humanoid then return end
    if humanoid.FloorMaterial == Enum.Material.Air then return end
    if os.clock() - lastJumpReqTime < 0.15 then return end
    lastJumpReqTime = os.clock()
    local impulse = math.min(jumpPowerValue, MAX_JUMP_IMPULSE)
    rootPart.AssemblyLinearVelocity = Vector3.new(
        rootPart.AssemblyLinearVelocity.X,
        impulse,
        rootPart.AssemblyLinearVelocity.Z
    )
    log("JUMP", string.format("impulse=%.1f", impulse))
end

-- ==========================================
-- TELEPORT
-- ==========================================

local function doTeleportCFrame(targetCFrame)
    humanoid:ChangeState(Enum.HumanoidStateType.Physics)

    rootPart.AssemblyLinearVelocity  = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero

    rootPart.CFrame = targetCFrame

    rootPart.AssemblyLinearVelocity  = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero

    task.defer(function()
        if humanoid and humanoid.Parent then
            humanoid:ChangeState(Enum.HumanoidStateType.Running)
        end
    end)
end

local function doTeleportVelocity(targetCFrame)
    local targetPos = targetCFrame.Position
    local MAX_TP_SPEED = 700
    local startTime = os.clock()
    local timeout   = 20

    while (targetPos - rootPart.Position).Magnitude > 5 do
        if os.clock() - startTime > timeout then break end
        if not rootPart or not rootPart.Parent then break end
        task.wait()
        local remaining = targetPos - rootPart.Position
        if remaining.Magnitude > 5 then
            local aim = remaining + Vector3.new(0, 2, 0)
            rootPart.AssemblyLinearVelocity = aim.Unit * MAX_TP_SPEED
        end
    end

    rootPart.AssemblyLinearVelocity = Vector3.zero
end

local function doTeleport(targetCFrame)
    if not rootPart or not humanoid or not targetCFrame then return end
    if isTPBusy then return end
    isTPBusy = true

    local targetPos = targetCFrame.Position
    local distance  = (targetPos - rootPart.Position).Magnitude

    log("TP", string.format("doTeleport dist=%.1f mode=%s",
        distance, USE_VELOCITY_TP and "velocity" or "cframe"))

    if distance < 5 then
        isTPBusy = false
        return
    end

    local wasNoFall = noFallDamageEnabled
    noFallDamageEnabled = true

    -- Ensure speed linear velocity isn't fighting the TP
    if linearVelocity then
        linearVelocity.MaxForce = 0
        linearVelocity.VectorVelocity = Vector3.zero
    end
    speedVec = Vector3.zero

    if USE_VELOCITY_TP then
        doTeleportVelocity(targetCFrame)
    else
        doTeleportCFrame(targetCFrame)
    end

    log("TP", string.format("Arrived at (%.1f, %.1f, %.1f)",
        rootPart.Position.X, rootPart.Position.Y, rootPart.Position.Z))

    task.delay(1.0, function()
        noFallDamageEnabled = wasNoFall
    end)

    isTPBusy = false
end

-- ==========================================
-- SPAWN LOOKUP
-- ==========================================

local function getEntrySpawn()
    if player.RespawnLocation then
        return player.RespawnLocation.CFrame
    end
    if realSpawnCFrame then
        return realSpawnCFrame
    end
    local spawns = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") and obj.Enabled then
            table.insert(spawns, obj)
        end
    end
    if #spawns == 0 then
        return (rootPart and rootPart.CFrame) or CFrame.new(0, 5, 0)
    end
    if rootPart then
        local nearest, bestDist = spawns[1], math.huge
        for _, sp in ipairs(spawns) do
            local d = (sp.Position - rootPart.Position).Magnitude
            if d < bestDist then nearest, bestDist = sp, d end
        end
        return nearest.CFrame
    end
    return spawns[1].CFrame
end

-- ==========================================
-- FLIGHT
-- ==========================================

local function setFlying(state)
    if not rootPart or not humanoid or not linearVelocity then return end
    isFlying = state
    if isFlying then
        linearVelocity.MaxForce = 100000
        humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
    else
        linearVelocity.MaxForce = 0
        linearVelocity.VectorVelocity = Vector3.zero
        if humanoid.FloorMaterial ~= Enum.Material.Air then
            humanoid:ChangeState(Enum.HumanoidStateType.Running)
        end
    end
end

RunService.RenderStepped:Connect(function()
    if not camera or not camera.Parent then
        camera = workspace.CurrentCamera
        return
    end

    if isFlying and linearVelocity and humanoid and rootPart then
        if humanoid.FloorMaterial ~= Enum.Material.Air then
            setFlying(false)
        end
    end

    if humanoid and rootPart and noFallDamageEnabled then
        local st = humanoid:GetState()
        if st == Enum.HumanoidStateType.Freefall or st == Enum.HumanoidStateType.FallingDown then
            local v = rootPart.AssemblyLinearVelocity
            if v.Y < -MAX_SAFE_FALL then
                rootPart.AssemblyLinearVelocity = Vector3.new(v.X, -MAX_SAFE_FALL, v.Z)
            end
        end
    end
end)

