-- ==========================================
-- PROMPT EXTENDER
-- ==========================================

local function getPromptWorldPosition(prompt)
    if not prompt or not prompt.Parent then return nil end

    local parent = prompt.Parent
    if parent:IsA("Attachment") then
        return parent.WorldPosition
    elseif parent:IsA("BasePart") then
        return parent.Position
    elseif parent:IsA("Model") then
        local ok, pivot = pcall(function()
            return parent:GetPivot()
        end)
        if ok and pivot then
            return pivot.Position
        end
    end

    return nil
end

local function removePromptExtender(prompt)
    local saved = trackedPrompts[prompt]
    if not saved then return end

    pcall(function()
        if prompt and prompt.Parent then
            prompt.MaxActivationDistance = saved.MaxActivationDistance
            prompt.HoldDuration = saved.HoldDuration
            prompt.RequiresLineOfSight = saved.RequiresLineOfSight
        end
    end)

    trackedPrompts[prompt] = nil
end

local function applyPromptExtender(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Parent then
        return
    end

    knownPrompts[prompt] = true

    local playerRoot = rootPart or (player.Character and player.Character:FindFirstChild("HumanoidRootPart"))
    if not playerRoot then return end

    local promptPos = getPromptWorldPosition(prompt)
    if not promptPos then return end

    local dist = (promptPos - playerRoot.Position).Magnitude

    if dist <= PROMPT_MAX_DISTANCE + 10 then
        if not trackedPrompts[prompt] then
            trackedPrompts[prompt] = {
                MaxActivationDistance = prompt.MaxActivationDistance,
                HoldDuration = prompt.HoldDuration,
                RequiresLineOfSight = prompt.RequiresLineOfSight,
            }
        end

        pcall(function()
            prompt.MaxActivationDistance = PROMPT_MAX_DISTANCE
            prompt.HoldDuration = PROMPT_HOLD_DURATION
            prompt.RequiresLineOfSight = PROMPT_REQUIRES_LOS
        end)
    elseif trackedPrompts[prompt] then
        removePromptExtender(prompt)
    end
end

local function indexPrompts()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            knownPrompts[obj] = true
        end
    end
end

local function enablePromptExtenderAll()
    indexPrompts()

    local count = 0
    for prompt in pairs(knownPrompts) do
        if prompt and prompt.Parent then
            applyPromptExtender(prompt)
            count = count + 1
        else
            knownPrompts[prompt] = nil
            trackedPrompts[prompt] = nil
        end
    end

    log("PROMPT", "Indexed " .. count .. " prompts")
end

local function disablePromptExtenderAll()
    local restoreList = {}
    for prompt in pairs(trackedPrompts) do
        table.insert(restoreList, prompt)
    end

    for _, prompt in ipairs(restoreList) do
        removePromptExtender(prompt)
    end

    log("PROMPT", "Disabled")
end

workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("ProximityPrompt") then
        knownPrompts[obj] = true
        if promptExtenderEnabled then
            task.defer(function()
                applyPromptExtender(obj)
            end)
        end
    end
end)

workspace.DescendantRemoving:Connect(function(obj)
    if obj:IsA("ProximityPrompt") then
        knownPrompts[obj] = nil
        trackedPrompts[obj] = nil
    end
end)

-- Throttle prompt updates. V10.2 called workspace:GetDescendants() every
-- RenderStepped frame, which can become very expensive in large maps.
RunService.Heartbeat:Connect(function()
    if not promptExtenderEnabled then return end

    local now = os.clock()
    if now - lastPromptRefresh < PROMPT_REFRESH_PERIOD then return end
    lastPromptRefresh = now

    for prompt in pairs(knownPrompts) do
        if prompt and prompt.Parent then
            applyPromptExtender(prompt)
        else
            knownPrompts[prompt] = nil
            trackedPrompts[prompt] = nil
        end
    end
end)

-- ==========================================
-- NOCLIP
-- ==========================================

local function restoreCollisionSnapshot(clearSnapshot)
    for part, originalCanCollide in pairs(originalCollision) do
        if part and part.Parent then
            pcall(function()
                part.CanCollide = originalCanCollide
            end)
        end
    end

    if clearSnapshot then
        originalCollision = {}
    end
end

local function enforceNoclip()
    if not character or not noclipEnabled or noclipSuspended then return end

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            if originalCollision[part] == nil then
                originalCollision[part] = part.CanCollide
            end
            if part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end

local function applyNoclip(state)
    noclipEnabled = state == true

    if noclipEnabled then
        if not noclipSuspended then
            enforceNoclip()
        end
    else
        restoreCollisionSnapshot(true)
    end
end

local function suspendNoclipForTeleport()
    if noclipSuspended then return end
    noclipSuspended = true

    -- Temporarily restore collisions so Humanoid path walking can use the floor.
    -- Keep the snapshot so the user's noclip setting can be restored afterward.
    restoreCollisionSnapshot(false)
end

local function resumeNoclipAfterTeleport()
    noclipSuspended = false
    if noclipEnabled then
        enforceNoclip()
    else
        restoreCollisionSnapshot(true)
    end
end

RunService.Stepped:Connect(function()
    if noclipEnabled and not noclipSuspended then
        enforceNoclip()
    end
end)

-- ==========================================
-- SPEED (frame-rate stable horizontal CFrame dash)
-- ==========================================

local function restoreNormalMovementState()
    if not humanoid then return end
    humanoid.AutoRotate = true
    humanoid.WalkSpeed = originalWalkSpeed
end

local function applyRapidDashStep(moveDir, dt)
    if not rootPart or not humanoid then return end

    local steer = Vector3.new(moveDir.X, 0, moveDir.Z)
    if steer.Magnitude <= 0.01 then return end

    local clampedSpeed = math.clamp(runSpeedValue, 0, MAX_SPEED_INPUT)
    local effectiveSpeed = math.min(clampedSpeed, MAX_EFFECTIVE_SPEED)
    if effectiveSpeed <= 0 then return end

    -- No minimum step: using a fixed minimum made movement FPS-dependent and
    -- produced much larger effective speeds on high-refresh displays.
    local stepDistance = math.clamp(
        effectiveSpeed * dt * RAPID_DASH_DAMPING,
        0,
        RAPID_DASH_MAX_STEP
    )

    if stepDistance <= 0 then return end

    local moveVector = steer.Unit * stepDistance
    local previousVelocity = rootPart.AssemblyLinearVelocity

    -- When noclip is off, do not CFrame straight through a wall. Crossing solid
    -- geometry in one frame is a common source of physics/server correction.
    if not noclipEnabled then
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        if character then
            rayParams.FilterDescendantsInstances = {character}
        end

        local hit = workspace:Raycast(rootPart.Position, moveVector, rayParams)
        if hit then
            local allowedDistance = math.max(hit.Distance - 1.25, 0)
            moveVector = steer.Unit * math.min(stepDistance, allowedDistance)
        end
    end

    if moveVector.Magnitude <= 0.001 then return end

    rootPart.CFrame = rootPart.CFrame + moveVector

    -- Preserve vertical physics so Super Speed does not cancel jumps/gravity or
    -- create a hover effect. Only discard horizontal residual velocity.
    rootPart.AssemblyLinearVelocity = Vector3.new(0, previousVelocity.Y, 0)
    rootPart.AssemblyAngularVelocity = Vector3.zero

    humanoid.WalkSpeed = 0
    humanoid.AutoRotate = false
end

RunService.RenderStepped:Connect(function(dt)
    if not humanoid or not rootPart then return end

    if not runSpeedEnabled then
        if observeCheatMode then
            startCheatObserver()
        end
        return
    end

    -- Never mutate velocity/WalkSpeed while another movement controller owns
    -- the character. V10.2 zeroed velocity here, which directly fought Fly and TP.
    if isFlying or isTPBusy then
        return
    end

    local st = humanoid:GetState()
    if st == Enum.HumanoidStateType.Dead
        or st == Enum.HumanoidStateType.Ragdoll
        or st == Enum.HumanoidStateType.Climbing
        or st == Enum.HumanoidStateType.Swimming
        or humanoid.Sit then
        humanoid.WalkSpeed = originalWalkSpeed
        humanoid.AutoRotate = true
        return
    end

    humanoid.WalkSpeed = 0
    humanoid.AutoRotate = false

    local moveDir = humanoid.MoveDirection
    if moveDir.Magnitude > 0.01 then
        applyRapidDashStep(moveDir, dt)

        if observeCheatMode then
            logPhysicsSnapshot("SPEED_MOVE")
        end
    end
end)

-- ==========================================
-- JUMP (Direct Impulse)
-- ==========================================

local function applyJump()
    if not jumpEnabled or not rootPart or not humanoid then return end
    if isTPBusy or isFlying then return end

    local state = humanoid:GetState()
    if state == Enum.HumanoidStateType.Dead
        or state == Enum.HumanoidStateType.Ragdoll
        or state == Enum.HumanoidStateType.Freefall
        or state == Enum.HumanoidStateType.FallingDown
        or state == Enum.HumanoidStateType.Swimming
        or state == Enum.HumanoidStateType.Climbing then
        return
    end

    if os.clock() - lastJumpReqTime < 0.15 then return end
    lastJumpReqTime = os.clock()

    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    local impulse = math.min(jumpPowerValue, MAX_JUMP_IMPULSE)
    local vel = rootPart.AssemblyLinearVelocity
    rootPart.AssemblyLinearVelocity = Vector3.new(
        vel.X,
        impulse,
        vel.Z
    )
end

-- ==========================================
-- ADVANCED TELEPORT SYSTEM
-- ==========================================

local function getSafeGroundPosition(targetCFrame)
    if not targetCFrame then return nil end

    local targetPos = targetCFrame.Position
    local origin = targetPos + Vector3.new(0, TP_GROUND_SCAN_UP, 0)

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    if character then
        raycastParams.FilterDescendantsInstances = {character}
    end

    local rayResult = workspace:Raycast(
        origin,
        Vector3.new(0, -(TP_GROUND_SCAN_UP + TP_GROUND_SCAN_DOWN), 0),
        raycastParams
    )

    if rayResult and humanoid and rootPart then
        local rootGroundOffset = humanoid.HipHeight + (rootPart.Size.Y * 0.5)
        local candidateY = rayResult.Position.Y + rootGroundOffset

        -- Only ground-snap when the nearby surface is reasonably close to the
        -- requested Y. This avoids snapping a saved indoor position to a roof or
        -- a different floor far above/below it.
        if math.abs(candidateY - targetPos.Y) <= TP_MAX_GROUND_ADJUST then
            local groundedPos = Vector3.new(targetPos.X, candidateY, targetPos.Z)
            return CFrame.new(groundedPos) * targetCFrame.Rotation
        end
    end

    return targetCFrame
end

local function teleportStillValid(token, expectedCharacter, expectedHumanoid, expectedRoot)
    return token == teleportSerial
        and character == expectedCharacter
        and humanoid == expectedHumanoid
        and rootPart == expectedRoot
        and expectedCharacter ~= nil
        and expectedCharacter.Parent ~= nil
        and expectedHumanoid ~= nil
        and expectedHumanoid.Parent ~= nil
        and expectedHumanoid.Health > 0
        and expectedRoot ~= nil
        and expectedRoot.Parent ~= nil
end

local function waitForTPMove(targetPosition, timeout, token, expectedCharacter, expectedHumanoid, expectedRoot)
    local started = os.clock()
    local lastProgressTime = started
    local lastProgressPosition = expectedRoot.Position

    while os.clock() - started < timeout do
        if not teleportStillValid(token, expectedCharacter, expectedHumanoid, expectedRoot) then
            return false
        end

        local currentPosition = expectedRoot.Position
        local delta = targetPosition - currentPosition
        local horizontalDistance = Vector3.new(delta.X, 0, delta.Z).Magnitude
        local verticalDistance = math.abs(delta.Y)

        if horizontalDistance <= TP_ARRIVAL_DISTANCE
            and verticalDistance <= TP_VERTICAL_TOLERANCE then
            return true
        end

        -- Count real character displacement as progress, including climbing or
        -- stair movement where X/Z may barely change while Y changes a lot.
        if (currentPosition - lastProgressPosition).Magnitude >= 0.2 then
            lastProgressPosition = currentPosition
            lastProgressTime = os.clock()
        end

        if os.clock() - lastProgressTime > 0.75 then
            return false
        end

        task.wait(0.05)
    end

    return false
end

local function walkToPosition(destination, token, expectedCharacter, expectedHumanoid, expectedRoot)
    if not teleportStillValid(token, expectedCharacter, expectedHumanoid, expectedRoot) then
        return false
    end

    local oldWalkSpeed = expectedHumanoid.WalkSpeed
    local oldAutoRotate = expectedHumanoid.AutoRotate
    local oldPlatformStand = expectedHumanoid.PlatformStand

    local function restoreMovement()
        if not expectedHumanoid or not expectedHumanoid.Parent then return end
        expectedHumanoid:Move(Vector3.zero, false)
        expectedHumanoid.PlatformStand = oldPlatformStand
        expectedHumanoid.AutoRotate = oldAutoRotate
        expectedHumanoid.WalkSpeed = oldWalkSpeed
    end

    expectedHumanoid.PlatformStand = false
    expectedHumanoid.AutoRotate = true

    local normalSpeed = originalWalkSpeed > 0 and originalWalkSpeed or 16
    expectedHumanoid.WalkSpeed = math.min(TP_WALK_SPEED, normalSpeed)

    expectedRoot.Anchored = false
    expectedRoot.AssemblyAngularVelocity = Vector3.zero

    local repaths = 0

    while repaths <= TP_MAX_REPATHS do
        if not teleportStillValid(token, expectedCharacter, expectedHumanoid, expectedRoot) then
            restoreMovement()
            return false
        end

        local destinationDelta = destination.Position - expectedRoot.Position
        local destinationHorizontal = Vector3.new(destinationDelta.X, 0, destinationDelta.Z).Magnitude

        if destinationHorizontal <= TP_ARRIVAL_DISTANCE
            and math.abs(destinationDelta.Y) <= TP_VERTICAL_TOLERANCE then
            restoreMovement()
            return true
        end

        local path = PathfindingService:CreatePath({
            AgentRadius = 2,
            AgentHeight = 5,
            AgentCanJump = true,
            AgentCanClimb = true,
            WaypointSpacing = 4,
            Costs = {
                Water = 20
            }
        })

        local computed, computeError = pcall(function()
            path:ComputeAsync(expectedRoot.Position, destination.Position)
        end)

        if not computed or path.Status ~= Enum.PathStatus.Success then
            log("TP", "Path compute failed: " .. tostring(computeError or path.Status))
            repaths = repaths + 1
            task.wait(0.15)
            continue
        end

        local waypoints = path:GetWaypoints()
        local shouldRepath = false
        local blockedWaypointIndex = nil
        local currentWaypointIndex = 2

        local blockedConnection = path.Blocked:Connect(function(blockedIndex)
            blockedWaypointIndex = blockedIndex
        end)

        for i = 2, #waypoints do
            currentWaypointIndex = i

            if not teleportStillValid(token, expectedCharacter, expectedHumanoid, expectedRoot) then
                blockedConnection:Disconnect()
                restoreMovement()
                return false
            end

            -- Ignore stale Blocked notifications for waypoints already passed.
            if blockedWaypointIndex and blockedWaypointIndex >= currentWaypointIndex then
                shouldRepath = true
                break
            end

            local waypoint = waypoints[i]

            if waypoint.Action == Enum.PathWaypointAction.Jump then
                expectedHumanoid.Jump = true
            end

            expectedHumanoid:MoveTo(waypoint.Position)

            local reached = waitForTPMove(
                waypoint.Position,
                TP_WAYPOINT_TIMEOUT,
                token,
                expectedCharacter,
                expectedHumanoid,
                expectedRoot
            )

            if not reached then
                shouldRepath = true
                break
            end

            local errorVector = waypoint.Position - expectedRoot.Position
            local horizontalError = Vector3.new(errorVector.X, 0, errorVector.Z).Magnitude

            if horizontalError > TP_REPATH_DISTANCE then
                shouldRepath = true
                break
            end

            expectedRoot.AssemblyAngularVelocity = Vector3.zero
        end

        blockedConnection:Disconnect()

        if not teleportStillValid(token, expectedCharacter, expectedHumanoid, expectedRoot) then
            restoreMovement()
            return false
        end

        local remainingVector = destination.Position - expectedRoot.Position
        local remainingHorizontal = Vector3.new(remainingVector.X, 0, remainingVector.Z).Magnitude

        if remainingHorizontal <= TP_ARRIVAL_DISTANCE
            and math.abs(remainingVector.Y) <= TP_VERTICAL_TOLERANCE then
            restoreMovement()
            return true
        end

        repaths = repaths + 1
        log("TP", string.format("Repath %d/%d", repaths, TP_MAX_REPATHS))

        if repaths <= TP_MAX_REPATHS then
            task.wait(0.1)
        end
    end

    restoreMovement()
    return false
end

local function absoluteTeleport(targetCFrame, useInterpolation)
    if not character or not rootPart or not humanoid or humanoid.Health <= 0 then return end
    if isTPBusy then
        log("TP", "Teleport request ignored: another teleport is already active")
        return
    end

    teleportSerial = teleportSerial + 1
    local token = teleportSerial

    local tpCharacter = character
    local tpHumanoid = humanoid
    local tpRoot = rootPart

    local wasFlying = isFlying

    isTPBusy = true
    suspendNoclipForTeleport()

    if wasFlying then
        setFlying(false)
    end

    local success, err = pcall(function()
        if not teleportStillValid(token, tpCharacter, tpHumanoid, tpRoot) then
            return
        end

        local safeCFrame = getSafeGroundPosition(targetCFrame)
        if not safeCFrame then
            error("No valid target CFrame")
        end

        local distance = (safeCFrame.Position - tpRoot.Position).Magnitude
        local riskyMode = shouldUseInstantTeleport() or (useInterpolation == false)

        log("TP", string.format(
            "Starting TP | Mode: %s | Distance: %.1f studs | Risky: %s",
            riskyMode and "Risky" or "TP-Walk",
            distance,
            tostring(riskyMode)
        ))

        if observeCheatMode then
            logPhysicsSnapshot("TP_BEFORE")
        end

        if riskyMode then
            freezeCharacterForTeleport()
            tpCharacter:PivotTo(safeCFrame)
            tpRoot.AssemblyLinearVelocity = Vector3.zero
            tpRoot.AssemblyAngularVelocity = Vector3.zero
            task.wait(0.05)

            if teleportStillValid(token, tpCharacter, tpHumanoid, tpRoot) then
                releaseCharacterAfterTeleport()
            end
        else
            tpRoot.Anchored = false
            tpHumanoid.PlatformStand = false
            tpHumanoid.AutoRotate = true
            tpRoot.AssemblyAngularVelocity = Vector3.zero

            local walked = walkToPosition(
                safeCFrame,
                token,
                tpCharacter,
                tpHumanoid,
                tpRoot
            )

            log("TP", walked and "TP-Walk completed" or "TP-Walk failed or was cancelled")
        end
    end)

    if not success then
        log("TP", "Teleport error: " .. tostring(err))
    end

    -- Finalize only if this is still the same teleport/character. A respawn or
    -- newer teleport invalidates this cleanup through teleportSerial.
    if token == teleportSerial and character == tpCharacter then
        if tpRoot and tpRoot.Parent then
            tpRoot.Anchored = false
            tpRoot.AssemblyAngularVelocity = Vector3.zero
        end

        if tpHumanoid and tpHumanoid.Parent and tpHumanoid.Health > 0 then
            tpHumanoid.PlatformStand = false
            tpHumanoid.Sit = false

            if runSpeedEnabled then
                tpHumanoid.WalkSpeed = 0
                tpHumanoid.AutoRotate = false
            else
                tpHumanoid.WalkSpeed = originalWalkSpeed
                tpHumanoid.AutoRotate = true
            end
        end

        resumeNoclipAfterTeleport()
        isTPBusy = false

        if wasFlying and flyToggleEnabled
            and tpRoot and tpRoot.Parent
            and tpHumanoid and tpHumanoid.Parent
            and tpHumanoid.Health > 0 then
            setFlying(true)
        end

        if observeCheatMode and rootPart then
            logPhysicsSnapshot("TP_AFTER")
        end
    end
end

