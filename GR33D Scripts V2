local function getEntrySpawn()
    if player.RespawnLocation and player.RespawnLocation:IsA("SpawnLocation") then
        return player.RespawnLocation.CFrame
    end

    local bestSpawn = nil
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") and obj.Enabled then
            if player.Team and obj.Neutral == false then
                if obj.TeamColor == player.TeamColor then
                    return obj.CFrame
                end
            else
                bestSpawn = obj.CFrame
            end
        end
    end

    if bestSpawn then return bestSpawn end
    if realSpawnCFrame then return realSpawnCFrame end

    return (rootPart and rootPart.CFrame) or CFrame.new(0, 10, 0)
end

-- ==========================================
-- FLY (camera-relative, conflict-safe)
-- ==========================================

setFlying = function(state)
    if not rootPart or not humanoid or not linearVelocity then return end
    if state and isTPBusy then return end
    if isFlying == state then return end

    isFlying = state == true

    if isFlying then
        linearVelocity.MaxForce = 100000
        linearVelocity.VectorVelocity = Vector3.zero
        flyVelocity = Vector3.zero

        pcall(function()
            humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
        end)

        log("FLY", "Flight ON")
    else
        linearVelocity.MaxForce = 0
        linearVelocity.VectorVelocity = Vector3.zero
        flyVelocity = Vector3.zero

        if rootPart and rootPart.Parent then
            local cur = rootPart.AssemblyLinearVelocity
            rootPart.AssemblyLinearVelocity = Vector3.new(cur.X * 0.2, cur.Y * 0.2, cur.Z * 0.2)
            rootPart.AssemblyAngularVelocity = Vector3.zero
        end

        log("FLY", "Flight OFF")
    end
end

local function getFlightTargetVelocity()
    if not humanoid then return Vector3.zero end

    local currentCamera = workspace.CurrentCamera
    if controls and currentCamera then
        local mv = controls:GetMoveVector()
        if mv.Magnitude > 0.01 then
            local camCF = currentCamera.CFrame
            local flightDir = (camCF.RightVector * mv.X) - (camCF.LookVector * mv.Z)
            if flightDir.Magnitude > 0.01 then
                return flightDir.Unit * FLY_SPEED
            end
        end
    end

    -- Fallback for control schemes where PlayerModule/GetControls is unavailable.
    local moveDir = humanoid.MoveDirection
    if moveDir.Magnitude > 0.01 then
        return moveDir.Unit * FLY_SPEED
    end

    return Vector3.zero
end

RunService.RenderStepped:Connect(function(dt)
    if not isFlying or isTPBusy or not rootPart or not humanoid or not linearVelocity then
        return
    end

    local st = humanoid:GetState()
    if st == Enum.HumanoidStateType.Dead or st == Enum.HumanoidStateType.Ragdoll then
        setFlying(false)
        return
    end

    local targetVel = getFlightTargetVelocity()
    local response = targetVel.Magnitude > 0.1 and FLY_ACCEL or FLY_DAMPING

    flyVelocity = flyVelocity:Lerp(
        targetVel,
        math.clamp(response * dt, 0, 1)
    )

    if targetVel.Magnitude < 0.1 and flyVelocity.Magnitude < 0.5 then
        flyVelocity = Vector3.zero
    end

    linearVelocity.VectorVelocity = flyVelocity
end)

