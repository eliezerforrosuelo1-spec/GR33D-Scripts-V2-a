local function parseStatValue(input)
	if type(input) == "number" then return input end
	if type(input) ~= "string" then return 0 end
	local upperInput = input:upper():gsub("%s+", "")
	if upperInput == "" or upperInput == "0" then return 0 end
	if upperInput:find("KG") or upperInput:find("TON") or upperInput:find("LUCK") or upperInput:find("%%") then return 0 end
	local numStr, suffix = upperInput:match("(%d+%.?%d*)([KMGT]?)")
	local num = tonumber(numStr)
	if not num then
		local cleaned = upperInput:gsub("[^0-9KMBT%.]", "")
		num = tonumber(cleaned:match("[%d%.]+"))
		if not num then return 0 end
		if cleaned:find("T") then return num * 1e12
		elseif cleaned:find("B") then return num * 1e9
		elseif cleaned:find("M") then return num * 1e6
		elseif cleaned:find("K") then return num * 1e3 end
		return num
	end
	local mult = 1
	if suffix == "T" or upperInput:find("TRILLION") then mult = 1e12
	elseif suffix == "B" or upperInput:find("BILLION") then mult = 1e9
	elseif suffix == "M" or upperInput:find("MILLION") then mult = 1e6
	elseif suffix == "K" or upperInput:find("THOUSAND") then mult = 1e3 end
	return num * mult
end

local function parseWeightValue(input)
	if type(input) == "number" then return input end
	if type(input) ~= "string" then return 0 end
	local upperInput = input:upper()
	local cleaned = upperInput:gsub("[^0-9%.]", "")
	local num = tonumber(cleaned:match("[%d%.]+"))
	if not num then return 0 end
	if upperInput:find("TON") then return num * 1000
	elseif upperInput:find("KG") then return num
	elseif upperInput:find("G") then return num / 1000 end
	return num
end

local function isValidGrabPrompt(prompt)
	if not prompt or not prompt.Enabled then return false end
	local parentObj = prompt.Parent
	if not parentObj or parentObj:IsA("ScreenGui") or parentObj:IsA("BillboardGui") or parentObj:IsA("SurfaceGui") or parentObj:IsA("TextButton") or parentObj:IsA("ImageButton") then return false end
	local actionText, objectText = prompt.ActionText:lower(), prompt.ObjectText:lower()
	local blockedKeywords = {"buy", "purchase", "view", "shop", "robux", "configure", "finish", "mining", "backpack", "group", "gift", "verify", "claim", "full", "reward", "spin", "upgrade", "warmth", "carry", "open"}
	for _, kw in ipairs(blockedKeywords) do
		if actionText:find(kw) or objectText:find(kw) then return false end
	end
	local ancestor = prompt:FindFirstAncestorOfClass("Model")
	if ancestor then
		local nameLower = ancestor.Name:lower()
		for _, kw in ipairs(blockedKeywords) do if nameLower:find(kw) then return end end
	end
	return true
end

