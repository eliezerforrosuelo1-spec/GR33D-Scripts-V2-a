    flyToggleEnabled = false
    isFlying = false
    if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
    setupCharacter(newChar)
    if isAnyFeatureActive() then ensureMainLoopRunning() end
end)

