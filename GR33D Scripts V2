local DEFAULT_SPEED      = 100
local MAX_SPEED          = 100    -- cap at 100 like the working cheat
local SPEED_STUDS_PER_SEC = 2800  -- hidden multiplier — what "speed 100" actually means
local MAX_JUMP_IMPULSE   = 107
local DEFAULT_JUMP       = 100
local MAX_SAFE_FALL      = 50
local DOUBLE_TAP_WINDOW  = 0.35

