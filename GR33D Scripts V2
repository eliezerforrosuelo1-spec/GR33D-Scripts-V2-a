-- 9. STEALTH TELEPORT (LOOPHOLE #4: interpolated CFrame steps, no Anchored)
-- ─────────────────────────────────────────

local function stealthTeleport(destCFrame, duration)
    if not rootPart then return end
    duration = duration or 0.05
    local startCFrame = rootPart.CFrame
    local steps = math.max(4, math.floor(duration / 0.008))
    local stepTime = duration / steps
    for i = 1, steps do
        local alpha = i / steps
        local newCF = startCFrame:Lerp(destCFrame, alpha)
        -- Loophole: velocity consistent with movement (no zero-velocity teleport signature)
        rootPart.AssemblyLinearVelocity = (newCF.Position - rootPart.Position) / math.max(stepTime, 0.008)
        rootPart.CFrame = newCF
        RunService.Heartbeat:Wait()
    end
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
end

