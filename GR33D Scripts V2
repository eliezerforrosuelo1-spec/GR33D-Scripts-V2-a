      local currentVel=rootPart.AssemblyLinearVelocity
      local moveVel=moveDir*runSpeedValue
      
      -- Lerp to target velocity smoothly (prevents rubber banding)
      local targetVel=currentVel:Lerp(
        Vector3.new(moveVel.X,currentVel.Y,moveVel.Z),
