-- ==========================================
-- INVISIBILITY
-- ==========================================

local function installInvisibilityHook()
    if invisibilityHookInstalled then return end
    invisibilityHookInstalled = true
    log("INVIS", "Installing metatable hook")
    pcall(function()
        local mt = getrawmetatable(game)
        oldNewIndex = hookfunction(mt.__newindex, newcclosure(function(t, k, v)
            if not checkcaller() and typeof(t) == "Instance" and t:IsA("BasePart") then
                local char = player.Character
                if char and t:IsDescendantOf(char) and invisibleEnabled then
                    if k == "Transparency" and v < 1 then
                        log("INVIS", "Blocked server Transparency write: " .. tostring(v))
                        return
                    end
                    if k == "LocalTransparencyModifier" and v < 1 then
                        log("INVIS", "Blocked server LTM write: " .. tostring(v))
                        return
                    end
                end
            end
            return oldNewIndex(t, k, v)
        end))
    end)
end

local function applyInvisibility(state)
    invisibleEnabled = state
    log("INVIS", "Invisibility toggled: " .. tostring(state))
    if not character then return end
    if state then
        installInvisibilityHook()
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("Decal") then
                if not originalTransparency[part] then
                    originalTransparency[part] = part.Transparency
                end
                part.Transparency = 1
                part.LocalTransparencyModifier = 1
            end
        end
    else
        for part, orig in pairs(originalTransparency) do
            if part and part.Parent then
                part.Transparency = orig
                part.LocalTransparencyModifier = 0
            end
        end
        originalTransparency = {}
    end
end

local function watchCharacterForInvisibility(char)
    char.DescendantAdded:Connect(function(desc)
        if invisibleEnabled and (desc:IsA("BasePart") or desc:IsA("Decal")) then
            originalTransparency[desc] = desc.Transparency
            desc.Transparency = 1
            desc.LocalTransparencyModifier = 1
        end
    end)
end

-- ==========================================
-- ANCHOR-TRICK TELEPORT
-- ==========================================

local function anchorTween(targetCFrame, duration)
    if not rootPart or not humanoid then return end
    if isAnchorBusy then
        log("TP", "anchorTween skipped - isAnchorBusy")
        return
    end
    isAnchorBusy = true

    local beforePos = rootPart.Position
    log("TP", string.format("anchorTween start: from (%.1f, %.1f, %.1f) to (%.1f, %.1f, %.1f) dur=%.3f",
        beforePos.X, beforePos.Y, beforePos.Z,
        targetCFrame.Position.X, targetCFrame.Position.Y, targetCFrame.Position.Z,
        duration or 0.05))

    if humanoid.Sit then humanoid.Sit = false end
    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)

    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
    rootPart.Anchored = true
    log("TP", "Anchored=true")

    local tween = TweenService:Create(
        rootPart,
        TweenInfo.new(duration or 0.05, Enum.EasingStyle.Linear),
        { CFrame = targetCFrame }
    )
    tween:Play()
    tween.Completed:Wait()

    rootPart.CFrame = targetCFrame
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero

    rootPart.Anchored = false
    humanoid:ChangeState(Enum.HumanoidStateType.Running)
    log("TP", string.format("anchorTween complete: at (%.1f, %.1f, %.1f)",
        rootPart.Position.X, rootPart.Position.Y, rootPart.Position.Z))

    isAnchorBusy = false
end

local function doTeleport(targetCFrame)
    if not character or not rootPart or not humanoid then return end
    if not targetCFrame then return end

    local targetPos = targetCFrame.Position + Vector3.new(0, 3, 0)
    local startPos  = rootPart.Position
    local distance  = (targetPos - startPos).Magnitude

    log("TP", "doTeleport distance=" .. string.format("%.1f", distance))

    local tweenDuration = math.clamp(distance / 5000, 0.03, 0.15)
    local finalCF = CFrame.new(targetPos) * (targetCFrame - targetCFrame.Position)

    anchorTween(finalCF, tweenDuration)
end

local function longDistanceTeleport(targetCFrame)
    if not rootPart or not targetCFrame then return end
    local startPos  = rootPart.Position
    local endPos    = targetCFrame.Position + Vector3.new(0, 3, 0)
    local totalDist = (endPos - startPos).Magnitude

    log("TP", string.format("longDistanceTeleport totalDist=%.1f", totalDist))

    if totalDist < TP_MAX_HOP then
        doTeleport(targetCFrame)
        return
    end

    local numHops = math.ceil(totalDist / TP_MAX_HOP)
    log("TP", "Chaining " .. numHops .. " hops of " .. TP_MAX_HOP .. " studs")
    for i = 1, numHops do
        if not rootPart or not rootPart.Parent then break end
        local alpha  = i / numHops
        local hopPos = startPos:Lerp(endPos, alpha)
        local hopCF  = CFrame.new(hopPos) * (targetCFrame - targetCFrame.Position)
        log("TP", "Hop " .. i .. "/" .. numHops)
        anchorTween(hopCF, 0.04)
        RunService.Heartbeat:Wait()
    end
end

local function getEntrySpawn()
    if entrySpawnCFrame then return entrySpawnCFrame end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") and obj.Enabled then
            entrySpawnCFrame = obj.CFrame
            log("TP", "Found spawn location at " .. tostring(obj.Position))
            return entrySpawnCFrame
        end
    end
    log("TP", "No SpawnLocation found, using current position")
    return rootPart and rootPart.CFrame or CFrame.new(0, 5, 0)
end

-- ==========================================
-- ANCHOR-TRICK SPEED
-- ==========================================

local function anchorTrickStep(dt)
    if not runSpeedEnabled or not rootPart or not humanoid or isFlying then return end
    if isAnchorBusy or isJumping then return end

    local moveDir = humanoid.MoveDirection
    if moveDir.Magnitude < 0.01 then return end

    local speed = math.min(runSpeedValue, MAX_RUN_SPEED)
    local currentPos = rootPart.Position
    local delta = Vector3.new(
        moveDir.X * speed * dt,
        0,
        moveDir.Z * speed * dt
    )
    local targetPos = currentPos + delta

    isAnchorBusy = true
    rootPart.Anchored = true
    rootPart.CFrame = CFrame.new(targetPos, targetPos + moveDir)
    rootPart.AssemblyLinearVelocity = Vector3.new(
        moveDir.X * speed,
        rootPart.AssemblyLinearVelocity.Y,
        moveDir.Z * speed
    )
    rootPart.Anchored = false
    isAnchorBusy = false
end

-- ==========================================
-- ANCHOR-TRICK JUMP
-- ==========================================

local function anchorTrickJump()
    if not jumpEnabled or not rootPart or not humanoid then return end
    if isAnchorBusy or isJumping then
        log("JUMP", "Skipped: busy (isAnchorBusy=" .. tostring(isAnchorBusy) .. " isJumping=" .. tostring(isJumping) .. ")")
        return
    end
    if humanoid.FloorMaterial == Enum.Material.Air then
        log("JUMP", "Skipped: not on ground")
        return
    end

    if os.clock() - lastJumpFrame < 0.3 then
        log("JUMP", "Skipped: cooldown")
        return
    end
    lastJumpFrame = os.clock()

    isJumping = true
    local jumpHeight = math.min(jumpPowerValue, MAX_JUMP_POWER) * 0.05
    local startPos = rootPart.Position
    local apexPos = startPos + Vector3.new(0, jumpHeight, 0)

    log("JUMP", string.format("anchorTrickJump: height=%.1f from Y=%.1f to Y=%.1f",
        jumpHeight, startPos.Y, apexPos.Y))

    isAnchorBusy = true
    rootPart.Anchored = true
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero

    local tween = TweenService:Create(
        rootPart,
        TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { CFrame = CFrame.new(apexPos) * (rootPart.CFrame - rootPart.CFrame.Position) }
    )
    tween:Play()
    tween.Completed:Wait()

    rootPart.CFrame = CFrame.new(apexPos) * (rootPart.CFrame - rootPart.CFrame.Position)
    rootPart.Anchored = false
    humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
    log("JUMP", "Jump complete, unanchored, state=Freefall")

    isAnchorBusy = false
    isJumping = false
end

-- ==========================================
-- FLIGHT
-- ==========================================

local function setFlying(state)
    if not rootPart or not humanoid or not linearVelocity then return end
    log("FLY", "setFlying: " .. tostring(state))
    isFlying = state
    if isFlying then
        linearVelocity.MaxForce = 100000
        humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
    else
        linearVelocity.MaxForce = 0
        linearVelocity.VectorVelocity = Vector3.zero
        if humanoid.FloorMaterial ~= Enum.Material.Air then
            humanoid:ChangeState(Enum.HumanoidStateType.Running)
        end
    end
end

