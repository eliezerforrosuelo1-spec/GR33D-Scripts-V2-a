local function parseStatValue(input)
  if type(input)=="number" then
    return input
  end
  if type(input)~="string" then
    return 0
  end
  
  local upperInput=input:upper():gsub("%s+","")
  if upperInput=="" or upperInput=="0" then
    return 0
  end
  
  -- Skip certain keywords that shouldn't be parsed as values
  if upperInput:find("KG") or upperInput:find("TON") or upperInput:find("LUCK") or upperInput:find("%%") then
    return 0
  end
  
  -- Enhanced pattern to include B (billion), T (trillion), M (million), K (thousand), G (giga)
  local numStr,suffix=upperInput:match("(%d+%.?%d*)([KMGTB]?)")
  local num=tonumber(numStr)
  
  if not num then
    -- Fallback: extract just the numbers
    local cleaned=upperInput:gsub("[^0-9KMGTB%.]","")
    num=tonumber(cleaned:match("[%d%.]+"))
    if not num then
      return 0
    end
    -- Check for multiplier in the cleaned string
    if cleaned:find("T") then
      return num*1e12
    elseif cleaned:find("B") then
      return num*1e9
    elseif cleaned:find("G") then
      return num*1e9  -- G often means giga/billion
    elseif cleaned:find("M") then
      return num*1e6
    elseif cleaned:find("K") then
      return num*1e3
    end
    return num
  end
  
  -- Apply multiplier based on suffix
  local mult=1
  if suffix=="T" or upperInput:find("TRILLION") then
    mult=1e12
  elseif suffix=="B" or upperInput:find("BILLION") then
    mult=1e9
  elseif suffix=="G" or upperInput:find("GIGA") then
    mult=1e9
  elseif suffix=="M" or upperInput:find("MILLION") then
    mult=1e6
  elseif suffix=="K" or upperInput:find("THOUSAND") then
    mult=1e3
  end
  
  return num*mult
end
