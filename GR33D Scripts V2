local function scanAndExtractStats(targetObj)
	local statData = { Value = 0, Luck = 0, Size = 0, Weight = 0, RarityScore = 0 }
	if not targetObj then return statData end

	pcall(function()
		if targetObj:IsA("Model") then
			statData.Size = targetObj:GetExtentsSize().Magnitude
		elseif targetObj:IsA("BasePart") then
			statData.Size = targetObj.Size.Magnitude
		end
	end)

	pcall(function()
		for attrName, val in pairs(targetObj:GetAttributes()) do
			local nameLower = attrName:lower()
			local valStr = tostring(val):lower()
			local numericVal = parseStatValue(val)
			local weightVal = parseWeightValue(val)
			if nameLower:find("val") or nameLower:find("price") or nameLower:find("cash") or nameLower:find("money") or nameLower:find("gamevalue") then
				if numericVal > statData.Value then statData.Value = numericVal end
			elseif nameLower:find("luck") then
				if numericVal > statData.Luck then statData.Luck = numericVal end
			elseif nameLower:find("weight") or nameLower:find("mass") then
				if weightVal > statData.Weight then statData.Weight = weightVal end
			elseif nameLower:find("size") then
				if numericVal > statData.Size then statData.Size = numericVal end
			elseif nameLower:find("rarity") or valStr:find("legendary") or valStr:find("mythic") or valStr:find("secret") then
				statData.RarityScore = statData.RarityScore + 100
			end
		end
	end)

	pcall(function()
		for _, desc in ipairs(targetObj:GetDescendants()) do
			if desc:IsA("TextLabel") and (desc.Parent:IsA("BillboardGui") or desc.Parent:IsA("SurfaceGui")) then
				local text = desc.Text
				local textLower = text:lower()
				local parsedVal = parseStatValue(text)
				local parsedWeight = parseWeightValue(text)
				
				if textLower:find("luck") or textLower:find("%%") then
					if parsedVal > statData.Luck then statData.Luck = parsedVal end
				elseif textLower:find("ton") or textLower:find("kg") then
					if parsedWeight > statData.Weight then statData.Weight = parsedWeight end
				else
					if parsedVal > 0 and parsedVal > statData.Value then
						statData.Value = parsedVal
					end
				end

				if textLower:find("secret") or textLower:find("mythic") or textLower:find("godly") or textLower:find("legendary") then
					statData.RarityScore = statData.RarityScore + 500
				end
			end
		end
	end)

	return statData
end

local function executeAutoGrabRoutine()
	if not rootPart then return end
	
	for _, prompt in ipairs(cachedPrompts) do
		if isValidGrabPrompt(prompt) then
			local targetModel = prompt:FindFirstAncestorOfClass("Model") or prompt.Parent
			local distance = (rootPart.Position - targetModel:GetPivot().Position).Magnitude
			if distance <= 45 then
				local stats = scanAndExtractStats(targetModel)
				local targetVal = getgenv().TargetValue or 0
				local targetLuck = getgenv().TargetLuck or 0
				local targetSize = getgenv().TargetSize or 0
				
				local meetsCriteria = false
				local activeFiltersCount = 0
				
				if targetVal > 0 then activeFiltersCount = activeFiltersCount + 1 end
				if targetLuck > 0 then activeFiltersCount = activeFiltersCount + 1 end
				if targetSize > 0 then activeFiltersCount = activeFiltersCount + 1 end
				
				if activeFiltersCount == 0 then
					meetsCriteria = true
				else
					local valueMatches = true
					local luckMatches = true
					local sizeMatches = true
					
					if targetVal > 0 then
						if math.abs(stats.Value - targetVal) > (targetVal * 0.25) then
							valueMatches = false
						end
					end
					
					if targetLuck > 0 then
						if stats.Luck < targetLuck then
							luckMatches = false
						end
					end
					
					if targetSize > 0 then
						if stats.Size < targetSize and stats.Weight < targetSize then
							sizeMatches = false
						end
					end
					
					if targetVal > 0 and targetLuck == 0 and targetSize == 0 then
						meetsCriteria = valueMatches
					else
						meetsCriteria = true
						if targetVal > 0 and not valueMatches then meetsCriteria = false end
						if targetLuck > 0 and not luckMatches then meetsCriteria = false end
						if targetSize > 0 and not sizeMatches then meetsCriteria = false end
					end
				end

				if meetsCriteria then 
					fireproximityprompt(prompt) 
				end
			end
		end
	end
end

-- Integrated Fast Tweened TP with Instant Spawn Return & Anti-Cheat Evasion
local function SafeTeleportAndGrabHighestValue()
	if not character or not rootPart then return end
	
	local originalCFrame = rootPart.CFrame
	if not InitialSpawnCFrame then
		InitialSpawnCFrame = originalCFrame
	end

	local highestItem = nil
	local highestPrompt = nil
	local maxVal = -math.huge

	-- One-time comprehensive scan across the entire server workspace for Brainrot or Eggs with highest game value
	for _, obj in ipairs(Workspace:GetDescendants()) do
		local nameLower = obj.Name:lower()
		if nameLower:find("brainrot") or nameLower:find("egg") or obj:IsA("ProximityPrompt") then
			local targetModel = obj:IsA("ProximityPrompt") and (obj:FindFirstAncestorOfClass("Model") or obj.Parent) or (obj:IsA("Model") and obj or obj:FindFirstAncestorOfClass("Model"))
			if targetModel and targetModel ~= character and not Players:GetPlayerFromCharacter(targetModel) then
				local stats = scanAndExtractStats(targetModel)
				if stats.Value > maxVal then
					maxVal = stats.Value
					highestItem = targetModel
					if obj:IsA("ProximityPrompt") then
						highestPrompt = obj
					else
						highestPrompt = targetModel:FindFirstChildWhichIsA("ProximityPrompt", true)
					end
				end
			end
		end
	end

	if not highestItem then
		-- Fallback to scanning all models if no explicit brainrot/egg keyword matched
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("Model") and obj ~= character and not Players:GetPlayerFromCharacter(obj) then
				local stats = scanAndExtractStats(obj)
				if stats.Value > maxVal then
					maxVal = stats.Value
					highestItem = obj
					highestPrompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
				end
			end
		end
	end

	if not highestItem then return end

	local targetPart = highestItem:IsA("Model") and (highestItem.PrimaryPart or highestItem:FindFirstChild("HumanoidRootPart") or highestItem:FindFirstChildWhichIsA("BasePart")) or highestItem
	if not targetPart then return end

	local destinationCFrame = targetPart:IsA("BasePart") and targetPart.CFrame or highestItem:GetPivot()

	local function smoothTeleport(destCFrame)
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
		
		local tweenInfo = TweenInfo.new(0.05, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
		local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = destCFrame})
		
		rootPart.Anchored = true
		tween:Play()
		tween.Completed:Wait()
		rootPart.Anchored = false
		rootPart.AssemblyLinearVelocity = Vector3.zero
	end

	-- 1. Tween instantly to highest value location
	smoothTeleport(destinationCFrame + Vector3.new(0, 3, 0))

	-- 2. Grab item securely (Fire prompt or touch interests)
	task.wait(0.05)
	if highestPrompt then
		pcall(function() fireproximityprompt(highestPrompt) end)
	end
	if highestItem:IsA("Model") then
		for _, part in ipairs(highestItem:GetDescendants()) do
			if part:IsA("BasePart") then
				pcall(function()
					firetouchinterest(rootPart, part, 0)
					firetouchinterest(rootPart, part, 1)
				end)
			end
		end
	elseif highestItem:IsA("BasePart") then
		pcall(function()
			firetouchinterest(rootPart, highestItem, 0)
			firetouchinterest(rootPart, highestItem, 1)
		end)
	end

	-- 3. Return instantly back to original spawn location to prevent desync / anti-cheat flags
	smoothTeleport(InitialSpawnCFrame)
end

local function setFlying(state)
	if not rootPart or not humanoid or not linearVelocity then return end
	isFlying = state

	if isFlying then
		linearVelocity.MaxForce = 100000 
		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	else
		linearVelocity.MaxForce = 0
		linearVelocity.VectorVelocity = Vector3.zero
		
		if humanoid.FloorMaterial ~= Enum.Material.Air then
			humanoid:ChangeState(Enum.HumanoidStateType.Running)
		end
	end
end

local function handleJumpTap()
	if not flyToggleEnabled then return end
	local currentTime = os.clock()
	local timeSinceLastTap = currentTime - lastJumpTapTime

	if timeSinceLastTap <= DOUBLE_TAP_WINDOW then
		if isFlying then
			setFlying(false)
		elseif humanoid and (humanoid:GetState() == Enum.HumanoidStateType.Freefall or humanoid:GetState() == Enum.HumanoidStateType.Jumping) then
			setFlying(true)
		end
		lastJumpTapTime = 0
	else
		lastJumpTapTime = currentTime
	end
end

