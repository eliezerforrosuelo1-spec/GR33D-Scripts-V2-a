    runSpeedEnabled = false
    originalCollision = {}
    flyVelocity = Vector3.zero
    if linearVelocity then linearVelocity.MaxForce = 0 end
    if speedLinearVelocity then speedLinearVelocity.MaxForce = 0 end
    setupCharacter(c)
end)

