-- Noclip + fall reset (Stepped = physics rate)
RunService.Stepped:Connect(function()
    if not character or not rootPart then return end

    -- Prevent server from anchoring us
    if rootPart.Anchored then
        rootPart.Anchored = false
    end

    if noclipEnabled then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
                part.CanTouch = false
                part.CanQuery = false
            end
        end
    end

    -- Fall-through-world protection
    if rootPart.Position.Y < -50 then
        absoluteTeleport(getEntrySpawn())
    end
end)

-- Main render loop: flight, speed, jump, no-fall
RunService.RenderStepped:Connect(function(dt)
    if not camera or not camera.Parent then
        camera = workspace.CurrentCamera
        return
    end

    -- FLIGHT
    if isFlying and linearVelocity and humanoid and rootPart then
        if humanoid.FloorMaterial ~= Enum.Material.Air then
            setFlying(false)
        elseif controls then
            local moveVector = controls:GetMoveVector()
            if moveVector.Magnitude > 0 then
                local camCFrame = camera.CFrame
                local flightDir = (camCFrame.RightVector * moveVector.X) - (camCFrame.LookVector * moveVector.Z)
                linearVelocity.VectorVelocity = flightDir.Unit * FLY_SPEED
            else
                linearVelocity.VectorVelocity = Vector3.zero
            end
        end
    end

    -- SUPER SPEED (LOOPHOLE: physics velocity, not WalkSpeed)
    if runSpeedEnabled and rootPart and humanoid and not isFlying then
        local moveDir = humanoid.MoveDirection
        if moveDir.Magnitude > 0 then
            local currentVel = rootPart.AssemblyLinearVelocity
            -- Clamp to prevent rubberbanding — server accepts up to ~300 studs/s
            local targetSpeed = math.min(runSpeedValue, MAX_RUN_SPEED)
            rootPart.AssemblyLinearVelocity = Vector3.new(
                moveDir.X * targetSpeed,
                currentVel.Y,
                moveDir.Z * targetSpeed
            )
        end
    end

    -- CUSTOM JUMP (LOOPHOLE: physics impulse, not JumpPower)
    if jumpEnabled and humanoid and rootPart then
        if humanoid:GetState() == Enum.HumanoidStateType.Jumping then
            local currentVel = rootPart.AssemblyLinearVelocity
            if currentVel.Y < jumpPowerValue * 0.5 then
                rootPart.AssemblyLinearVelocity = Vector3.new(
                    currentVel.X,
                    jumpPowerValue,
                    currentVel.Z
                )
            end
        end
    end

    -- NO FALL DAMAGE
    if noFallDamageEnabled and humanoid and rootPart then
        if humanoid:GetState() == Enum.HumanoidStateType.Freefall
            or humanoid:GetState() == Enum.HumanoidStateType.FallingDown then
            if rootPart.AssemblyLinearVelocity.Y < -45 then
                rootPart.AssemblyLinearVelocity = Vector3.new(
                    rootPart.AssemblyLinearVelocity.X,
                    0,
                    rootPart.AssemblyLinearVelocity.Z
                )
            end
        end
    end
end)

-- ==========================================
-- CHARACTER SETUP
-- ==========================================

local function setupCharacter(char)
    character = char
    rootPart = char:WaitForChild("HumanoidRootPart")
    humanoid = char:WaitForChild("Humanoid")

    rootPart.CanCollide = false
    rootPart.Anchored = false

    -- Clean old flight objects
    if rootPart:FindFirstChild("FlightAttachment") then rootPart.FlightAttachment:Destroy() end
    if rootPart:FindFirstChild("FlightVelocity") then rootPart.FlightVelocity:Destroy() end

    attachment = Instance.new("Attachment")
    attachment.Name = "FlightAttachment"
    attachment.Parent = rootPart

    linearVelocity = Instance.new("LinearVelocity")
    linearVelocity.Name = "FlightVelocity"
    linearVelocity.Attachment0 = attachment
    linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    linearVelocity.MaxForce = 0
    linearVelocity.VectorVelocity = Vector3.zero
    linearVelocity.Parent = rootPart

    -- Watch for new parts (invisibility)
    watchCharacterForInvisibility(char)

    -- Re-apply invisibility if it was on
    if invisibleEnabled then
        applyInvisibility(true)
    end

    if flyToggleEnabled then
        setFlying(true)
    end
end

setupCharacter(player.Character or player.CharacterAdded:Wait())
player.CharacterAdded:Connect(function(newChar)
    flyToggleEnabled = false
    isFlying = false
    if linearVelocity then linearVelocity.MaxForce = 0 end
    originalTransparency = {}
    setupCharacter(newChar)
end)

