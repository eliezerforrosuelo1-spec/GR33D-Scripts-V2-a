-- ==========================================
-- INVISIBILITY
-- ==========================================

local function installInvisibilityHook()
    if invisibilityHookInstalled then return end
    invisibilityHookInstalled = true
    log("INVIS", "Installing metatable hook")
    pcall(function()
        local mt = getrawmetatable(game)
        oldNewIndex = hookfunction(mt.__newindex, newcclosure(function(t, k, v)
            if not checkcaller() and typeof(t) == "Instance" and t:IsA("BasePart") then
                local char = player.Character
                if char and t:IsDescendantOf(char) and invisibleEnabled then
                    if k == "Transparency" and v < 1 then
                        log("INVIS", "Blocked server Transparency write")
                        return
                    end
                    if k == "LocalTransparencyModifier" and v < 1 then
                        log("INVIS", "Blocked server LTM write")
                        return
                    end
                end
            end
            return oldNewIndex(t, k, v)
        end))
    end)
end

local function applyInvisibility(state)
    invisibleEnabled = state
    log("INVIS", "Invisibility toggled: " .. tostring(state))
    if not character then return end
    if state then
        installInvisibilityHook()
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("Decal") then
                if not originalTransparency[part] then
                    originalTransparency[part] = part.Transparency
                end
                part.Transparency = 1
                part.LocalTransparencyModifier = 1
            end
        end
    else
        for part, orig in pairs(originalTransparency) do
            if part and part.Parent then
                part.Transparency = orig
                part.LocalTransparencyModifier = 0
            end
        end
        originalTransparency = {}
    end
end

local function watchCharacterForInvisibility(char)
    char.DescendantAdded:Connect(function(desc)
        if invisibleEnabled and (desc:IsA("BasePart") or desc:IsA("Decal")) then
            originalTransparency[desc] = desc.Transparency
            desc.Transparency = 1
            desc.LocalTransparencyModifier = 1
        end
    end)
end

-- ==========================================
-- TELEPORT (velocity launch — server-valid)
-- ==========================================

local function launchTeleport(targetCFrame)
    if not rootPart or not humanoid then return end
    if not targetCFrame then return end
    if isTPBusy then
        log("TP", "Skipped: isTPBusy")
        return
    end
    isTPBusy = true

    local startPos  = rootPart.Position
    local targetPos = targetCFrame.Position + Vector3.new(0, 3, 0)
    local distance  = (targetPos - startPos).Magnitude

    log("TP", string.format("launchTeleport dist=%.1f from (%.1f, %.1f, %.1f) to (%.1f, %.1f, %.1f)",
        distance,
        startPos.X, startPos.Y, startPos.Z,
        targetPos.X, targetPos.Y, targetPos.Z))

    if distance < 5 then
        log("TP", "Already at target")
        isTPBusy = false
        return
    end

    -- Travel time based on server-safe speed
    local travelTime = distance / MAX_SERVER_SAFE_SPEED

    -- Gravity counter — prevents falling during flight
    local attach = Instance.new("Attachment")
    attach.Parent = rootPart
    local counter = Instance.new("VectorForce")
    counter.Attachment0 = attach
    counter.RelativeTo = Enum.ActuatorRelativeTo.World
    counter.ApplyAtCenterOfMass = true
    counter.Force = Vector3.new(0, rootPart.AssemblyMass * workspace.Gravity, 0)
    counter.Parent = rootPart

    -- Initial launch
    local dir = (targetPos - startPos).Unit
    rootPart.AssemblyLinearVelocity = dir * MAX_SERVER_SAFE_SPEED

    -- Steer toward target each frame
    local startTime = os.clock()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not rootPart or not rootPart.Parent then
            if conn then conn:Disconnect() end
            if counter and counter.Parent then counter:Destroy() end
            if attach and attach.Parent then attach:Destroy() end
            isTPBusy = false
            return
        end

        local distToTarget = (targetPos - rootPart.Position).Magnitude
        local elapsed = os.clock() - startTime

        if distToTarget < 15 or elapsed > travelTime + 1 then
            rootPart.AssemblyLinearVelocity = Vector3.zero
            if counter and counter.Parent then counter:Destroy() end
            if attach and attach.Parent then attach:Destroy() end
            if conn then conn:Disconnect() end
            log("TP", string.format("Complete: at (%.1f, %.1f, %.1f) in %.3fs",
                rootPart.Position.X, rootPart.Position.Y, rootPart.Position.Z, elapsed))
            isTPBusy = false
            return
        end

        -- Steer
        local steeringDir = (targetPos - rootPart.Position).Unit
        rootPart.AssemblyLinearVelocity = steeringDir * MAX_SERVER_SAFE_SPEED
    end)
end

local function longDistanceTeleport(targetCFrame)
    if not rootPart or not targetCFrame then return end
    launchTeleport(targetCFrame)
end

local function getEntrySpawn()
    if entrySpawnCFrame then return entrySpawnCFrame end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") and obj.Enabled then
            entrySpawnCFrame = obj.CFrame
            log("TP", "Found spawn at " .. tostring(obj.Position))
            return entrySpawnCFrame
        end
    end
    log("TP", "No SpawnLocation — using current position")
    return rootPart and rootPart.CFrame or CFrame.new(0, 5, 0)
end

-- ==========================================
-- SPEED (velocity only — no anchor, no CFrame)
-- ==========================================

local function speedStep()
    if not runSpeedEnabled or not humanoid or not rootPart or isFlying then return end

    local moveDir = humanoid.MoveDirection
    if moveDir.Magnitude < 0.01 then return end

    local speed = math.min(runSpeedValue, MAX_SERVER_SAFE_SPEED)
    local currentVel = rootPart.AssemblyLinearVelocity

    rootPart.AssemblyLinearVelocity = Vector3.new(
        moveDir.X * speed,
        currentVel.Y,
        moveDir.Z * speed
    )
end

-- ==========================================
-- JUMP (impulse velocity only)
-- ==========================================

local function impulseJump()
    if not jumpEnabled or not rootPart or not humanoid then return end
    if humanoid.FloorMaterial == Enum.Material.Air then
        log("JUMP", "Skipped: not on ground")
        return
    end
    if os.clock() - lastJumpFrame < 0.3 then
        log("JUMP", "Skipped: cooldown")
        return
    end
    lastJumpFrame = os.clock()

    local safeVelocity = math.min(jumpPowerValue, MAX_SAFE_JUMP_VELOCITY)

    rootPart.AssemblyLinearVelocity = Vector3.new(
        rootPart.AssemblyLinearVelocity.X,
        safeVelocity,
        rootPart.AssemblyLinearVelocity.Z
    )

    log("JUMP", string.format("impulse velocity=%.1f", safeVelocity))
end

-- ==========================================
-- FLIGHT
-- ==========================================

local function setFlying(state)
    if not rootPart or not humanoid or not linearVelocity then return end
    log("FLY", "setFlying: " .. tostring(state))
    isFlying = state
    if isFlying then
        linearVelocity.MaxForce = 100000
        humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
    else
        linearVelocity.MaxForce = 0
        linearVelocity.VectorVelocity = Vector3.zero
        if humanoid.FloorMaterial ~= Enum.Material.Air then
            humanoid:ChangeState(Enum.HumanoidStateType.Running)
        end
    end
end

