local function createToggle(name, y, cb)
    local row = Instance.new("Frame", container)
    row.Size = UDim2.new(0.9, 0, 0, 32)
    row.Position = UDim2.new(0.05, 0, 0, y)
    row.BackgroundTransparency = 1

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(0.6, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = name
    lbl.TextColor3 = Color3.fromRGB(200, 200, 210)
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local sw = Instance.new("TextButton", row)
    sw.Size = UDim2.new(0, 36, 0, 18)
    sw.Position = UDim2.new(1, -36, 0.5, -9)
    sw.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    sw.Text = ""
    sw.AutoButtonColor = false
    Instance.new("UICorner", sw).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame", sw)
    knob.Size = UDim2.new(0, 12, 0, 12)
    knob.Position = UDim2.new(0, 3, 0.5, -6)
    knob.BackgroundColor3 = Color3.fromRGB(200, 200, 210)
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local a = false
    sw.MouseButton1Click:Connect(function()
        a = not a
        sw.BackgroundColor3 = a and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(40, 40, 50)
        knob.BackgroundColor3 = a and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 210)
        knob:TweenPosition(a and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6),
            Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        cb(a)
    end)
end

local function createInput(name, y, def, cb)
    local row = Instance.new("Frame", container)
    row.Size = UDim2.new(0.9, 0, 0, 32)
    row.Position = UDim2.new(0.05, 0, 0, y)
    row.BackgroundTransparency = 1

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(0.5, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = name
    lbl.TextColor3 = Color3.fromRGB(200, 200, 210)
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local box = Instance.new("TextBox", row)
    box.Size = UDim2.new(0, 60, 0, 22)
    box.Position = UDim2.new(1, -60, 0.5, -11)
    box.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
    box.Text = tostring(def)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.Font = Enum.Font.GothamBold
    box.TextSize = 11
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n then cb(n) else box.Text = tostring(def) end
    end)
end

local function createButton(name, y, color, cb)
    local b = Instance.new("TextButton", container)
    b.Size = UDim2.new(0.9, 0, 0, 28)
    b.Position = UDim2.new(0.05, 0, 0, y)
    b.BackgroundColor3 = color
    b.Text = name
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    b.MouseButton1Click:Connect(cb)
    return b
end

