-- ==========================================
-- INVISIBILITY (server-replicated Transparency)
-- ==========================================

local function installInvisibilityHook()
    if invisibilityHookInstalled then return end
    invisibilityHookInstalled = true
    pcall(function()
        local mt = getrawmetatable(game)
        oldNewIndex = hookfunction(mt.__newindex, newcclosure(function(t, k, v)
            if not checkcaller() and typeof(t) == "Instance" and t:IsA("BasePart") then
                local char = player.Character
                if char and t:IsDescendantOf(char) and invisibleEnabled then
                    if k == "Transparency" and v < 1 then return end
                    if k == "LocalTransparencyModifier" and v < 1 then return end
                end
            end
            return oldNewIndex(t, k, v)
        end))
    end)
end

local function applyInvisibility(state)
    invisibleEnabled = state
    if not character then return end
    if state then
        installInvisibilityHook()
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("Decal") then
                if not originalTransparency[part] then
                    originalTransparency[part] = part.Transparency
                end
                part.Transparency = 1
                part.LocalTransparencyModifier = 1
            end
        end
    else
        for part, orig in pairs(originalTransparency) do
            if part and part.Parent then
                part.Transparency = orig
                part.LocalTransparencyModifier = 0
            end
        end
        originalTransparency = {}
    end
end

local function watchCharacterForInvisibility(char)
    char.DescendantAdded:Connect(function(desc)
        if invisibleEnabled and (desc:IsA("BasePart") or desc:IsA("Decal")) then
            originalTransparency[desc] = desc.Transparency
            desc.Transparency = 1
            desc.LocalTransparencyModifier = 1
        end
    end)
end

-- ==========================================
-- ABSOLUTE TELEPORT (AlignPosition physics pull)
-- ==========================================

local function absoluteTeleport(targetCFrame)
    if not character or not rootPart or not humanoid then return end
    if not targetCFrame then return end

    -- Cleanup previous
    local oldAlign = rootPart:FindFirstChild("__tp_align")
    if oldAlign then oldAlign:Destroy() end
    local oldAttachRoot = rootPart:FindFirstChild("__tp_attach_root")
    if oldAttachRoot then oldAttachRoot:Destroy() end
    local oldCounter = rootPart:FindFirstChild("__tp_counter")
    if oldCounter then oldCounter:Destroy() end
    local oldAttachTarget = workspace:FindFirstChild("__tp_target")
    if oldAttachTarget then oldAttachTarget:Destroy() end

    local targetPos = targetCFrame.Position + Vector3.new(0, 3, 0)
    local startPos  = rootPart.Position
    local distance  = (targetPos - startPos).Magnitude

    -- Tiny distance: physics hop
    if distance < 8 then
        rootPart.AssemblyLinearVelocity = (targetPos - startPos).Unit * distance * 10
        return
    end

    -- Target attachment (world-anchored)
    local attachTarget = Instance.new("Attachment")
    attachTarget.Name = "__tp_target"
    attachTarget.WorldPosition = targetPos
    attachTarget.Parent = workspace.Terrain

    -- Root attachment
    local attachRoot = Instance.new("Attachment")
    attachRoot.Name = "__tp_attach_root"
    attachRoot.Parent = rootPart

    -- AlignPosition — Roblox's legit physics constraint
    local alignPos = Instance.new("AlignPosition")
    alignPos.Name = "__tp_align"
    alignPos.Attachment0 = attachRoot
    alignPos.Attachment1 = attachTarget
    alignPos.Mode = Enum.PositionAlignmentMode.TwoAttachment
    alignPos.Responsiveness = TP_RESPONSIVENESS
    alignPos.MaxForce = TP_MAX_FORCE
    alignPos.ApplyAtCenterOfMass = false
    alignPos.RigidityEnabled = false
    alignPos.Parent = rootPart

    -- Gravity counter (VectorForce) — avoids touching workspace.Gravity
    local counter = Instance.new("VectorForce")
    counter.Name = "__tp_counter"
    counter.Attachment0 = attachRoot
    counter.RelativeTo = Enum.ActuatorRelativeTo.World
    counter.ApplyAtCenterOfMass = true
    counter.Force = Vector3.new(0, rootPart.AssemblyMass * workspace.Gravity, 0)
    counter.Parent = rootPart

    -- Velocity matcher + arrival detection
    local startTime = os.clock()
    local arrived = false
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not rootPart or not rootPart.Parent then
            if conn then conn:Disconnect() end
            return
        end
        local currentPos = rootPart.Position
        local distToTarget = (targetPos - currentPos).Magnitude

        -- Match velocity to actual per-frame movement
        local delta = currentPos - startPos
        if delta.Magnitude > 0.1 then
            rootPart.AssemblyLinearVelocity = delta.Unit * math.min(delta.Magnitude * 20, 500)
        end

        if distToTarget < TP_ARRIVE_DIST or (os.clock() - startTime) > TP_TIMEOUT then
            arrived = true
        end
    end)

    while not arrived and (os.clock() - startTime) < TP_TIMEOUT do
        RunService.Heartbeat:Wait()
    end

    -- Cleanup
    if conn then conn:Disconnect() end
    if alignPos and alignPos.Parent then alignPos:Destroy() end
    if attachTarget and attachTarget.Parent then attachTarget:Destroy() end
    if attachRoot and attachRoot.Parent then attachRoot:Destroy() end
    if counter and counter.Parent then counter:Destroy() end

    if rootPart and rootPart.Parent then
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
    end
    if humanoid and humanoid.Parent then
        humanoid:ChangeState(Enum.HumanoidStateType.Running)
    end
end

-- Long-distance: chain hops of ≤ TP_MAX_HOP studs
local function longDistanceTeleport(targetCFrame)
    if not rootPart or not targetCFrame then return end
    local startPos = rootPart.Position
    local endPos   = targetCFrame.Position + Vector3.new(0, 3, 0)
    local totalDist = (endPos - startPos).Magnitude

    if totalDist < TP_MAX_HOP then
        absoluteTeleport(targetCFrame)
        return
    end

    local numHops = math.ceil(totalDist / TP_MAX_HOP)
    for i = 1, numHops do
        local alpha = i / numHops
        local hopPos = startPos:Lerp(endPos, alpha)
        local hopCF = CFrame.new(hopPos) * (targetCFrame - targetCFrame.Position)
        absoluteTeleport(hopCF)
        RunService.Heartbeat:Wait()
    end
end

local function getEntrySpawn()
    if entrySpawnCFrame then return entrySpawnCFrame end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") and obj.Enabled then
            entrySpawnCFrame = obj.CFrame
            return entrySpawnCFrame
        end
    end
    return rootPart and rootPart.CFrame or CFrame.new(0, 5, 0)
end

