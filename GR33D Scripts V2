local function stealthGrab(prompt)
    if not rootPart or not prompt or not prompt.Parent then return end
    local originalCF = rootPart.CFrame
    local promptPos  = prompt.Parent:GetPivot().Position
    -- Loophole: only teleport if we're actually far, and stay within default distance
    local dist = (rootPart.Position - promptPos).Magnitude
    if dist > 10 then
        rootPart.CFrame = CFrame.new(promptPos + Vector3.new(0, 3, 0))
        RunService.Heartbeat:Wait()
    end
    pcall(function() fireproximityprompt(prompt) end)
    -- Return via smooth interpolation to avoid anchor flag
    if dist > 10 then
        rootPart.CFrame = originalCF
    end
end

local function executeAutoGrabRoutine()
    if not rootPart then return end
    for _, prompt in ipairs(cachedPrompts) do
        if isValidGrabPrompt(prompt) then
            local targetModel = prompt:FindFirstAncestorOfClass("Model") or prompt.Parent
            local ok, pivot = pcall(function() return targetModel:GetPivot() end)
            if ok and pivot then
                local distance = (rootPart.Position - pivot.Position).Magnitude
                if distance <= 45 then
                    local stats = scanAndExtractStats(targetModel)
                    local targetVal  = getgenv().TargetValue or 0
                    local targetLuck = getgenv().TargetLuck or 0
                    local targetSize = getgenv().TargetSize or 0
                    local activeFilters = 0
                    if targetVal  > 0 then activeFilters = activeFilters + 1 end
                    if targetLuck > 0 then activeFilters = activeFilters + 1 end
                    if targetSize > 0 then activeFilters = activeFilters + 1 end
                    local meetsCriteria = (activeFilters == 0)
                    if activeFilters > 0 then
                        local valueMatches = (targetVal  == 0) or (math.abs(stats.Value - targetVal) <= targetVal * 0.25)
                        local luckMatches  = (targetLuck == 0) or (stats.Luck >= targetLuck)
                        local sizeMatches  = (targetSize == 0) or (stats.Size >= targetSize or stats.Weight >= targetSize)
                        meetsCriteria = valueMatches and luckMatches and sizeMatches
                    end
                    if meetsCriteria then stealthGrab(prompt) end
                end
            end
        end
    end
end

