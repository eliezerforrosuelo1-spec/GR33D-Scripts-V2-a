local LOG_FILE_NAME = "gr33d_log.txt"
local logBuffer = {}
local logStartTime = os.clock()
local MAX_LOG_LINES = 5000
local logCount = 0

local function log(category, message)
    if logCount >= MAX_LOG_LINES then return end
    logCount = logCount + 1
    local t = string.format("%.3f", os.clock() - logStartTime)
    local line = string.format("[%s][%s] %s", t, category, message)
    table.insert(logBuffer, line)
    print(line)
end

local function getLogText() return table.concat(logBuffer, "\n") end

local function saveLogToFile()
    local text = getLogText()
    if writefile then
        pcall(function()
            writefile(LOG_FILE_NAME, text)
            log("LOGGER", "Log saved to " .. LOG_FILE_NAME)
        end)
    end
    return text
end

