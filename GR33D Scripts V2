RunService.RenderStepped:Connect(function(dt)
    if not camera or not camera.Parent then camera = workspace.CurrentCamera return end

    -- God Mode: only prevent death state
    if godModeEnabled and humanoid then
        pcall(function()
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        end)
    end

    -- Flight
    if isFlying and bodyVelocity and humanoid and rootPart then
        if humanoid.FloorMaterial ~= Enum.Material.Air then
            setFlying(false)
        elseif controls then
            local moveVector = controls:GetMoveVector()
            if moveVector.Magnitude > 0 then
                local camCFrame = camera.CFrame
                local flightDir = (camCFrame.RightVector * moveVector.X) - (camCFrame.LookVector * moveVector.Z)
                bodyVelocity.Velocity = flightDir.Unit * FLY_SPEED + Vector3.new(0, -2, 0)
            else
                bodyVelocity.Velocity = Vector3.new(0, -2, 0)
            end
        end
    end

    -- Jump
    if jumpEnabled and humanoid then
        pcall(function()
            humanoid.UseJumpPower = true
            humanoid.JumpPower    = jumpPowerValue
        end)
    elseif not jumpEnabled and humanoid then
        pcall(function()
            if humanoid.JumpPower ~= defaultJumpPower then humanoid.JumpPower = defaultJumpPower end
        end)
    end

    -- Rapid Healing (2% per frame)
    if rapidHealingEnabled and humanoid and humanoid.Health < humanoid.MaxHealth and humanoid.Health > 0 then
        humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + (humanoid.MaxHealth * 0.02))
    end

    -- No Fall Damage
    if noFallDamageEnabled and rootPart and humanoid then
        if humanoid:GetState() == Enum.HumanoidStateType.Freefall
            or humanoid:GetState() == Enum.HumanoidStateType.FallingDown then
            pcall(function()
                if rootPart.AssemblyLinearVelocity.Y < -45 then
                    rootPart.AssemblyLinearVelocity = Vector3.new(rootPart.AssemblyLinearVelocity.X, 0, rootPart.AssemblyLinearVelocity.Z)
                end
            end)
        end
    end

    -- Anti-Knockback
    if antiMeleeEnabled and rootPart and humanoid then
        local currentVel = rootPart.AssemblyLinearVelocity
        if humanoid.MoveDirection.Magnitude == 0 and not isFlying and not runSpeedEnabled then
            if math.abs(currentVel.X) > 4 or math.abs(currentVel.Z) > 4 then
                rootPart.AssemblyLinearVelocity = Vector3.new(0, currentVel.Y, 0)
            end
        end
    end

    -- Hitbox Ext: size only, no CanCollide/Transparency
    if hitboxEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = p.Character.HumanoidRootPart
                if not originalHitboxSizes[hrp] then originalHitboxSizes[hrp] = hrp.Size end
                hrp.Size = Vector3.new(5, 5, 5)
            end
        end
    end

    -- Slim Hitbox
    if slimHitboxEnabled and rootPart then
        rootPart.Size = Vector3.new(1.3, 2, 0.7)
    elseif not slimHitboxEnabled and rootPart and originalRootSize and rootPart.Size ~= originalRootSize then
        rootPart.Size = originalRootSize
    end

    -- Third-Person Cam: CFrame only, no CameraType change
    if thirdPersonCamEnabled and rootPart then
        local head = character and character:FindFirstChild("Head") or rootPart        local currentCamRot = camera.CFrame.Rotation
        local focusPos = head.Position + Vector3.new(0, 1, 0)
        camera.CFrame = CFrame.new(focusPos) * currentCamRot * CFrame.new(0, 3.5, -8)
    end

    -- Aimbot: slow lerp for human-like movement
    if aimbotEnabled and rootPart then
        local nearestTarget, shortestDist = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local isTeammate = false
                if player.Team and p.Team then
                    if p.Team == player.Team or p.TeamColor == player.TeamColor then isTeammate = true end
                end
                if p:GetAttribute("Team") and player:GetAttribute("Team")
                    and p:GetAttribute("Team") == player:GetAttribute("Team") then isTeammate = true end
                if not isTeammate then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    if hrp and hum and hum.Health > 0 and not p.Character:FindFirstChildOfClass("ForceField") then
                        local dist = (hrp.Position - rootPart.Position).Magnitude
                        if dist < shortestDist then shortestDist = dist nearestTarget = hrp end
                    end
                end
            end
        end
        for _, hrp in ipairs(cachedMonsters) do
            if hrp and hrp.Parent then
                local hum = hrp.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local dist = (hrp.Position - rootPart.Position).Magnitude
                    if dist < shortestDist then shortestDist = dist nearestTarget = hrp end
                end
            end
        end
        if nearestTarget then
            local goalCFrame = CFrame.new(camera.CFrame.Position, nearestTarget.Position)
            camera.CFrame = camera.CFrame:Lerp(goalCFrame, math.clamp(dt * 8, 0.05, 0.3))
        end
    end
end)

