local BLOCKED_SYNC_KEYS = {
    "reset", "Reset", "RESET",
    "resetPosition", "ResetPosition",
    "warpToSpawn", "WarpToSpawn", "warptospawn",
    "restoreWalls", "RestoreWalls", "restorewalls",
    "restore", "Restore",
    "outOfBounds", "OutOfBounds", "outofbounds",
    "oos", "oosync",
    "syncReset", "SyncReset",
    "teleport", "Teleport",
    "kick", "Kick",
    "ban", "Ban",
    "flag", "Flag",
    "violation", "Violation",
    "restrict", "Restrict",
    "deny", "Deny",
    "invalid", "Invalid",
    "antiCheat", "AntiCheat", "anticheat",
    "acs", "acFlag", "acReset",
}

local function shouldStripKey(key)
    if type(key) ~= "string" then return false end
    for _, blocked in ipairs(BLOCKED_SYNC_KEYS) do
        if key == blocked then return true end
        if key:lower():find("reset") then return true end
        if key:lower():find("violation") then return true end
        if key:lower():find("outofbounds") then return true end
        if key:lower():find("warptospawn") then return true end
    end
    return false
end

local function sanitizeSyncPayload(value, depth)
    depth = depth or 0
    if depth > 12 then return value end
    if type(value) ~= "table" then return value end

    local cleaned = {}
    for k, v in pairs(value) do
        if shouldStripKey(k) then
            -- skip
        else
            cleaned[k] = sanitizeSyncPayload(v, depth + 1)
        end
    end
    return cleaned
end

local function sanitizeValue(v)
    if type(v) == "string" then
        local lower = v:lower()
        if lower == "reset" or lower == "violation"
           or lower == "outofbounds" or lower == "warptospawn"
           or lower == "restorewalls" then
            return nil
        end
        return v
    elseif type(v) == "table" then
        return sanitizeSyncPayload(v)
    end
    return v
end

local syncInstalled = {}
local function reinstallSyncHooks()
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") and SYNC_REMOTES[obj.Name] then
            local signal = obj.OnClientEvent
            local existingFns = {}
            local existingConns = getconnections(signal)
            for _, conn in ipairs(existingConns) do
                if conn.Function then
                    table.insert(existingFns, conn.Function)
                end
            end
            for _, conn in ipairs(existingConns) do
                pcall(function() conn:Disconnect() end)
            end
            for _, fn in ipairs(existingFns) do
                signal:Connect(function(...)
                    local args = {...}
                    for i, arg in ipairs(args) do
                        args[i] = sanitizeValue(arg)
                    end
                    local cleanArgs = {}
                    for i = 1, select("#", ...) do
                        cleanArgs[i] = args[i]
                    end
                    pcall(fn, table.unpack(cleanArgs, 1, select("#", ...)))
                end)
            end
            syncInstalled[obj] = true
            print("[GR33D] ✓ Hooked " .. obj.Name .. " (" .. #existingFns .. " handlers wrapped)")
        end
    end
end

game.DescendantAdded:Connect(function(desc)
    if desc:IsA("RemoteEvent") and SYNC_REMOTES[desc.Name] then
