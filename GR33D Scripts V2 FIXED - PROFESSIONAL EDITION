                if groundCheck then
                    local mat = groundCheck.Material
                    if mat == Enum.Material.Water then speedTarget = speedTarget * 0.5
                    elseif mat == Enum.Material.Sand or mat == Enum.Material.Grass
                        or mat == Enum.Material.Mud then speedTarget = speedTarget * 0.85 end
                    local normal = groundCheck.Normal
                    local slopeAngle = math.acos(math.clamp(normal.Y, -1, 1))
                    if slopeAngle > 0.4 then speedTarget = speedTarget * (1 - slopeAngle * 0.5) end
                end

                local time = tick()
                local variance = math.sin(time * 2.3) * 0.05 + math.sin(time * 7.1) * 0.03
                speedTarget = speedTarget * (1 + variance)

                if (time % 8) < 0.4 and moveDir.Magnitude > 0 then speedTarget = speedTarget * 0.6 end
                if CONFIG.BURST_MODE then
                    if (time % 15) < 1.5 and moveDir.Magnitude > 0 then speedTarget = speedTarget * 2 end
                end

                if moveDir.Magnitude > 0 then
                    speedRamp = math.min(1, speedRamp + RAMP_RATE * deltaTime)
                    local effectiveSpeed = speedTarget * speedRamp
                    local targetVel = moveDir * effectiveSpeed
                    local currentVel = speedVelocity.VectorVelocity
                    speedVelocity.VectorVelocity = currentVel:Lerp(targetVel, 0.25)
                    speedVelocity.MaxForce = 1e5

                    if lastSpeedCFrame then
                        local realDelta = rootPart.CFrame.Position - lastSpeedCFrame.Position
                        local expected = (moveDir * effectiveSpeed * deltaTime).Magnitude
                        if realDelta.Magnitude < expected * 0.5 then
                            local nudge = moveDir * (effectiveSpeed * deltaTime * 0.4)
                            pcall(function() rootPart.CFrame = rootPart.CFrame + nudge end)
                        end
                    end
                    lastSpeedCFrame = rootPart.CFrame
                else
                    speedRamp = math.max(0, speedRamp - RAMP_RATE * deltaTime * 2)
                    speedVelocity.VectorVelocity = speedVelocity.VectorVelocity:Lerp(Vector3.zero, 0.4)
                    if speedVelocity.VectorVelocity.Magnitude < 1 then speedVelocity.MaxForce = 0 end
                    lastSpeedCFrame = nil
                end
            end
        else
            if speedVelocity then teardownSpeedVelocity() end
            if humanoid.WalkSpeed ~= defaultWalkSpeed then
                pcall(function() humanoid.WalkSpeed = defaultWalkSpeed end)
            end
        end
    end

    if humanoid and humanoid.Health > 0 and rootPart and jumpEnabled then
        if humanoid.UseJumpPower and humanoid.JumpPower ~= defaultJumpPower then
            pcall(function() humanoid.JumpPower = defaultJumpPower end)
        end
        local currentState = humanoid:GetState()
        local airborne = (currentState == Enum.HumanoidStateType.Jumping
                          or currentState == Enum.HumanoidStateType.Freefall)
        if airborne and not jumpImpulseApplied then
            jumpImpulseApplied = true
            jumpImpulseTime = tick()
            local currentVel = rootPart.AssemblyLinearVelocity
            pcall(function()
                rootPart.AssemblyLinearVelocity = Vector3.new(
                    currentVel.X, CONFIG.jumpPowerValue, currentVel.Z)
            end)
        end
        if jumpImpulseApplied and airborne then
            local timeSinceImpulse = tick() - jumpImpulseTime
            if timeSinceImpulse < CONFIG.JUMP_BOOST_DURATION then
                local currentVel = rootPart.AssemblyLinearVelocity
                local fadeFactor = 1 - (timeSinceImpulse / CONFIG.JUMP_BOOST_DURATION)
                local targetY = currentVel.Y
                if currentVel.Y < (CONFIG.jumpPowerValue * fadeFactor * 0.7) then
                    targetY = CONFIG.jumpPowerValue * fadeFactor * 0.7
                end
                pcall(function()
                    rootPart.AssemblyLinearVelocity = Vector3.new(
                        currentVel.X, targetY, currentVel.Z)
                end)
            end
        end
        if humanoid.FloorMaterial ~= Enum.Material.Air then
            jumpImpulseApplied = false
            jumpImpulseTime = 0
        end
    end

    if rapidHealingEnabled and humanoid and humanoid.Health > 0
       and humanoid.Health < humanoid.MaxHealth then
        local healAmount = humanoid.MaxHealth * 3 * deltaTime
        humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + healAmount)
    end

    if godModeEnabled and humanoid and humanoid.Health > 0 then
        if humanoid.Health >= humanoid.MaxHealth then
            humanoid.Health = humanoid.MaxHealth - 0.15
        end
    end

    if noFallDamageEnabled and rootPart and humanoid then
        local state = humanoid:GetState()
        if state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.FallingDown then
            pcall(function()
                if rootPart.AssemblyLinearVelocity.Y < -45 then
                    rootPart.AssemblyLinearVelocity = Vector3.new(
                        rootPart.AssemblyLinearVelocity.X, 0, rootPart.AssemblyLinearVelocity.Z)
                end
            end)
        end
    end

    if hitboxEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if not originalHitboxSizes[hrp] then originalHitboxSizes[hrp] = hrp.Size end
                    hrp.Size = Vector3.new(8, 8, 8)
                    hrp.Transparency = 0.7
                    hrp.CanCollide = false
                end
            end
        end
    else
        for hrp, size in pairs(originalHitboxSizes) do
            if hrp and hrp.Parent then
                pcall(function()
                    hrp.Size = size
                    hrp.Transparency = 0
                    hrp.CanCollide = true
                end)
            end
            originalHitboxSizes[hrp] = nil
        end
    end

    if rootPart then
        if slimHitboxEnabled then
            local targetSize = Vector3.new(1.5, 2, 0.8)
            rootPart.Size = rootPart.Size:Lerp(targetSize, 0.1)
            G.SlimHitboxActive = true
        elseif originalRootSize then
            rootPart.Size = rootPart.Size:Lerp(originalRootSize, 0.1)
            G.SlimHitboxActive = false
        end
    end

    if COMBAT.AimbotEnabled and rootPart and camera then
        local target = getBulletFollowTarget(camera.CFrame.Position)
        if target then
            local targetPart = target
            if CONFIG.AIMBOT_TARGET_PART == "Head" then
                local head = target.Parent and target.Parent:FindFirstChild("Head")
                if head then targetPart = head end
            end
            local aimPos = targetPart.Position
            if CONFIG.AIMBOT_PREDICT and targetPart.AssemblyLinearVelocity then
                aimPos = aimPos + targetPart.AssemblyLinearVelocity * 0.12
            end
            local camToTarget = (aimPos - camera.CFrame.Position).Unit
            local camLook = camera.CFrame.LookVector
            local dot = camToTarget:Dot(camLook)
            local angle = math.deg(math.acos(math.clamp(dot, -1, 1)))
            if angle <= CONFIG.AIMBOT_FOV then
                local goalCFrame = CFrame.new(camera.CFrame.Position, aimPos)
                camera.CFrame = camera.CFrame:Lerp(goalCFrame, CONFIG.AIMBOT_SMOOTHNESS)
                camera.CameraType = Enum.CameraType.Scriptable
            end
        end
    elseif not COMBAT.AimbotEnabled and not COMBAT.BulletFollowEnabled then
        if camera.CameraType == Enum.CameraType.Scriptable then
            camera.CameraType = Enum.CameraType.Custom
        end
    end
end)

