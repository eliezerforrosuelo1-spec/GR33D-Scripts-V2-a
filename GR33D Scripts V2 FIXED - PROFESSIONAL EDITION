pcall(function()
    local mt = getrawmetatable and getrawmetatable(game)
    if not mt then return end
    setreadonly(mt, false)
    local oldNamecall = mt.__namecall

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()

        if CONFIG.ANTI_TRAP_ENABLED and typeof(self) == "Instance" then
            local nameLower = self.Name:lower()
            local isTrapRemote =
                nameLower:find("trap") or nameLower:find("restrict") or
                nameLower:find("outofbounds") or nameLower:find("wallcheck") or
                nameLower:find("boundary") or nameLower:find("zonecheck") or
                nameLower:find("positioncheck")

            if isTrapRemote and (method == "InvokeServer" or method == "FireServer") then
                antiTrapBlocked = antiTrapBlocked + 1
                local args = {...}
                for i, arg in ipairs(args) do
                    if typeof(arg) == "Vector3" then args[i] = Vector3.new(0, 0, 0) end
                end
                return oldNamecall(self, table.unpack(args))
            end
        end

        if CONFIG.ANTI_RAGDOLL_ENABLED and typeof(self) == "Instance" then
            local nameLower = self.Name:lower()
            local isRagdollRemote =
                nameLower:find("ragdoll") or nameLower:find("knockdown") or
                nameLower:find("stun") or nameLower:find("fall")

            if isRagdollRemote and (method == "FireClient" or method == "FireAllClients") then
                antiRagdollBlocked = antiRagdollBlocked + 1
                return nil
            end
        end

        return oldNamecall(self, ...)
    end)

    setreadonly(mt, true)
    log("[GR33D] ✓ Anti Trap + Anti Ragdoll installed")
end)

