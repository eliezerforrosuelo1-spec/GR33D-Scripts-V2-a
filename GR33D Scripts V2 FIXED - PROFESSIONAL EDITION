local function parseMoneyFromModel(model)
    if not model then return 0 end
    local best = 0
    local ok, attrs = pcall(function() return model:GetAttributes() end)
    if ok and attrs then
        for name, val in pairs(attrs) do
            local n = tostring(name):lower()
            if n:find("value") or n:find("price") or n:find("cash") or n:find("worth") then
                if type(val) == "number" and val > best then best = val
                elseif type(val) == "string" then
                    local num = tonumber((val:gsub("[^%d%.]", "")))
                    if num and num > best then best = num end
                end
            end
        end
    end
    for _, desc in ipairs(model:GetDescendants()) do
        if desc:IsA("TextLabel") then
            local parent = desc.Parent
            if parent and (parent:IsA("BillboardGui") or parent:IsA("SurfaceGui")) then
                local txt = (desc.Text or ""):upper():gsub(",", "")
                local num, suffix = txt:match("%$%s*(%d+%.?%d*)([KMBT]?)")
                if num then
                    local v = tonumber(num) or 0
                    if suffix == "K" then v = v * 1e3
                    elseif suffix == "M" then v = v * 1e6
                    elseif suffix == "B" then v = v * 1e9
                    elseif suffix == "T" then v = v * 1e12
                    end
                    if v > best then best = v end
                end
            end
        end
    end
    return best
end

local function findHighestValue()
    local highestItem, highestPrompt, highestValue = nil, nil, -1
    local highestPart = nil
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local model, prompt
        if obj:IsA("Model") then model = obj
        elseif obj:IsA("ProximityPrompt") then
            prompt = obj
            model = obj:FindFirstAncestorOfClass("Model") or obj.Parent
        end
        if model and model ~= player.Character
           and not Players:GetPlayerFromCharacter(model) then
            local nameLower = model.Name:lower()
            local isFriendly = nameLower:find("shop") or nameLower:find("npc") or
                               nameLower:find("dummy") or nameLower:find("merchant") or
                               nameLower:find("guide") or nameLower:find("bank") or
                               nameLower:find("vendor") or nameLower:find("station")
            if not isFriendly then
                local value = parseMoneyFromModel(model)
                if value > highestValue then
                    local part = model.PrimaryPart
                                 or model:FindFirstChild("HumanoidRootPart")
                                 or model:FindFirstChildWhichIsA("BasePart")
                    if part then
                        highestValue = value
                        highestItem = model
                        highestPart = part
                        highestPrompt = prompt or model:FindFirstChildWhichIsA("ProximityPrompt", true)
                    end
                end
            end
        end
    end
    return highestItem, highestPart, highestPrompt, highestValue
end

