-- ============================================================
-- ========== ANTI-KNOCKBACK DAMPENER ========================
-- ============================================================
local function runKnockbackDampener()
    if knockbackInProgress or not rootPart or not humanoid then return end
    if isFlying or runSpeedEnabled or not antiMeleeEnabled then return end

    local vel = rootPart.AssemblyLinearVelocity
    local horizontalSpeed = math.sqrt(vel.X * vel.X + vel.Z * vel.Z)
    local isSpike = horizontalSpeed > CONFIG.KNOCKBACK_THRESHOLD
                    and lastHorizontalSpeed < CONFIG.KNOCKBACK_IDLE_MAX
    local isIdle = humanoid.MoveDirection.Magnitude < 0.1

    if isIdle and isSpike then
        knockbackInProgress = true
        task.wait(CONFIG.KNOCKBACK_DELAY)
        task.spawn(function()
            for frame = 1, CONFIG.KNOCKBACK_FRAMES do
                task.wait()
                if rootPart and rootPart.Parent then
                    local v = rootPart.AssemblyLinearVelocity
                    pcall(function()
                        rootPart.AssemblyLinearVelocity = Vector3.new(
                            v.X * CONFIG.KNOCKBACK_FACTOR,
                            v.Y,
                            v.Z * CONFIG.KNOCKBACK_FACTOR
                        )
                    end)
                end
            end
            task.wait(0.2)
            knockbackInProgress = false
        end)
    end
    lastHorizontalSpeed = horizontalSpeed
end

-- ============================================================
-- ========== TRUE GHOST INVISIBILITY ========================
-- ============================================================
local function applyGhost(char)
    if not char then return end
    originalCharacterTransparencies = {}
    originalCharacterShadows        = {}
    originalCharacterParticles      = {}

    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") then
            originalCharacterTransparencies[d] = d.Transparency
            originalCharacterShadows[d]        = d.CastShadow
            d.Transparency = 1
            d.LocalTransparencyModifier = 1
            d.CastShadow = false
            pcall(function() d:SetNetworkOwner(player) end)
        elseif d:IsA("Decal") or d:IsA("Texture") or d:IsA("SurfaceAppearance") then
            originalCharacterTransparencies[d] = d.Transparency
            d.Transparency = 1
        elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") then
            originalCharacterParticles[d] = d.Enabled
            d.Enabled = false
        end
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        pcall(function() hum.NameDisplayDistance   = 0 end)
        pcall(function() hum.HealthDisplayDistance = 0 end)
    end

    if godModeConnection then godModeConnection:Disconnect() end
    godModeConnection = char.DescendantAdded:Connect(function(desc)
        if not godModeEnabled then return end
        if desc:IsA("BasePart") then
            originalCharacterTransparencies[desc] = desc.Transparency
            originalCharacterShadows[desc]        = desc.CastShadow
            desc.Transparency = 1
            desc.LocalTransparencyModifier = 1
            desc.CastShadow = false
        elseif desc:IsA("Decal") or desc:IsA("Texture") or desc:IsA("SurfaceAppearance") then
            originalCharacterTransparencies[desc] = desc.Transparency
            desc.Transparency = 1
        elseif desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Beam") then
            originalCharacterParticles[desc] = desc.Enabled
            desc.Enabled = false
        end
    end)
end

local function removeGhost(char)
    if not char then return end
    for part, transparency in pairs(originalCharacterTransparencies) do
        if part and part.Parent then
            pcall(function()
                part.Transparency = transparency
                if part:IsA("BasePart") then
                    part.LocalTransparencyModifier = 0
                    part.CastShadow = originalCharacterShadows[part] ~= false
                end
            end)
        end
    end
    for part, enabled in pairs(originalCharacterParticles) do
        if part and part.Parent then pcall(function() part.Enabled = enabled end) end
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function()
            hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
            hum.NameDisplayDistance   = 100
            hum.HealthDisplayDistance = 100
        end)
    end
    originalCharacterTransparencies = {}
    originalCharacterShadows        = {}
    originalCharacterParticles      = {}
    if godModeConnection then godModeConnection:Disconnect() godModeConnection = nil end
end

function makeInvisible(char) applyGhost(char) end
function makeVisible(char)   removeGhost(char) end

