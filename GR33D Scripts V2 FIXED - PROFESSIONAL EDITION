    local item, part, prompt, value = findHighestValue()
    if not item or not part then warn("⚠️ No value item"); return end
    print(string.format("✓ Target: %s ($%s)", item.Name, tostring(value)))

    local actualPrompt = part:FindFirstChildWhichIsA("ProximityPrompt", true)
                      or item:FindFirstChildWhichIsA("ProximityPrompt", true)
                      or prompt

    local targetPos = CFrame.new(part.Position + Vector3.new(0, 3, 0))

    isTeleporting = true
    if not smartMove(targetPos) then
        warn("⚠️ Failed to move to target")
        isTeleporting = false
        return
    end
    print("✓ Arrived at target")

    local anchoredParts = {}
    for _, p in ipairs(character:GetDescendants()) do
        if p:IsA("BasePart") then
            anchoredParts[p] = p.Anchored
            p.Anchored = true
        end
    end

    local grabStart = tick()
    local firesSent = 0

    while tick() - grabStart < CONFIG.GRAB_HOLD_DURATION do
        if rootPart and rootPart.Parent then
            pcall(function()
                rootPart.CFrame = targetPos
                rootPart.AssemblyLinearVelocity = Vector3.zero
                rootPart.AssemblyAngularVelocity = Vector3.zero
            end)
        end
        if actualPrompt and actualPrompt.Parent then
            pcall(function()
                fireproximityprompt(actualPrompt)
                firesSent = firesSent + 1
            end)
        end
        if firetouchinterest and rootPart and part then
