-- ========== FLIGHT SYSTEM ==========
function setFlying(state)
    if not rootPart or not humanoid or not linearVelocity then return end
    isFlying = state

    if isFlying then
        linearVelocity.MaxForce = 100000
        humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
    else
        linearVelocity.MaxForce = 0
        linearVelocity.VectorVelocity = Vector3.zero

        if humanoid.FloorMaterial ~= Enum.Material.Air then
            humanoid:ChangeState(Enum.HumanoidStateType.Running)
        end
    end
end

local function handleJumpTap()
    if not flyToggleEnabled then return end
    local currentTime = os.clock()
    local timeSinceLastTap = currentTime - lastJumpTapTime

    if timeSinceLastTap <= DOUBLE_TAP_WINDOW then
        if isFlying then
            setFlying(false)
        elseif humanoid and (humanoid:GetState() == Enum.HumanoidStateType.Freefall
                             or humanoid:GetState() == Enum.HumanoidStateType.Jumping) then
            setFlying(true)
        end
        lastJumpTapTime = 0
    else
        lastJumpTapTime = currentTime
    end
end

UserInputService.JumpRequest:Connect(function()
    local currentTime = os.clock()
    if (currentTime - lastJumpReqTime) > 0.1 then
        handleJumpTap()
    end
    lastJumpReqTime = currentTime
end)

-- ========== NOCLIP ==========
function enableNoclip(char)
    if not char then return end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if originalCollisionStates[part] == nil then
                originalCollisionStates[part] = part.CanCollide
            end
            part.CanCollide = false
        end
    end

    if not noclipAddedConnections[char] then
        noclipAddedConnections[char] = char.DescendantAdded:Connect(function(desc)
            if desc:IsA("BasePart") and G.NoclipActive then
                originalCollisionStates[desc] = desc.CanCollide
                desc.CanCollide = false
            end
        end)
    end
end

function disableNoclip(char)
    if not char then return end

    for part, state in pairs(originalCollisionStates) do
        if part and part.Parent and part:IsDescendantOf(char) then
            pcall(function() part.CanCollide = state end)
            originalCollisionStates[part] = nil
        end
    end

    if noclipAddedConnections[char] then
        noclipAddedConnections[char]:Disconnect()
        noclipAddedConnections[char] = nil
    end
end

-- ========== GOD MODE (INVISIBILITY) ==========
function makeInvisible(char)
    if not char then return end

    originalCharacterTransparencies = {}

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            originalCharacterTransparencies[part] = part.Transparency
            part.Transparency = 1
        elseif part:IsA("Decal") or part:IsA("Texture") then
            originalCharacterTransparencies[part] = part.Transparency
            part.Transparency = 1
        end
    end

    if godModeConnection then
        godModeConnection:Disconnect()
        godModeConnection = nil
    end

    godModeConnection = char.DescendantAdded:Connect(function(desc)
        if godModeEnabled then
            if desc:IsA("BasePart") then
                originalCharacterTransparencies[desc] = desc.Transparency
                desc.Transparency = 1
            elseif desc:IsA("Decal") or desc:IsA("Texture") then
                originalCharacterTransparencies[desc] = desc.Transparency
                desc.Transparency = 1
            end
        end
    end)
end

function makeVisible(char)
    if not char then return end

    for part, transparency in pairs(originalCharacterTransparencies) do
        if part and part.Parent then
            pcall(function()
                part.Transparency = transparency
            end)
        end
    end

    originalCharacterTransparencies = {}

    if godModeConnection then
        godModeConnection:Disconnect()
        godModeConnection = nil
    end
end

function setupGodMode(char)
