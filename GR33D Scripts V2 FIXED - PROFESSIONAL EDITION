local function getBulletFollowTarget(pos)
    if not pos then pos = camera.CFrame.Position end
    local bestTarget, bestDist = nil, BULLET_FOLLOW_RANGE
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local isTeammate = false
            if player.Team and p.Team and (p.Team == player.Team or p.TeamColor == player.TeamColor) then
                isTeammate = true
            end
            if p:GetAttribute("Team") and player:GetAttribute("Team")
               and p:GetAttribute("Team") == player:GetAttribute("Team") then
                isTeammate = true
            end
            if not isTeammate then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0
                   and not p.Character:FindFirstChildOfClass("ForceField") then
                    local dist = (hrp.Position - pos).Magnitude
                    if dist < bestDist then bestDist = dist bestTarget = hrp end
                end
            end
        end
    end
    for _, hrp in ipairs(cachedMonsters) do
        if hrp and hrp.Parent then
            local hum = hrp.Parent:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local dist = (hrp.Position - pos).Magnitude
                if dist < bestDist then bestDist = dist bestTarget = hrp end
            end
        end
    end
    return bestTarget, bestDist
end

local function findAndReplaceDir(value, newDir)
    if typeof(value) == "Vector3" then
        local mag = value.Magnitude
        if mag > 0.3 and mag < 5 then return newDir.Unit, true end
        return value, false
    elseif typeof(value) == "CFrame" then
        local pos = value.Position
        return CFrame.new(pos, pos + newDir.Unit), true
    elseif type(value) == "table" then
        for k, v in pairs(value) do
            local newV, changed = findAndReplaceDir(v, newDir)
            if changed then value[k] = newV return value, true end
        end
    end
    return value, false
end

local function tryRedirectFireArgs(args)
    if not COMBAT.BulletFollowEnabled then return nil end
    if not args or #args == 0 then return nil end
    local origin = (rootPart and rootPart.Position) or camera.CFrame.Position
    local targetPart = getBulletFollowTarget(origin)
    if not targetPart then return nil end
    local aimPoint = targetPart.Position + Vector3.new(0, 1, 0)
    local head = targetPart.Parent and targetPart.Parent:FindFirstChild("Head")
    if head then aimPoint = head.Position end
    local newDir = aimPoint - origin
    local function deepCopy(t)
        if type(t) ~= "table" then return t end
        local c = {}
        for k, v in pairs(t) do c[k] = deepCopy(v) end
        return c
    end
    local newArgs = {}
    for i = 1, #args do newArgs[i] = deepCopy(args[i]) end
    for i, arg in ipairs(newArgs) do
        local newVal, changed = findAndReplaceDir(arg, newDir)
        if changed then newArgs[i] = newVal return newArgs, targetPart end
    end
    return nil
end

