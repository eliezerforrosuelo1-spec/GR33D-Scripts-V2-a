-- ========== RAPID FIRE ==========
local COOLDOWN_KEYWORDS = {
    "cooldown", "delay", "fire", "rate", "speed", "mine", "dig",
    "swing", "hit", "reload", "firedelay"
}

local function applyRapidFire(tool)
    for _, v in ipairs(tool:GetDescendants()) do
        if v:IsA("NumberValue") or v:IsA("IntValue") then
            local n = v.Name:lower()
            local isCooldown = false
            for _, keyword in ipairs(COOLDOWN_KEYWORDS) do
                if n:find(keyword, 1, true) then
                    isCooldown = true
                    break
                end
            end

            if isCooldown then
                if originalToolValues[v] == nil then
                    originalToolValues[v] = v.Value
                end
                v.Value = math.max(0.01, originalToolValues[v] / 10)
            end
        end
    end
end

local function disableRapidFire(tool)
    for _, v in ipairs(tool:GetDescendants()) do
        if originalToolValues[v] ~= nil then
            pcall(function() v.Value = originalToolValues[v] end)
            originalToolValues[v] = nil
        end
    end
end

function monitorTool(tool)
    if not tool or not tool:IsA("Tool") then return end

    if rapidFireEnabled then
        applyRapidFire(tool)
    else
        disableRapidFire(tool)
    end

    if toolConnections[tool] then
        toolConnections[tool]:Disconnect()
        toolConnections[tool] = nil
    end

    toolConnections[tool] = tool.DescendantAdded:Connect(function(v)
        if rapidFireEnabled and (v:IsA("NumberValue") or v:IsA("IntValue")) then
            applyRapidFire(tool)
        end
    end)
end

-- ==========================================
-- ========== AUTO BULLET FOLLOW ============
-- ==========================================
-- How it works:
-- 1) We hook the game's metatable __namecall to intercept FireServer / InvokeServer.
-- 2) When the player fires a weapon (any remote that carries a position/direction,
--    or when a projectile part is created), we acquire the nearest enemy and
--    re-aim the shot at them.
-- 3) We also hook projectile creation (Instance.new on Workspace) to steer
--    physical bullets toward the nearest enemy mid-flight.
--
-- This works for both hitscan and projectile weapons in most Roblox games.
-- ==========================================

-- Track active projectiles we've spawned/steered
local trackedProjectiles = {}

-- Acquire target and return the direction from origin to target
local function getBulletFollowDirection(originPos)
    local targetPart = getBulletFollowTarget(originPos)
    if not targetPart then return nil end
    return (targetPart.Position - originPos).Unit, targetPart
end

-- Try to redirect common "fire" remote arguments.
-- Many Roblox shooters pass: FireServer(direction, origin, ...) or FireServer(origin, direction)
-- We detect vector-like args and replace the direction/position with our target's.
local function tryRedirectFireArgs(args, originPos)
    if not bulletFollowEnabled then return args end

    local targetPart = getBulletFollowTarget(originPos or (rootPart and rootPart.Position) or camera.CFrame.Position)
    if not targetPart then return args end

    local origin = originPos or (rootPart and rootPart.Position) or camera.CFrame.Position
    local newDir = (targetPart.Position - origin)

    -- Copy args into a mutable table (namecall passes varargs)
    local newArgs = { ... }

    -- Heuristic: find first Vector3 argument that looks like a direction (unit-ish length)
    -- and second that looks like origin, or vice versa. Replace direction.
    for i, arg in ipairs(newArgs) do
        if typeof(arg) == "Vector3" then
            local mag = arg.Magnitude
            -- direction vectors are typically ~1 in magnitude
            if mag > 0.5 and mag < 2.5 then
                newArgs[i] = newDir.Unit
                return newArgs, targetPart
            end
            -- origin vectors are far from target; if we find two vectors, the second is usually dir
        end
    end

    -- Fallback: if we found at least one Vector3 that's clearly an origin (magnitude > 5),
    -- inject direction right after it.
    for i, arg in ipairs(newArgs) do
        if typeof(arg) == "Vector3" and arg.Magnitude > 5 then
            table.insert(newArgs, i + 1, newDir.Unit)
            return newArgs, targetPart
        end
    end

    return args
end

-- Hook projectile creation: when a new BasePart with Velocity/AssemblyLinearVelocity
-- appears in Workspace, steer it toward the nearest enemy.
local function shouldTrackProjectile(part)
    if not part or not part:IsA("BasePart") then return false end
    if part:IsDescendantOf(character) then return false end
    -- Must be a small, fast part — typical bullet
    local size = part.Size.Magnitude
    if size > 4 then return false end
    return true
end

local function steerProjectile(part)
    if not trackedProjectiles[part] then
        trackedProjectiles[part] = true

        -- Steer over a short window
        local elapsed = 0
        local conn
        conn = RunService.Heartbeat:Connect(function(dt)
            elapsed = elapsed + dt
            if not part or not part.Parent or elapsed > 2 then
                if conn then conn:Disconnect() end
                trackedProjectiles[part] = nil
                return
            end

            if not bulletFollowEnabled then return end

            local targetPart = getBulletFollowTarget(part.Position)
            if not targetPart then return end

            local toTarget = (targetPart.Position - part.Position)
            if toTarget.Magnitude < 0.1 then return end

            local speed = part.AssemblyLinearVelocity.Magnitude
            if speed < 1 then return end

            -- Redirect velocity toward target, preserving speed
            pcall(function()
                part.AssemblyLinearVelocity = toTarget.Unit * speed
                part.CFrame = CFrame.new(part.Position, part.Position + toTarget.Unit)
            end)
        end)
    end
end

-- Watch Workspace for new projectiles
local projectileWatcher = Workspace.DescendantAdded:Connect(function(desc)
    if not bulletFollowEnabled then return end
    if shouldTrackProjectile(desc) then
        -- Small delay so the game can set initial velocity
        task.delay(0.02, function()
            if desc and desc.Parent and bulletFollowEnabled then
                steerProjectile(desc)
            end
        end)
    end
end)

-- Hook namecall to intercept FireServer / InvokeServer for hitscan weapons
pcall(function()
    local mt = getrawmetatable and getrawmetatable(game)
    if mt then
        local oldNamecall = mt.__namecall
        setreadonly(mt, false)

        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()

            -- Only intercept firing remotes
            if bulletFollowEnabled
               and (method == "FireServer" or method == "InvokeServer")
               and typeof(self) == "Instance" then

                local nameLower = self.Name:lower()
                local isFireRemote = nameLower:find("fire")
                                     or nameLower:find("shoot")
                                     or nameLower:find("attack")
                                     or nameLower:find("hit")
                                     or nameLower:find("damage")
                                     or nameLower:find("cast")
                                     or nameLower:find("projectile")
                                     or nameLower:find("bullet")
                                     or nameLower:find("weapon")

                if isFireRemote then
                    local args = { ... }
                    local newArgs, targetPart = tryRedirectFireArgs(args)
                    if newArgs and targetPart then
                        return oldNamecall(self, table.unpack(newArgs))
                    end
                end
            end

            return oldNamecall(self, ...)
        end)

        setreadonly(mt, true)
        print("✓ Bullet Follow namecall hook installed")
    end
end)

-- ========== CHARACTER SETUP ==========
local function setupCharacter(char)
    character = char
    rootPart  = char:WaitForChild("HumanoidRootPart")
    humanoid  = char:WaitForChild("Humanoid")
    rootPart.Anchored = false

    if humanoid then
        defaultJumpPower = humanoid.JumpPower > 0 and humanoid.JumpPower or 50
        defaultWalkSpeed = humanoid.WalkSpeed > 0 and humanoid.WalkSpeed or 16
    end

    if rootPart:FindFirstChild("FlightAttachment") then rootPart.FlightAttachment:Destroy() end
    if rootPart:FindFirstChild("FlightVelocity") then rootPart.FlightVelocity:Destroy() end

    attachment = Instance.new("Attachment")
    attachment.Name   = "FlightAttachment"
    attachment.Parent = rootPart

    linearVelocity = Instance.new("LinearVelocity")
    linearVelocity.Name         = "FlightVelocity"
    linearVelocity.Attachment0  = attachment
    linearVelocity.RelativeTo   = Enum.ActuatorRelativeTo.World
    linearVelocity.MaxForce     = 0
    linearVelocity.VectorVelocity = Vector3.zero
    linearVelocity.Parent       = rootPart

    char.ChildAdded:Connect(function(child)
        monitorTool(child)
    end)
    for _, child in ipairs(char:GetChildren()) do
        monitorTool(child)
    end

    humanoid.Jumping:Connect(function(isActive)
        if jumpEnabled and isActive and rootPart and humanoid.FloorMaterial ~= Enum.Material.Air then
            local currentVel = rootPart.AssemblyLinearVelocity
            rootPart.AssemblyLinearVelocity = Vector3.new(currentVel.X, jumpPowerValue, currentVel.Z)
        end
    end)

    task.defer(function()
        if rootPart then
            pristineRootSize = Vector3.new(2, 2, 1)
            originalRootSize = pristineRootSize
        end
        if megaHealthEnabled and humanoid then
            humanoid.MaxHealth = 900000000
            humanoid.Health    = 900000000
        end
    end)

    task.delay(0.8, function()
        if rootPart then InitialSpawnCFrame = rootPart.CFrame end
    end)

    if godModeEnabled then
        setupGodMode(char)
    end

    if G.NoclipActive then
        enableNoclip(char)
    end

    if flyToggleEnabled then setFlying(true) end
end

