    if not highestItem then return end

    local targetPart
    if highestItem:IsA("Model") then
        targetPart = highestItem.PrimaryPart
                     or highestItem:FindFirstChild("HumanoidRootPart")
                     or highestItem:FindFirstChildWhichIsA("BasePart")
    else
        targetPart = highestItem
    end
    if not targetPart then return end

    local destinationCFrame
    if targetPart:IsA("BasePart") then
        destinationCFrame = targetPart.CFrame
    else
        local ok, pivot = pcall(function() return highestItem:GetPivot() end)
        if not ok then return end
        destinationCFrame = pivot
    end

    local function smoothTeleport(destCFrame)
        rootPart.AssemblyLinearVelocity  = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero

        local tweenInfo = TweenInfo.new(0.05, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
        local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = destCFrame})

        rootPart.Anchored = true
        tween:Play()

        local done = false
        local conn
        conn = tween.Completed:Connect(function() done = true end)
        local start = os.clock()
        while not done and (os.clock() - start) < 0.5 do
            task.wait()
        end
        if conn then conn:Disconnect() end

        rootPart.Anchored = false
        rootPart.AssemblyLinearVelocity  = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
    end

    pcall(smoothTeleport, destinationCFrame + Vector3.new(0, 3, 0))

    task.wait(0.05)
    if highestPrompt then
        pcall(function() fireproximityprompt(highestPrompt) end)
    end

    if highestItem:IsA("Model") then
        for _, part in ipairs(highestItem:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function()
                    firetouchinterest(rootPart, part, 0)
                    firetouchinterest(rootPart, part, 1)
                end)
            end
        end
    elseif highestItem:IsA("BasePart") then
        pcall(function()
            firetouchinterest(rootPart, highestItem, 0)
            firetouchinterest(rootPart, highestItem, 1)
        end)
    end

    if InitialSpawnCFrame then
        pcall(smoothTeleport, InitialSpawnCFrame)
    end
end

