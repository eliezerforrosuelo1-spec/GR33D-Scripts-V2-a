function setFlying(state)
    if not rootPart or not humanoid then return end
    if not state then flyDebounceUntil = tick() + CONFIG.FLY_DEBOUNCE end
    isFlying = state
    if not flyVelocity and rootPart then
        local att = Instance.new("Attachment")
        att.Name = "Gr33dFlightAtt"
        att.Parent = rootPart
        flyVelocity = Instance.new("LinearVelocity")
        flyVelocity.Name = "Gr33dFlightVel"
        flyVelocity.Attachment0 = att
        flyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
        flyVelocity.VectorVelocity = Vector3.zero
        flyVelocity.MaxForce = 0
        flyVelocity.Parent = rootPart
    end
    if isFlying then
        flyVelocity.MaxForce = 9e4
        if humanoid.FloorMaterial == Enum.Material.Air then
            humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
        end
    else
        flyVelocity.MaxForce = 0
        flyVelocity.VectorVelocity = Vector3.zero
        if humanoid.FloorMaterial ~= Enum.Material.Air then
            pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Running) end)
        end
    end
end

local function handleJumpTap()
    if not flyToggleEnabled then return end
    if tick() < flyDebounceUntil then
        lastJumpTapTime = 0
        return
    end
    local currentTime = tick()
    local timeSinceLastTap = currentTime - lastJumpTapTime
    if timeSinceLastTap <= CONFIG.DOUBLE_TAP_WINDOW then
        if isFlying then
            setFlying(false)
        else
            if humanoid and not isGrounded() then
                local state = humanoid:GetState()
                if state == Enum.HumanoidStateType.Freefall
                   or state == Enum.HumanoidStateType.Jumping then
                    setFlying(true)
                end
            end
        end
        lastJumpTapTime = 0
    else
        lastJumpTapTime = currentTime
    end
end

UserInputService.JumpRequest:Connect(function()
    local currentTime = tick()
    if (currentTime - lastJumpReqTime) > 0.1 then handleJumpTap() end
    lastJumpReqTime = currentTime
end)

