-- ========== DRAG SYSTEM ==========
local dragging = false
local dragTouch = nil
local dragOffset = nil

topBar.InputBegan:Connect(function(input)
    local isMouse = input.UserInputType == Enum.UserInputType.MouseButton1
    local isTouch = input.UserInputType == Enum.UserInputType.Touch
    if not (isMouse or isTouch) then return end
    dragging = true
    local touchPos = input.Position
    local framePos = mainFrame.AbsolutePosition
    dragOffset = Vector2.new(touchPos.X - framePos.X, touchPos.Y - framePos.Y)
    if isTouch then dragTouch = input else dragTouch = nil end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    local isMouseMove = input.UserInputType == Enum.UserInputType.MouseMovement
    local isTouchMove = input.UserInputType == Enum.UserInputType.Touch
    if not (isMouseMove or isTouchMove) then return end
    if isTouchMove and dragTouch and input ~= dragTouch then
        local dx = math.abs(input.Position.X - dragTouch.Position.X)
        local dy = math.abs(input.Position.Y - dragTouch.Position.Y)
        if dx > 50 or dy > 50 then return end
    end
    if not dragOffset then return end
    local newX = input.Position.X - dragOffset.X
    local newY = input.Position.Y - dragOffset.Y
    local vp = workspace.CurrentCamera.ViewportSize
    newX = math.clamp(newX, -mainFrame.AbsoluteSize.X + 40, vp.X - 40)
    newY = math.clamp(newY, 0, vp.Y - 40)
    mainFrame.Position = UDim2.new(0, newX, 0, newY)
end)

UserInputService.InputEnded:Connect(function(input)
    local isMouseEnd = input.UserInputType == Enum.UserInputType.MouseButton1
    local isTouchEnd = input.UserInputType == Enum.UserInputType.Touch
    if not (isMouseEnd or isTouchEnd) then return end
    if isTouchEnd and dragTouch and input ~= dragTouch then return end
    dragging = false
    dragTouch = nil
    dragOffset = nil
end)

pcall(function()
    UserInputService.TouchEnded:Connect(function(touch, _)
        if dragTouch and touch == dragTouch then
            dragging = false
            dragTouch = nil
            dragOffset = nil
        end
    end)
end)

