local trackedProjectiles = {}

local function shouldTrackProjectile(part)
    if not part or not part:IsA("BasePart") then return false end
    if character and part:IsDescendantOf(character) then return false end
    if part.Size.Magnitude > 8 then return false end
    return true
end

task.spawn(function()
    while true do
        RunService.Heartbeat:Wait()
        if not COMBAT.BulletFollowEnabled then
            if next(trackedProjectiles) then trackedProjectiles = {} end
        else
            local now = os.clock()
            for part, info in pairs(trackedProjectiles) do
                if not part or not part.Parent then
                    trackedProjectiles[part] = nil
                elseif (now - info.spawnTime) > info.maxAge then
                    trackedProjectiles[part] = nil
                else
                    local targetPart = getBulletFollowTarget(part.Position)
                    if targetPart then
                        local toTarget = targetPart.Position - part.Position
                        if toTarget.Magnitude > 0.5 then
                            local speed = part.AssemblyLinearVelocity.Magnitude
                            if speed < 5 then speed = 100 end
                            pcall(function()
                                part.AssemblyLinearVelocity = toTarget.Unit * speed
                                part.CFrame = CFrame.new(part.Position, part.Position + toTarget.Unit)
                            end)
                        end
                    end
                end
            end
        end
    end
end)

Workspace.DescendantAdded:Connect(function(desc)
    if not COMBAT.BulletFollowEnabled then return end
    if shouldTrackProjectile(desc) then
        if not trackedProjectiles[desc] then
            trackedProjectiles[desc] = { spawnTime = os.clock(), maxAge = 5 }
        end
    end
end)

