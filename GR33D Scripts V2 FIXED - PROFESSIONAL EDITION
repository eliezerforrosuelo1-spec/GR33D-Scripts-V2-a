-- ========== PRO TELEPORT ===================================
-- ============================================================
local function proZoneTeleport(targetCFrame)
    if isTeleporting then return false end
    if not character or not rootPart or not humanoid then return false end
    isTeleporting = true
    pcall(function()
        humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
    end)
    local oldFF = character:FindFirstChildOfClass("ForceField")
    local tempFF
    if not oldFF then
        tempFF = Instance.new("ForceField")
        tempFF.Visible = false
        tempFF.Parent = character
    end
    local originalCollide = {}
    for _, p in ipairs(character:GetDescendants()) do
        if p:IsA("BasePart") then
            originalCollide[p] = p.CanCollide
            p.CanCollide = false
        end
    end
    local anchoredParts = {}
    for _, p in ipairs(character:GetDescendants()) do
        if p:IsA("BasePart") then
            anchoredParts[p] = p.Anchored
            p.Anchored = true
        end
    end
    rootPart.AssemblyLinearVelocity  = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
    local startCFrame = rootPart.CFrame
    for i = 1, CONFIG.TP_CHUNKS do
        local alpha = i / CONFIG.TP_CHUNKS
        local base = startCFrame:Lerp(targetCFrame, alpha)
        local j = CONFIG.TP_JITTER
        local jittered = base + Vector3.new(
            (math.random() * 2 - 1) * j * (1 - alpha),
            (math.random() * 2 - 1) * j * (1 - alpha),
            (math.random() * 2 - 1) * j * (1 - alpha)
        )
        pcall(function() rootPart.CFrame = jittered end)
        if i < CONFIG.TP_CHUNKS then
            pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Running) end)
            task.wait(CONFIG.TP_CHUNK_DELAY)
        end
    end
    pcall(function() rootPart.CFrame = targetCFrame end)
    for part, wasAnchored in pairs(anchoredParts) do
        if part and part.Parent then
            pcall(function() part.Anchored = wasAnchored end)
        end
    end
    local holdEnd = tick() + CONFIG.TP_HOLD_DURATION
    while tick() < holdEnd do
        if rootPart and rootPart.Parent then
            pcall(function()
                rootPart.CFrame = targetCFrame
                rootPart.AssemblyLinearVelocity  = Vector3.zero
                rootPart.AssemblyAngularVelocity = Vector3.zero
            end)
            pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Running) end)
        else break end
        RunService.Heartbeat:Wait()
    end
    task.wait(CONFIG.TP_NOCLIP_LINGER)
    for part, origCollide in pairs(originalCollide) do
        if part and part.Parent then
            pcall(function() part.CanCollide = origCollide end)
        end
    end
    pcall(function()
        humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
    end)
    if tempFF then
        task.delay(CONFIG.TP_FF_LINGER + 0.5, function()
            if tempFF and tempFF.Parent then tempFF:Destroy() end
        end)
    end
    isTeleporting = false
    return true
end

local function smartMove(targetCFrame)
    if CONFIG.USE_FAST_TELEPORT then
        return proZoneTeleport(targetCFrame)
    else
        return travelTween(targetCFrame)
    end
end

