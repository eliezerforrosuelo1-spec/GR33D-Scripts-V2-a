local grabRemotes = {}
task.spawn(function()
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local n = obj.Name:lower()
            if n:find("grab") or n:find("pickup") or n:find("collect")
               or n:find("steal") or n:find("take") then
                grabRemotes[obj] = true
            end
        end
    end
end)

local function serverSideGrab(prompt)
    if not prompt or not prompt.Parent then return false end
    local itemModel = prompt:FindFirstAncestorOfClass("Model") or prompt.Parent
    if not itemModel then return false end

    local success = pcall(function() fireproximityprompt(prompt) end)

    for remote in pairs(grabRemotes) do
        if remote and remote.Parent then
            pcall(function() remote:FireServer(itemModel) end)
            pcall(function() remote:FireServer(prompt) end)
            pcall(function() remote:FireServer(itemModel.Name) end)
        end
    end

    if firetouchinterest and rootPart then
        local targetPart = itemModel.PrimaryPart
                          or itemModel:FindFirstChildWhichIsA("BasePart")
        if targetPart then
            pcall(function()
                firetouchinterest(rootPart, targetPart, 0)
                firetouchinterest(rootPart, targetPart, 1)
            end)
        end
    end

    return success
end

local function findHighestValueItem()
    local highest, highestValue, highestPrompt = nil, -1, nil
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local nameLower = obj.Name:lower()
            local isFriendly = nameLower:find("shop") or nameLower:find("npc") or
                               nameLower:find("dummy") or nameLower:find("merchant") or
                               nameLower:find("guide") or nameLower:find("bank") or
                               nameLower:find("vendor") or nameLower:find("station")
            if not isFriendly then
                local value = 0
                local ok, attrs = pcall(function() return obj:GetAttributes() end)
                if ok and attrs then
                    for an, av in pairs(attrs) do
                        local al = tostring(an):lower()
                        if al:find("value") or al:find("price") or al:find("cash") then
                            if type(av) == "number" and av > value then value = av end
                        end
                    end
                end
                for _, d in ipairs(obj:GetDescendants()) do
                    if d:IsA("TextLabel") then
                        local p = d.Parent
                        if p and (p:IsA("BillboardGui") or p:IsA("SurfaceGui")) then
                            local txt = (d.Text or ""):upper():gsub(",", "")
                            local num, suffix = txt:match("%$%s*(%d+%.?%d*)([KMBT]?)")
                            if num then
                                local v = tonumber(num) or 0
                                if suffix == "K" then v = v * 1e3
                                elseif suffix == "M" then v = v * 1e6
                                elseif suffix == "B" then v = v * 1e9
                                elseif suffix == "T" then v = v * 1e12
                                end
                                if v > value then value = v end
                            end
                        end
                    end
                end
                if value > highestValue then
                    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt then
                        highestValue, highest, highestPrompt = value, obj, prompt
                    end
                end
            end
        end
    end
    return highest, highestPrompt, highestValue
end

G.StealHighestValue = function()
    log("🔍 Finding highest value...")
    local item, prompt, value = findHighestValueItem()
    if not item or not prompt then warnlog("⚠️ No value item found") return false end
    log(string.format("✓ Target: %s ($%s)", item.Name, tostring(value)))
    return serverSideGrab(prompt)
end

-- ============================================================
-- ========== TP ENGINE (KICK-SAFE) ==========================
-- ============================================================
-- Two-tier teleport:
--   TIER 1 (stealthTeleport) — uses HumanoidStateType.Physics +
--           Heartbeat-synced writes + velocity zeroing. Best for
--           avoiding "network connection lost" kicks.
--   TIER 2 (safeTeleport)    — legacy tween + anchor + re-assert.
--           Used as fallback if tier 1 fails.
-- ============================================================

local function stealthTeleport(targetCFrame)
    if not character or not rootPart or not humanoid or not targetCFrame then
        return false
    end

    local ok = pcall(function()
        -- 1. Freeze physics so the server sees us as stationary
        humanoid:ChangeState(Enum.HumanoidStateType.Physics)

        -- 2. Kill all momentum
        rootPart.AssemblyLinearVelocity  = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero

        -- 3. Let server register "stationary" state
        for _ = 1, CONFIG.TP_SETTLE_FRAMES do
            RunService.Heartbeat:Wait()
        end

        -- 4. Write the new CFrame, then hold it for several frames
        --    so the server acknowledges the position update.
        for _ = 1, CONFIG.TP_REASSERT_FRAMES do
            if rootPart and rootPart.Parent then
                rootPart.CFrame = targetCFrame
                rootPart.AssemblyLinearVelocity  = Vector3.zero
                rootPart.AssemblyAngularVelocity = Vector3.zero
            end
            RunService.Heartbeat:Wait()
        end

        -- 5. Release physics control back to the humanoid
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end)

    return ok
end

local function safeTeleport(targetCFrame)
    if not character or not rootPart or not humanoid or not targetCFrame then return false end

    -- TIER 1: try kick-safe method first
    local tier1 = stealthTeleport(targetCFrame)
    if tier1 then
        -- Verify we actually landed near the target
        task.wait(0.05)
        if rootPart and rootPart.Parent then
            local dist = (rootPart.Position - targetCFrame.Position).Magnitude
            if dist < 15 then
                tpKickAvoided = tpKickAvoided + 1
                return true
            end
        end
    end

    -- TIER 2: legacy tween fallback
    pcall(function()
        rootPart.AssemblyLinearVelocity  = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero

        local originalCollide = {}
        for _, p in ipairs(character:GetDescendants()) do
            if p:IsA("BasePart") then
                originalCollide[p] = p.CanCollide
                p.CanCollide = false
            end
        end

        local anchoredParts = {}
        for _, p in ipairs(character:GetDescendants()) do
            if p:IsA("BasePart") then
                anchoredParts[p] = p.Anchored
                p.Anchored = true
            end
        end

        local oldFF = character:FindFirstChildOfClass("ForceField")
        local tempFF
        if not oldFF then
            tempFF = Instance.new("ForceField")
            tempFF.Visible = false
            tempFF.Parent = character
        end

        local dur = CONFIG.TP_TWEEN_DURATION * (0.85 + math.random() * 0.3)
        local info = TweenInfo.new(dur, Enum.EasingStyle.Linear)
        local tween = TweenService:Create(rootPart, info, {CFrame = targetCFrame})
        tween:Play()

        local done = false
        local conn = tween.Completed:Connect(function() done = true end)
        local startTime = tick()
        while not done and (tick() - startTime) < (dur + 1) do RunService.Heartbeat:Wait() end
        if conn then conn:Disconnect() end

        -- Re-assert position for a few frames to fight server rubber-banding
        for _ = 1, CONFIG.TP_REASSERT_FRAMES do
            RunService.Heartbeat:Wait()
            if rootPart and rootPart.Parent then
                pcall(function() rootPart.CFrame = targetCFrame end)
                pcall(function()
                    rootPart.AssemblyLinearVelocity  = Vector3.zero
                    rootPart.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        end

        for p, a in pairs(anchoredParts) do
            if p and p.Parent then pcall(function() p.Anchored = a end) end
        end

        task.wait(CONFIG.TP_NOCLIP_LINGER * (0.8 + math.random() * 0.4))
        for p, c in pairs(originalCollide) do
            if p and p.Parent then pcall(function() p.CanCollide = c end) end
        end

        rootPart.AssemblyLinearVelocity  = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero

        if tempFF then
            task.delay(0.3, function()
                if tempFF and tempFF.Parent then tempFF:Destroy() end
            end)
        end
    end)

    return true
end

