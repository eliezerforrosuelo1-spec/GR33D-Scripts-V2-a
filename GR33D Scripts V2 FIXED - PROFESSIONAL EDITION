			-- FIX: Set to fully invisible (1.0)
			part.Transparency = 1
			
			-- FIX: Disable rendering hints
			pcall(function()
				if part:IsA("MeshPart") then
					part.TextureID = ""
				end
			end)
		elseif part:IsA("Decal") or part:IsA("Texture") then
			originalCharacterTransparencies[part] = part.Transparency
			part.Transparency = 1
		end
	end
	
	-- FIX: Track new parts added while invisible
	if godModeConnection then
		godModeConnection:Disconnect()
	end
	
	godModeConnection = char.DescendantAdded:Connect(function(desc)
		if godModeEnabled then
			if desc:IsA("BasePart") then
				originalCharacterTransparencies[desc] = desc.Transparency
				desc.Transparency = 1
				pcall(function()
					if desc:IsA("MeshPart") then
						desc.TextureID = ""
					end
				end)
			elseif desc:IsA("Decal") or desc:IsA("Texture") then
				originalCharacterTransparencies[desc] = desc.Transparency
				desc.Transparency = 1
			end
		end
	end)
end

local function makeVisible(char)
	if not char then return end
	
	for part, transparency in pairs(originalCharacterTransparencies) do
		if part and part.Parent then
			pcall(function()
				part.Transparency = transparency
			end)
		end
	end
	
	originalCharacterTransparencies = {}
	
	if godModeConnection then
		godModeConnection:Disconnect()
		godModeConnection = nil
	end
end

local function setupGodMode(char)
	if godModeEnabled then
		makeInvisible(char)
		print("✓ God Mode (Invisibility) Activated")
	end
end

