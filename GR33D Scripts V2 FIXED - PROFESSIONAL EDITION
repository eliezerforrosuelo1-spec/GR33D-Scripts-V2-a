-- ========== PRO TRAVEL TWEEN ===============================
-- ============================================================
local function travelTween(targetCFrame)
    if not rootPart or not character or not humanoid then return false end
    local startCFrame = rootPart.CFrame
    local distance = (targetCFrame.Position - startCFrame.Position).Magnitude
    if distance < 5 then
        pcall(function() rootPart.CFrame = targetCFrame end)
        return true
    end
    local duration = distance / CONFIG.TRAVEL_SPEED
    print(string.format("🚶 Traveling %.0f studs (%.1fs)...", distance, duration))

    local anchoredParts = {}
    for _, p in ipairs(character:GetDescendants()) do
        if p:IsA("BasePart") then
            anchoredParts[p] = p.Anchored
            p.Anchored = true
        end
    end

    local oldFF = character:FindFirstChildOfClass("ForceField")
    local tempFF
    if not oldFF then
        tempFF = Instance.new("ForceField")
        tempFF.Visible = false
        tempFF.Parent = character
    end

    pcall(function()
        humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    end)

    local info = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local tween = TweenService:Create(rootPart, info, {CFrame = targetCFrame})

    local done = false
    local conn
    conn = tween.Completed:Connect(function() done = true end)
    tween:Play()

    local startTime = tick()
    while not done and (tick() - startTime) < (duration + 2) do
        RunService.Heartbeat:Wait()
    end
    if conn then conn:Disconnect() end

    pcall(function() rootPart.CFrame = targetCFrame end)

    for part, wasAnchored in pairs(anchoredParts) do
        if part and part.Parent then
            pcall(function() part.Anchored = wasAnchored end)
        end
    end

    pcall(function()
