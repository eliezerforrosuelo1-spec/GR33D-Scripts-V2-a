-- ============================================================
-- ========== PRO ANTI-KNOCKBACK (DELAYED DAMPENER) ==========
-- ============================================================
-- This is the technique the "amazing script" used:
--   1. Detect sudden velocity spike (knockback)
--   2. Wait 2 frames (server registers the initial velocity)
--   3. Reduce velocity over 4 frames (looks like friction decay)
--   4. Server sees normal momentum loss, not manipulation
-- ============================================================

local function runKnockbackDampener()
    if knockbackInProgress then return end
    if not rootPart or not humanoid then return end
    if isFlying or runSpeedEnabled or isTeleporting then return end
    if not antiMeleeEnabled then return end

    local vel = rootPart.AssemblyLinearVelocity
    local horizontalSpeed = math.sqrt(vel.X * vel.X + vel.Z * vel.Z)

    -- Detect spike: speed went from low (walking/idle) to high (knockback)
    local isSpike = horizontalSpeed > CONFIG.KNOCKBACK_THRESHOLD
                    and lastHorizontalSpeed < CONFIG.KNOCKBACK_IDLE_MAX
    local isIdle = humanoid.MoveDirection.Magnitude < 0.1

    if isIdle and isSpike then
        knockbackInProgress = true

        -- Step 1: wait for server to see the initial knockback
        task.wait(CONFIG.KNOCKBACK_DELAY)

        -- Step 2: reduce gradually
        task.spawn(function()
            for frame = 1, CONFIG.KNOCKBACK_FRAMES do
                task.wait()
                if rootPart and rootPart.Parent then
                    local v = rootPart.AssemblyLinearVelocity
                    pcall(function()
                        rootPart.AssemblyLinearVelocity = Vector3.new(
                            v.X * CONFIG.KNOCKBACK_FACTOR,
                            v.Y,
                            v.Z * CONFIG.KNOCKBACK_FACTOR
                        )
                    end)
                end
            end
            task.wait(0.2)
            knockbackInProgress = false
        end)
    end

    lastHorizontalSpeed = horizontalSpeed
end

