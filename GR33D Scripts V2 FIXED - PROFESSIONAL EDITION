G.GR33D = G.GR33D or {}
G.GR33D.Toggle = function(name, value)
    if name == "Noclip" then G.NoclipActive = value
    elseif name == "GodMode" then
        godModeEnabled = value
        G.GodModeActive = value
        if character then
            if value then makeInvisible(character) else makeVisible(character) end
        end
    elseif name == "MegaHealth" then
        megaHealthEnabled = value
        G.MegaHealthActive = value
        if humanoid then
            humanoid.MaxHealth = value and 900000000 or 100
            humanoid.Health    = value and 900000000 or 100
        end
    elseif name == "SlimHitbox" then
        slimHitboxEnabled = value
        G.SlimHitboxActive = value
    elseif name == "NoSpeedLimit" then G.NoSpeedLimitActive = value
    elseif name == "AutoGrab" then G.AutoGrabActive = value
    elseif name == "Fly" then
        flyToggleEnabled = value
        if not value then setFlying(false) end
    elseif name == "RapidHealing" then rapidHealingEnabled = value
    elseif name == "NoFallDamage" then noFallDamageEnabled = value
    elseif name == "RunSpeed" then
        runSpeedEnabled = value
        if not value then
            teardownSpeedVelocity()
            if humanoid then pcall(function() humanoid.WalkSpeed = defaultWalkSpeed end) end
        end
    elseif name == "JumpPower" then
        jumpEnabled = value
        if not value then
            jumpImpulseApplied = false
            jumpImpulseTime = 0
            if humanoid and humanoid.UseJumpPower then
                pcall(function() humanoid.JumpPower = defaultJumpPower end)
            end
        end
    elseif name == "HitboxExpander" then hitboxEnabled = value
    elseif name == "Aimbot" then
        COMBAT.AimbotEnabled = value
        if value and COMBAT.BulletFollowEnabled then
            COMBAT.BulletFollowEnabled = false
            G.BulletFollowActive = false
            removeBulletFollowHook()
        end
    elseif name == "BulletFollow" then
        COMBAT.BulletFollowEnabled = value
