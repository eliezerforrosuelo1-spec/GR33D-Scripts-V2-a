-- ============================================================
-- ========== ANTI-CHEAT HOOK (STEALTH-HARDENED) =============
-- ============================================================
-- Improvements over V6.00:
--   1. Never blocks remotes that might be legit (empty blocklist)
--   2. Instead of blocking, silently lets suspicious calls through
--      but logs them (so we don't arouse suspicion by returning nil)
--   3. Only blocks kick/ban/report on self (safe targets)
--   4. Hide hook traces from scanners by masking closure env
-- ============================================================

local hooks = {
    anticheat    = nil,
    bulletFollow = nil,
}

local function installAntiCheatHook()
    if hooks.anticheat then return end
    local mt = getrawmetatable and getrawmetatable(game)
    if not mt then return end
    setreadonly(mt, false)

    local oldNamecall = mt.__namecall
    local oldNewIndex = mt.__newindex
    local oldIndex = mt.__index

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()

        -- Block ONLY safe-target methods (self-targeting only)
        if (method == "Kick" or method == "kick") and self == player then
            return nil
        end
        if method:lower():find("ban") and self == player then
            return nil
        end
        if (method == "ReportAbuse" or method == "reportAbuse") and self == game.Players then
            return nil
        end
        if method == "SaveInstance" then
            return nil
        end

        -- Everything else passes through normally.
        -- We do NOT block anti-cheat remotes anymore — that was risky.
        -- Blocking a legit remote returns nil → downstream code errors
        -- → suspicious. Letting it through is safer.
        return oldNamecall(self, ...)
    end)

    -- Protect our character's humanoid from external writes
    mt.__newindex = newcclosure(function(t, k, v)
        if not checkcaller() and typeof(t) == "Instance" then
            if t:IsA("Humanoid") then
                local char = player.Character
                if char and t:IsDescendantOf(char) then
                    if k == "MaxHealth" and megaHealthEnabled and v < 900000000 then
                        return
                    end
                    if k == "Health" and (megaHealthEnabled or godModeEnabled) then
                        return
                    end
                end
            end
        end
        return oldNewIndex(t, k, v)
    end)

    -- Hide our GUI from scans
    mt.__index = newcclosure(function(t, k)
        if typeof(t) == "Instance" then
            if k == "DevPanelGui" and not checkcaller() then
                return nil
            end
        end
        return oldIndex(t, k)
    end)

    setreadonly(mt, true)
    hooks.anticheat = oldNamecall
    print("[GR33D] ✓ Anti-cheat hook installed (non-intrusive mode)")
end

