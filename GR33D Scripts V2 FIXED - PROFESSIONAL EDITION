RunService.Heartbeat:Connect(function(deltaTime)
    if not camera or not camera.Parent then
        camera = Workspace.CurrentCamera
    end

    -- Run speed
    if runSpeedEnabled and humanoid and not isFlying then
        local moveDir = humanoid.MoveDirection
        if moveDir.Magnitude > 0 then
            humanoid.WalkSpeed = math.clamp(runSpeedValue, 16, 200)
        else
            humanoid.WalkSpeed = defaultWalkSpeed
        end
    elseif not runSpeedEnabled and humanoid then
        if humanoid.WalkSpeed ~= defaultWalkSpeed then
            humanoid.WalkSpeed = defaultWalkSpeed
        end
    end

    -- Rapid healing
    if rapidHealingEnabled and humanoid and humanoid.Health > 0
       and humanoid.Health < humanoid.MaxHealth then
        local healAmount = humanoid.MaxHealth * 3 * deltaTime
        humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + healAmount)
    end

    -- No fall damage
    if noFallDamageEnabled and rootPart and humanoid then
        local state = humanoid:GetState()
        if state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.FallingDown then
            pcall(function()
                if rootPart.AssemblyLinearVelocity.Y < -45 then
                    rootPart.AssemblyLinearVelocity = Vector3.new(
                        rootPart.AssemblyLinearVelocity.X, 0, rootPart.AssemblyLinearVelocity.Z)
                end
            end)
        end
    end

    -- Anti-melee
    if antiMeleeEnabled and rootPart and humanoid then
        local currentVel = rootPart.AssemblyLinearVelocity
        if humanoid.MoveDirection.Magnitude == 0 and not isFlying and not runSpeedEnabled then
            if math.abs(currentVel.X) > 4 or math.abs(currentVel.Z) > 4 then
                rootPart.AssemblyLinearVelocity = Vector3.new(0, currentVel.Y, 0)
            end
        end
    end

    -- Hitbox expander
    if hitboxEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if not originalHitboxSizes[hrp] then
                        originalHitboxSizes[hrp] = hrp.Size
                    end
                    hrp.Size = Vector3.new(8, 8, 8)
                    hrp.Transparency = 0.7
                    hrp.CanCollide = false
                end
            end
        end
    else
        for hrp, size in pairs(originalHitboxSizes) do
            if hrp and hrp.Parent then
                pcall(function()
                    hrp.Size = size
                    hrp.Transparency = 0
                    hrp.CanCollide = true
                end)
            end
            originalHitboxSizes[hrp] = nil
        end
    end

    -- Slim hitbox
    if rootPart then
        if slimHitboxEnabled then
            local targetSize = Vector3.new(1.5, 2, 0.8)
            rootPart.Size = rootPart.Size:Lerp(targetSize, 0.1)
            G.SlimHitboxActive = true
        elseif originalRootSize then
            rootPart.Size = rootPart.Size:Lerp(originalRootSize, 0.1)
            G.SlimHitboxActive = false
        end
    end

    -- Aimbot (camera) — still supported alongside bullet follow
    if aimbotEnabled and rootPart then
        local nearestTarget, shortestDist = nil, 100

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local isTeammate = false
                if player.Team and p.Team and (p.Team == player.Team or p.TeamColor == player.TeamColor) then
                    isTeammate = true
                end
                if p:GetAttribute("Team") and player:GetAttribute("Team")
                   and p:GetAttribute("Team") == player:GetAttribute("Team") then
                    isTeammate = true
                end

                if not isTeammate then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    if hrp and hum and hum.Health > 0
                       and not p.Character:FindFirstChildOfClass("ForceField") then
                        local dist = (hrp.Position - rootPart.Position).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            nearestTarget = hrp
                        end
                    end
                end
            end
        end

        for _, hrp in ipairs(cachedMonsters) do
            if hrp and hrp.Parent then
                local hum = hrp.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local dist = (hrp.Position - rootPart.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        nearestTarget = hrp
                    end
                end
            end
        end

        if nearestTarget then
            local goalCFrame = CFrame.new(camera.CFrame.Position, nearestTarget.Position + Vector3.new(0, 1.5, 0))
            camera.CFrame = camera.CFrame:Lerp(goalCFrame, 0.15)
            camera.CameraType = Enum.CameraType.Scriptable
        end
    elseif camera.CameraType == Enum.CameraType.Scriptable then
        -- Restore camera when aimbot is off
        camera.CameraType = Enum.CameraType.Custom
    end
end)

-- ========== FLIGHT RENDER LOOP ==========
RunService.RenderStepped:Connect(function(dt)
    if not camera or not camera.Parent then
        camera = Workspace.CurrentCamera
    end

    if isFlying and linearVelocity and humanoid and rootPart then
        if humanoid.FloorMaterial ~= Enum.Material.Air then
            setFlying(false)
        elseif controls then
            local moveVector = controls:GetMoveVector()
            if moveVector.Magnitude > 0 then
                local camCFrame = camera.CFrame
                local flightDir = (camCFrame.RightVector * moveVector.X) - (camCFrame.LookVector * moveVector.Z)
                linearVelocity.VectorVelocity = flightDir.Unit * FLY_SPEED
            else
                linearVelocity.VectorVelocity = Vector3.zero
            end
        end
    end

    if humanoid then
        if jumpEnabled then
            pcall(function()
                humanoid.UseJumpPower = true
                humanoid.JumpPower = jumpPowerValue
            end)
        else
            pcall(function()
                if humanoid.UseJumpPower and humanoid.JumpPower ~= defaultJumpPower then
                    humanoid.JumpPower = defaultJumpPower
                end
            end)
        end
    end
end)

