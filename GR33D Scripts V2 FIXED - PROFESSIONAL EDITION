-- ========== STATE SYNC INTERCEPTOR =========================
-- ============================================================
local SYNC_REMOTES = {
    ["State_SyncPrivate"] = true,
    ["State_SyncShared"]  = true,
}

local BLOCKED_SYNC_KEYS = {
    "reset", "resetPosition", "warpToSpawn", "warptospawn",
    "restoreWalls", "restorewalls", "restore",
    "outOfBounds", "outofbounds", "oosync", "syncReset",
    "teleport", "kick", "ban", "flag", "violation",
    "restrict", "deny", "invalid",
    "antiCheat", "anticheat", "acFlag", "acReset",
}

local function shouldStripKey(key)
    if type(key) ~= "string" then return false end
    local lower = key:lower()
    for _, blocked in ipairs(BLOCKED_SYNC_KEYS) do
        if key == blocked then return true end
    end
    if lower:find("reset") or lower:find("violation")
       or lower:find("outofbounds") or lower:find("warptospawn") then
        return true
    end
    return false
end

local function sanitizeSyncPayload(value, depth)
    depth = depth or 0
    if depth > 12 then return value end
    if type(value) ~= "table" then return value end
    local cleaned = {}
    for k, v in pairs(value) do
        if not shouldStripKey(k) then
            cleaned[k] = sanitizeSyncPayload(v, depth + 1)
        end
    end
    return cleaned
end

local function sanitizeValue(v)
    if type(v) == "string" then
        local lower = v:lower()
        if lower == "reset" or lower == "violation"
           or lower == "outofbounds" or lower == "warptospawn"
           or lower == "restorewalls" then
            return nil
        end
        return v
    elseif type(v) == "table" then
        return sanitizeSyncPayload(v)
    end
    return v
end

local function reinstallSyncHooks()
    if not CONFIG.SYNC_INTERCEPT then return end
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") and SYNC_REMOTES[obj.Name] then
            local signal = obj.OnClientEvent
            local existingFns = {}
            local existingConns = getconnections(signal)
            for _, conn in ipairs(existingConns) do
                if conn.Function then
                    table.insert(existingFns, conn.Function)
                end
            end
            for _, conn in ipairs(existingConns) do
                pcall(function() conn:Disconnect() end)
            end
            for _, fn in ipairs(existingFns) do
                signal:Connect(function(...)
                    local args = {...}
                    for i, arg in ipairs(args) do
                        args[i] = sanitizeValue(arg)
                    end
                    local cleanArgs = {}
                    for i = 1, select("#", ...) do
                        cleanArgs[i] = args[i]
                    end
                    pcall(fn, table.unpack(cleanArgs, 1, select("#", ...)))
                end)
            end
            print("[GR33D] ✓ Hooked " .. obj.Name .. " (" .. #existingFns .. " handlers)")
        end
    end
end

