local function createInput(parent, text, y, default, callback)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, 0, 0, 26)
    row.Position = UDim2.new(0, 0, 0, y)
    row.BackgroundTransparency = 1
    row.ClipsDescendants = false

    local label = Instance.new("TextLabel", row)
    label.Size = UDim2.new(0, 110, 1, 0)
    label.Position = UDim2.new(0, 0, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(190, 190, 205)
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 10
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextTruncate = Enum.TextTruncate.AtEnd
    label.ClipsDescendants = false

    local box = Instance.new("TextBox", row)
    box.Size = UDim2.new(0, 38, 0, 20)
    box.Position = UDim2.new(1, -42, 0.5, -10)
    box.BackgroundColor3 = Color3.fromRGB(26, 26, 35)
    box.Text = tostring(default)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.Font = Enum.Font.GothamBold
    box.TextSize = 10
    box.ClearTextOnFocus = false
    box.ZIndex = 2
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)

    box:GetPropertyChangedSignal("Text"):Connect(function()
        if callback then callback(box.Text) end
    end)
    box.FocusLost:Connect(function()
        if callback then callback(box.Text) end
    end)
end

