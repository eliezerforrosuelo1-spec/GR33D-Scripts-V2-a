local function runAimbotFrame()
    if not COMBAT.AimbotEnabled then return end
    if COMBAT.BulletFollowEnabled then return end
    if not rootPart or not camera then return end

    local target = getAimbotTarget(camera.CFrame.Position)
    if not target then return end

    local targetPart = target
    if AIMBOT_TARGET_PART == "Head" then
        local head = target.Parent and target.Parent:FindFirstChild("Head")
        if head then targetPart = head end
    end

    local camToTarget = (targetPart.Position - camera.CFrame.Position).Unit
    local camLook     = camera.CFrame.LookVector
    local dot = camToTarget:Dot(camLook)
    local angle = math.deg(math.acos(math.clamp(dot, -1, 1)))
    if angle > AIMBOT_FOV then return end

    local goalCFrame = CFrame.new(camera.CFrame.Position, targetPart.Position)
    camera.CFrame = camera.CFrame:Lerp(goalCFrame, AIMBOT_SMOOTHNESS)
end

-- ========== COMBAT: BULLET FOLLOW ==========
local trackedProjectiles = {}

local function findAndReplaceDir(value, newDir)
    if typeof(value) == "Vector3" then
        local mag = value.Magnitude
        if mag > 0.3 and mag < 5 then
            return newDir.Unit, true
        end
        return value, false
    elseif typeof(value) == "CFrame" then
        local pos = value.Position
        return CFrame.new(pos, pos + newDir.Unit), true
    elseif type(value) == "table" then
        local mutated = false
        for k, v in pairs(value) do
            local newV, changed = findAndReplaceDir(v, newDir)
            if changed then
                value[k] = newV
                mutated = true
                break
            end
        end
        return value, mutated
    end
    return value, false
end

local function tryRedirectFireArgs(args, originPos)
    if not COMBAT.BulletFollowEnabled then return nil end
    if not args or #args == 0 then return nil end

    local origin = originPos
    if not origin then
        for _, a in ipairs(args) do
            if typeof(a) == "Vector3" and a.Magnitude > 5 then
                origin = a
                break
            end
        end
    end
    if not origin then
        origin = (rootPart and rootPart.Position) or camera.CFrame.Position
    end

    local targetPart = getBulletFollowTarget(origin)
    if not targetPart then return nil end

    local aimPoint = targetPart.Position + Vector3.new(0, 1, 0)
    local head = targetPart.Parent and targetPart.Parent:FindFirstChild("Head")
    if head then aimPoint = head.Position end

    local newDir = aimPoint - origin

    local function deepCopy(t)
        if type(t) ~= "table" then return t end
        local c = {}
        for k, v in pairs(t) do c[k] = deepCopy(v) end
        return c
    end

    local newArgs = {}
    for i = 1, #args do newArgs[i] = deepCopy(args[i]) end

    for i, arg in ipairs(newArgs) do
        local newVal, changed = findAndReplaceDir(arg, newDir)
        if changed then
            newArgs[i] = newVal
            return newArgs, targetPart
        end
    end

    for i, arg in ipairs(newArgs) do
        if typeof(arg) == "Vector3" and arg.Magnitude > 5 then
            table.insert(newArgs, i + 1, newDir.Unit)
            return newArgs, targetPart
        end
    end

    return nil
end

local function shouldTrackProjectile(part)
    if not part or not part:IsA("BasePart") then return false end
    if character and part:IsDescendantOf(character) then return false end
    if part.Size.Magnitude > 8 then return false end
    return true
end

local function registerProjectile(part)
    if trackedProjectiles[part] then return end
    trackedProjectiles[part] = {
        spawnTime = os.clock(),
        maxAge = 5,
    }
end

task.spawn(function()
    while true do
        RunService.Heartbeat:Wait()
        if not COMBAT.BulletFollowEnabled then
            if next(trackedProjectiles) then trackedProjectiles = {} end
        else
            local now = os.clock()
            for part, info in pairs(trackedProjectiles) do
                if not part or not part.Parent then
                    trackedProjectiles[part] = nil
                elseif (now - info.spawnTime) > info.maxAge then
                    trackedProjectiles[part] = nil
                else
                    local targetPart = getBulletFollowTarget(part.Position)
                    if targetPart then
                        local toTarget = targetPart.Position - part.Position
                        if toTarget.Magnitude > 0.5 then
                            local speed = part.AssemblyLinearVelocity.Magnitude
                            if speed < 5 then speed = 100 end
                            pcall(function()
                                part.AssemblyLinearVelocity = toTarget.Unit * speed
                                part.CFrame = CFrame.new(part.Position, part.Position + toTarget.Unit)
                            end)
                        end
                    end
                end
            end
        end
    end
end)

