-- ========== STAT SCANNING ==========
local function scanAndExtractStats(targetObj)
    local statData = { Value = 0, Luck = 0, Size = 0, Weight = 0, RarityScore = 0 }
    if not targetObj then return statData end
    pcall(function()
        if targetObj:IsA("Model") then
            statData.Size = targetObj:GetExtentsSize().Magnitude
        elseif targetObj:IsA("BasePart") then
            statData.Size = targetObj.Size.Magnitude
        end
    end)
    local success, attrs = pcall(function() return targetObj:GetAttributes() end)
    if success and attrs then
        for attrName, val in pairs(attrs) do
            if attrName == nil or val == nil then continue end
            local nameLower = tostring(attrName):lower()
            local valStr    = tostring(val):lower()
            local numericVal = parseStatValue(val)
            local weightVal  = parseWeightValue(val)
            if nameLower == "value" or nameLower == "price" or nameLower == "cash"
               or nameLower == "money" or nameLower == "gamevalue"
               or nameLower:match("^val") or nameLower:match("value$") then
                if numericVal > statData.Value then statData.Value = numericVal end
            elseif nameLower:match("luck") then
                if numericVal > statData.Luck then statData.Luck = numericVal end
            elseif nameLower:match("weight") or nameLower:match("mass") then
                if weightVal > statData.Weight then statData.Weight = weightVal end
            elseif nameLower:match("size") then
                if numericVal > statData.Size then statData.Size = numericVal end
            elseif valStr:match("legendary") or valStr:match("mythic") or
                   valStr:match("secret") or nameLower:match("rarity") then
                statData.RarityScore = statData.RarityScore + 100
            end
        end
    end
    pcall(function()
        for _, desc in ipairs(targetObj:GetDescendants()) do
            if desc:IsA("TextLabel") then
                local parent = desc.Parent
                if parent and (parent:IsA("BillboardGui") or parent:IsA("SurfaceGui")) then
                    local text = desc.Text or ""
                    local textLower = text:lower()
                    text = text:gsub("^%s+", ""):gsub("%s+$", "")
                    local parsedVal    = parseStatValue(text)
                    local parsedWeight = parseWeightValue(text)
                    local hasWeight = textLower:match("%f[%a]ton%f[%A]")
                                      or textLower:match("%f[%a]kg%f[%A]")
                                      or textLower:match("%f[%a]tons%f[%A]")
                    if textLower:match("luck") or textLower:match("%%") then
                        if parsedVal > statData.Luck then statData.Luck = parsedVal end
                    elseif hasWeight then
                        if parsedWeight > statData.Weight then statData.Weight = parsedWeight end
                    else
                        if parsedVal > 0 and parsedVal > statData.Value then statData.Value = parsedVal end
                    end
                    if textLower:match("secret") or textLower:match("mythic") or
                       textLower:match("godly") or textLower:match("legendary") then
                        statData.RarityScore = statData.RarityScore + 500
                    end
                end
            end
        end
    end)
    return statData
end

-- ========== AUTO-GRAB ==========
local function cleanupPromptCache()
    for i = #cachedPrompts, 1, -1 do
        if not cachedPrompts[i] or not cachedPrompts[i].Parent then
            table.remove(cachedPrompts, i)
        end
    end
end

local function executeAutoGrabRoutine()
    if not rootPart then return end
    cleanupPromptCache()
    for _, prompt in ipairs(cachedPrompts) do
        if not isValidGrabPrompt(prompt) then continue end
        if grabCooldowns[prompt] and (os.clock() - grabCooldowns[prompt]) < 0.5 then continue end
        local targetModel = prompt:FindFirstAncestorOfClass("Model") or prompt.Parent
        if not targetModel then continue end
        local ok, distance = pcall(function()
            return (rootPart.Position - targetModel:GetPivot().Position).Magnitude
        end)
        if not ok then continue end
        if distance <= (prompt.MaxActivationDistance or 10) + 5 then
            local stats = scanAndExtractStats(targetModel)
            local targetVal  = G.TargetValue  or 0
            local targetLuck = G.TargetLuck   or 0
            local targetSize = G.TargetSize   or 0
            local meetsCriteria = false
            local activeFiltersCount = 0
            if targetVal  > 0 then activeFiltersCount = activeFiltersCount + 1 end
            if targetLuck > 0 then activeFiltersCount = activeFiltersCount + 1 end
            if targetSize > 0 then activeFiltersCount = activeFiltersCount + 1 end
            if activeFiltersCount == 0 then
                meetsCriteria = true
            else
                local valueMatches = true
                local luckMatches  = true
                local sizeMatches  = true
                if targetVal > 0 then
                    if math.abs(stats.Value - targetVal) > (targetVal * 0.25) then valueMatches = false end
                end
                if targetLuck > 0 then
                    if stats.Luck < targetLuck then luckMatches = false end
                end
                if targetSize > 0 then
                    if stats.Size < targetSize and stats.Weight < targetSize then sizeMatches = false end
                end
                meetsCriteria = (not (targetVal  > 0) or valueMatches) and
                                (not (targetLuck > 0) or luckMatches)  and
                                (not (targetSize > 0) or sizeMatches)
            end
            if meetsCriteria then
                local ok2 = pcall(function() fireproximityprompt(prompt) end)
                if ok2 then grabCooldowns[prompt] = os.clock() end
            end
        end
    end
end

-- ========== STEALTH TELEPORT ==========
local function stealthTeleport(targetCFrame)
    local char = character or player.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not root then return false end
    if hum then
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        end)
        local oldFF = char:FindFirstChildOfClass("ForceField")
        if not oldFF then
            local newFF = Instance.new("ForceField")
            newFF.Visible = false
            newFF.Parent = char
        end
    end
    local anchoredParts = {}
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            anchoredParts[p] = p.Anchored
            p.Anchored = true
        end
    end
    root.AssemblyLinearVelocity  = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    local startCFrame = root.CFrame
    for i = 1, 2 do
        local alpha = i / 2
        local base = startCFrame:Lerp(targetCFrame, alpha)
        local j = 2
        root.CFrame = base + Vector3.new(
            (math.random() * 2 - 1) * j * alpha,
            (math.random() * 2 - 1) * j * alpha,
            (math.random() * 2 - 1) * j * alpha
        )
        task.wait(0.02)
    end
    root.CFrame = targetCFrame
    for part, wasAnchored in pairs(anchoredParts) do
        if part and part.Parent then part.Anchored = wasAnchored end
    end
    if hum then
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
        end)
    end
    local newFF = char:FindFirstChildOfClass("ForceField")
    if newFF then
        task.delay(0.3, function()
            if newFF and newFF.Parent then newFF:Destroy() end
        end)
    end
    return true
end

local function parseMoneyFromModel(model)
    if not model then return 0 end
    local best = 0
    local ok, attrs = pcall(function() return model:GetAttributes() end)
    if ok and attrs then
        for name, val in pairs(attrs) do
            local n = tostring(name):lower()
            if n:find("value") or n:find("price") or n:find("cash") or n:find("worth") then
                if type(val) == "number" and val > best then best = val
                elseif type(val) == "string" then
                    local num = tonumber((val:gsub("[^%d%.]", "")))
                    if num and num > best then best = num end
                end
            end
        end
    end
    for _, desc in ipairs(model:GetDescendants()) do
        if desc:IsA("TextLabel") then
            local parent = desc.Parent
            if parent and (parent:IsA("BillboardGui") or parent:IsA("SurfaceGui")) then
                local txt = (desc.Text or ""):upper():gsub(",", "")
                local num, suffix = txt:match("%$%s*(%d+%.?%d*)([KMBT]?)")
                if num then
                    local v = tonumber(num) or 0
                    if suffix == "K" then v = v * 1e3
                    elseif suffix == "M" then v = v * 1e6
                    elseif suffix == "B" then v = v * 1e9
                    elseif suffix == "T" then v = v * 1e12
                    end
                    if v > best then best = v end
                end
            end
        end
    end
    return best
end

local function findHighestValue()
    local highestItem, highestPrompt, highestValue = nil, nil, -1
    local highestPart = nil
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local model, prompt
        if obj:IsA("Model") then model = obj
        elseif obj:IsA("ProximityPrompt") then
            prompt = obj
            model = obj:FindFirstAncestorOfClass("Model") or obj.Parent
        end
        if model and model ~= player.Character
           and not Players:GetPlayerFromCharacter(model) then
            local nameLower = model.Name:lower()
            local isFriendly = nameLower:find("shop") or nameLower:find("npc") or
                               nameLower:find("dummy") or nameLower:find("merchant") or
                               nameLower:find("guide") or nameLower:find("bank") or
                               nameLower:find("vendor") or nameLower:find("station")
            if not isFriendly then
                local value = parseMoneyFromModel(model)
                if value > highestValue then
                    local part = model.PrimaryPart
                                 or model:FindFirstChild("HumanoidRootPart")
                                 or model:FindFirstChildWhichIsA("BasePart")
                    if part then
                        highestValue = value
                        highestItem = model
                        highestPart = part
                        highestPrompt = prompt or model:FindFirstChildWhichIsA("ProximityPrompt", true)
                    end
                end
            end
        end
    end
    return highestItem, highestPart, highestPrompt, highestValue
end

