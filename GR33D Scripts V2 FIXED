-- ========== RAPID FIRE ==========
local COOLDOWN_KEYWORDS = {
    "cooldown", "delay", "fire", "rate", "speed", "mine", "dig",
    "swing", "hit", "reload", "firedelay"
}

local function applyRapidFire(tool)
    for _, v in ipairs(tool:GetDescendants()) do
        if v:IsA("NumberValue") or v:IsA("IntValue") then
            local n = v.Name:lower()
            local isCooldown = false
            for _, keyword in ipairs(COOLDOWN_KEYWORDS) do
                if n:find(keyword, 1, true) then isCooldown = true break end
            end
            if isCooldown then
                if originalToolValues[v] == nil then originalToolValues[v] = v.Value end
                v.Value = math.max(0.01, originalToolValues[v] * 0.1)
            end
        end
    end
end

local function disableRapidFire(tool)
    for _, v in ipairs(tool:GetDescendants()) do
        if originalToolValues[v] ~= nil then
            pcall(function() v.Value = originalToolValues[v] end)
            originalToolValues[v] = nil
        end
    end
end

function monitorTool(tool)
    if not tool or not tool:IsA("Tool") then return end
    if rapidFireEnabled then applyRapidFire(tool) else disableRapidFire(tool) end
    if toolConnections[tool] then toolConnections[tool]:Disconnect() toolConnections[tool] = nil end
    toolConnections[tool] = tool.DescendantAdded:Connect(function(v)
        if rapidFireEnabled and (v:IsA("NumberValue") or v:IsA("IntValue")) then
            applyRapidFire(tool)
        end
    end)
end

-- ========== BULLET FOLLOW PROJECTILE TRACKING ==========
local trackedProjectiles = {}

local function shouldTrackProjectile(part)
    if not part or not part:IsA("BasePart") then return false end
    if character and part:IsDescendantOf(character) then return false end
    if part.Size.Magnitude > 8 then return false end
    return true
end

task.spawn(function()
    while true do
        RunService.Heartbeat:Wait()
        if not COMBAT.BulletFollowEnabled then
            if next(trackedProjectiles) then trackedProjectiles = {} end
        else
            local now = os.clock()
            for part, info in pairs(trackedProjectiles) do
                if not part or not part.Parent then
                    trackedProjectiles[part] = nil
                elseif (now - info.spawnTime) > info.maxAge then
                    trackedProjectiles[part] = nil
                else
                    local targetPart = getBulletFollowTarget(part.Position)
                    if targetPart then
                        local toTarget = targetPart.Position - part.Position
                        if toTarget.Magnitude > 0.5 then
                            local speed = part.AssemblyLinearVelocity.Magnitude
                            if speed < 5 then speed = 100 end
                            pcall(function()
                                part.AssemblyLinearVelocity = toTarget.Unit * speed
                                part.CFrame = CFrame.new(part.Position, part.Position + toTarget.Unit)
                            end)
                        end
                    end
                end
            end
        end
    end
end)

Workspace.DescendantAdded:Connect(function(desc)
    if not COMBAT.BulletFollowEnabled then return end
    if shouldTrackProjectile(desc) then
        if not trackedProjectiles[desc] then
            trackedProjectiles[desc] = { spawnTime = os.clock(), maxAge = 5 }
        end
    end
end)

