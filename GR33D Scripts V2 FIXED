    -- because those match legitimate game remotes (PetClient, Water,
    -- GrappleHook, Timer, CharacterActions, etc.) and break the game.
    local BLOCKED_PATTERNS = {
        "anticheat", "anti_cheat",
        "exploit", "violation",
        "admincheck",
        "suspicious",
        "invalidmove", "speedcheck", "teleportcheck",
        "cheatdetection", "hackdetection",
    }
    local SAFE_REMOTES = {
        ["UpdateCharacter"] = true, ["Movement"] = true,
        ["Emote"] = true, ["Chat"] = true, ["Health"] = true,
    }

    local function getInstanceName(inst)
        if typeof(inst) == "Instance" then return inst.Name:lower() end
        return tostring(inst):lower()
    end

    local function isSuspiciousRemote(inst)
        local name = getInstanceName(inst)
        if SAFE_REMOTES[name] then return false end
        for _, pattern in ipairs(BLOCKED_PATTERNS) do
            if name:find(pattern, 1, true) then return true end
        end
        return false
    end

    local function isThrottled(remote)
        local now = os.clock()
        local key = tostring(remote)
        remoteCallTimes[key] = remoteCallTimes[key] or {}
        local calls = remoteCallTimes[key]
        local cutoff = now - 1
        for i = #calls, 1, -1 do
            if calls[i] < cutoff then table.remove(calls, i) end
        end
        if #calls >= STEALTH.RemoteMaxPerSecond then return true end
        table.insert(calls, now + math.random() * STEALTH.RemoteJitter)
        return false
    end

    local function jitterArgs(...)
        local args = { ... }
        local mutated = false
        for i, arg in ipairs(args) do
            if typeof(arg) == "Vector3" then
                local j = STEALTH.ArgJitter
                args[i] = arg + Vector3.new(
                    (math.random() * 2 - 1) * j,
                    (math.random() * 2 - 1) * j,
                    (math.random() * 2 - 1) * j
                )
                mutated = true
            end
        end
        if mutated then return args end
        return nil
    end

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()

        if (method == "Kick" or method == "kick") and self == game.Players.LocalPlayer then
            return nil
        end
        if STEALTH.BlockReports and (method == "ReportAbuse" or method == "reportAbuse") then
            if self == game.Players then return nil end
        end

        if not checkcaller() then
            if method == "FireServer" or method == "InvokeServer" then
                if isSuspiciousRemote(self) then return nil end
                if isThrottled(self) then return nil end
                local jitteredArgs = jitterArgs(...)
                if jitteredArgs then
                    return oldNamecall(self, table.unpack(jitteredArgs))
                end
            end
        end

        return oldNamecall(self, ...)
    end)

    mt.__newindex = newcclosure(function(t, k, v)
        if not checkcaller() and typeof(t) == "Instance" then
