-- ========== UTILITY FUNCTIONS ==========
local function parseStatValue(input)
	if type(input) == "number" then return input end
	if type(input) ~= "string" then return 0 end
	
	local upperInput = input:upper():gsub("%s+", "")
	if upperInput == "" or upperInput == "0" then return 0 end
	if upperInput:find("KG") or upperInput:find("TON") or upperInput:find("LUCK") or upperInput:find("%%") then return 0 end
	
	local numStr, suffix = upperInput:match("(%d+%.?%d*)([KMGT]?)")
	local num = tonumber(numStr)
	if not num then
		local cleaned = upperInput:gsub("[^0-9KMBT%.]", "")
		num = tonumber(cleaned:match("[%d%.]+"))
		if not num then return 0 end
		if cleaned:find("T") then return num * 1e12
		elseif cleaned:find("B") then return num * 1e9
		elseif cleaned:find("M") then return num * 1e6
		elseif cleaned:find("K") then return num * 1e3
		end
		return num
	end
	
	local multiplier = 1
	if suffix == "T" or upperInput:find("TRILLION") then multiplier = 1e12
	elseif suffix == "B" or upperInput:find("BILLION") then multiplier = 1e9
	elseif suffix == "M" or upperInput:find("MILLION") then multiplier = 1e6
	elseif suffix == "K" or upperInput:find("THOUSAND") then multiplier = 1e3
	end
	
	return num * multiplier
end

local function parseWeightValue(input)
	if type(input) == "number" then return input end
	if type(input) ~= "string" then return 0 end
	
	local upperInput = input:upper()
	local cleaned = upperInput:gsub("[^0-9%.]", "")
	local num = tonumber(cleaned:match("[%d%.]+"))
	if not num then return 0 end
	
	if upperInput:find("TON") then
		return num * 1000
	elseif upperInput:find("KG") then
		return num
	elseif upperInput:find("G") then
		return num / 1000
	end
	return num
end

local function isValidGrabPrompt(prompt)
	if not prompt or not prompt.Enabled then return false end
	local parentObj = prompt.Parent
	if not parentObj then return false end
	
	if parentObj:IsA("ScreenGui") or parentObj:IsA("BillboardGui") or parentObj:IsA("SurfaceGui") or parentObj:IsA("TextButton") or parentObj:IsA("ImageButton") then
		return false
	end
	
	local actionText = prompt.ActionText:lower()
	local objectText = prompt.ObjectText:lower()
	
	local blockedKeywords = {"buy", "purchase", "view", "shop", "robux", "configure", "finish", "mining", "backpack", "group", "gift", "verify", "claim", "full", "reward", "spin", "upgrade", "warmth", "heal"}
	for _, keyword in ipairs(blockedKeywords) do
		if actionText:find(keyword) or objectText:find(keyword) then
			return false
		end
	end
	
	local ancestor = prompt:FindFirstAncestorOfClass("Model")
	if ancestor then
		local nameLower = ancestor.Name:lower()
		for _, keyword in ipairs(blockedKeywords) do
			if nameLower:find(keyword) then return false end
		end
	end
	
	return true
end

-- ========== WEAPON TYPE DETECTION ==========
local function detectWeaponType()
    local backpack = player:FindFirstChildOfClass("Backpack")
    local equippedTool = character and character:FindFirstChildOfClass("Tool")
    
    local currentTool = equippedTool or (backpack and backpack:FindFirstChildOfClass("Tool"))
    
    if not currentTool then return "NONE" end
    
    local toolName = currentTool.Name:lower()
    local descValue = currentTool:FindFirstChild("Description")
    local toolDesc = (descValue and descValue:IsA("StringValue") and descValue.Value:lower()) or ""
    
    if toolName:match("gun") or toolName:match("pistol") or toolName:match("rifle") or 
       toolName:match("sniper") or toolName:match("shotgun") or toolName:match("blaster") or
       toolDesc:match("gun") or toolDesc:match("shoot") or toolDesc:match("bullet") then
        return "GUN"
    end
    
    if toolName:match("sword") or toolName:match("bat") or toolName:match("axe") or
       toolName:match("hammer") or toolName:match("club") or toolName:match("knife") or
       toolDesc:match("melee") or toolDesc:match("swing") or toolDesc:match("strike") then
        return "MELEE"
    end
    
    if toolName:match("rod") or toolName:match("projectile") or toolName:match("bow") then
        return "PROJECTILE"
    end
    
    return "UNKNOWN"
end

