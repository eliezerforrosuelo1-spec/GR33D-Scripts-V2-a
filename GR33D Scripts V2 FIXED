local function createCollapsibleGroup(parent, title, y, height)
    local header = Instance.new("TextButton", parent)
    header.Size = UDim2.new(1, 0, 0, 24)
    header.Position = UDim2.new(0, 0, 0, y)
    header.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    header.Text = " " .. title .. " ^"
    header.TextColor3 = Color3.fromRGB(220, 220, 230)
    header.Font = Enum.Font.GothamBold
    header.TextSize = 11
    header.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", header).CornerRadius = UDim.new(0, 5)

    local content = Instance.new("Frame", parent)
    content.Size = UDim2.new(1, 0, 0, height)
    content.Position = UDim2.new(0, 0, 0, y + 28)
    content.BackgroundTransparency = 1
    content.ClipsDescendants = false  -- allow children beyond bounds

    local open = true
    header.MouseButton1Click:Connect(function()
        open = not open
        content.Visible = open
        header.Text = " " .. title .. (open and " ^" or " v")
    end)
    return content, y + 32 + height
end

local function createToggle(parent, text, y, callback)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, 0, 0, 26)
    row.Position = UDim2.new(0, 0, 0, y)
    row.BackgroundTransparency = 1
    local label = Instance.new("TextLabel", row)
    label.Size = UDim2.new(0.62, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(190, 190, 205)
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 10
    label.TextXAlignment = Enum.TextXAlignment.Left
    local switch = Instance.new("TextButton", row)
    switch.Size = UDim2.new(0, 32, 0, 16)
    switch.Position = UDim2.new(1, -32, 0.5, -8)
    switch.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
    switch.Text = ""
    Instance.new("UICorner", switch).CornerRadius = UDim.new(1, 0)
    local knob = Instance.new("Frame", switch)
    knob.Size = UDim2.new(0, 12, 0, 12)
    knob.Position = UDim2.new(0, 2, 0.5, -6)
    knob.BackgroundColor3 = Color3.fromRGB(200, 200, 215)
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    local enabled = false
    switch.MouseButton1Click:Connect(function()
        enabled = not enabled
        switch.BackgroundColor3 = enabled and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(40, 40, 52)
        knob:TweenPosition(enabled and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        if callback then callback(enabled) end
    end)
end

