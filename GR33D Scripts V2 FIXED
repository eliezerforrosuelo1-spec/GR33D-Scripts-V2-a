local function applyRapidFire(tool)
	for _, v in ipairs(tool:GetDescendants()) do
		if v:IsA("NumberValue") or v:IsA("IntValue") then
			local n = v.Name:lower()
			if n:find("cooldown") or n:find("delay") or n:find("rate") or n:find("speed") then
				if not originalToolValues[v] then originalToolValues[v] = v.Value end
				v.Value = 0.01
			end
		end
	end
end

local function monitorTool(tool)
	if tool:IsA("Tool") then
		if rapidFireEnabled then applyRapidFire(tool) end
		tool.DescendantAdded:Connect(function(v)
			if rapidFireEnabled and (v:IsA("NumberValue") or v:IsA("IntValue")) then applyRapidFire(tool) end
		end)
	end
end

