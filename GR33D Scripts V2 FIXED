RunService.Heartbeat:Connect(function(deltaTime)
    if not camera or not camera.Parent then camera = Workspace.CurrentCamera end

    if humanoid and humanoid.Health > 0 then
        if runSpeedEnabled then
            if humanoid.WalkSpeed ~= runSpeedValue then
                pcall(function() humanoid.WalkSpeed = runSpeedValue end)
            end
        elseif not runSpeedEnabled and humanoid.WalkSpeed ~= defaultWalkSpeed then
            pcall(function() humanoid.WalkSpeed = defaultWalkSpeed end)
        end
    end

    if rapidHealingEnabled and humanoid and humanoid.Health > 0
       and humanoid.Health < humanoid.MaxHealth then
        local healAmount = humanoid.MaxHealth * 3 * deltaTime
        humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + healAmount)
    end

    if godModeEnabled and humanoid and humanoid.Health > 0 then
        if humanoid.Health >= humanoid.MaxHealth then
            humanoid.Health = humanoid.MaxHealth - 0.15
        end
    end

    if noFallDamageEnabled and rootPart and humanoid then
        local state = humanoid:GetState()
        if state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.FallingDown then
            pcall(function()
                if rootPart.AssemblyLinearVelocity.Y < -45 then
                    rootPart.AssemblyLinearVelocity = Vector3.new(
                        rootPart.AssemblyLinearVelocity.X, 0, rootPart.AssemblyLinearVelocity.Z)
                end
            end)
        end
    end

    if antiMeleeEnabled and rootPart and humanoid then
        local currentVel = rootPart.AssemblyLinearVelocity
        if humanoid.MoveDirection.Magnitude == 0 and not isFlying and not runSpeedEnabled then
            if math.abs(currentVel.X) > 4 or math.abs(currentVel.Z) > 4 then
                rootPart.AssemblyLinearVelocity = Vector3.new(0, currentVel.Y, 0)
            end
        end
    end

    if hitboxEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if not originalHitboxSizes[hrp] then originalHitboxSizes[hrp] = hrp.Size end
                    hrp.Size = Vector3.new(8, 8, 8)
                    hrp.Transparency = 0.7
                    hrp.CanCollide = false
                end
            end
        end
    else
        for hrp, size in pairs(originalHitboxSizes) do
            if hrp and hrp.Parent then
                pcall(function()
                    hrp.Size = size
                    hrp.Transparency = 0
                    hrp.CanCollide = true
                end)
            end
            originalHitboxSizes[hrp] = nil
        end
    end

    if rootPart then
        if slimHitboxEnabled then
            local targetSize = Vector3.new(1.5, 2, 0.8)
            rootPart.Size = rootPart.Size:Lerp(targetSize, 0.1)
            G.SlimHitboxActive = true
        elseif originalRootSize then
            rootPart.Size = rootPart.Size:Lerp(originalRootSize, 0.1)
            G.SlimHitboxActive = false
        end
    end

    if COMBAT.AimbotEnabled and rootPart and camera then
        local target = getBulletFollowTarget(camera.CFrame.Position)
        if target then
            local targetPart = target
            if AIMBOT_TARGET_PART == "Head" then
                local head = target.Parent and target.Parent:FindFirstChild("Head")
                if head then targetPart = head end
            end
            local camToTarget = (targetPart.Position - camera.CFrame.Position).Unit
            local camLook = camera.CFrame.LookVector
            local dot = camToTarget:Dot(camLook)
            local angle = math.deg(math.acos(math.clamp(dot, -1, 1)))
            if angle <= AIMBOT_FOV then
                local goalCFrame = CFrame.new(camera.CFrame.Position, targetPart.Position)
                camera.CFrame = camera.CFrame:Lerp(goalCFrame, AIMBOT_SMOOTHNESS)
                camera.CameraType = Enum.CameraType.Scriptable
            end
        end
    elseif not COMBAT.AimbotEnabled and not COMBAT.BulletFollowEnabled then
        if camera.CameraType == Enum.CameraType.Scriptable then
            camera.CameraType = Enum.CameraType.Custom
        end
    end
end)

-- ========== FLIGHT RENDER (BUG FIX #1, #2) ==========
RunService.RenderStepped:Connect(function(dt)
    if not camera or not camera.Parent then camera = Workspace.CurrentCamera end

    if isFlying and flyVelocity and humanoid and rootPart then
        -- Auto-land check: multiple conditions must confirm landing
        local grounded = isGrounded()
        local stopped  = controls and controls:GetMoveVector().Magnitude == 0

        if grounded and stopped then
            -- Fully landed and not moving → cancel flight
            setFlying(false)
        elseif grounded and humanoid.FloorMaterial ~= Enum.Material.Air then
            -- Touching ground with material set → cancel
            setFlying(false)
        else
            -- Keep flying
            if flyVelocity.MaxForce < 9e4 then
                flyVelocity.MaxForce = 9e4
            end
            if controls then
                local moveVector = controls:GetMoveVector()
                if moveVector.Magnitude > 0 then
                    local camCFrame = camera.CFrame
                    local flightDir = (camCFrame.RightVector * moveVector.X) - (camCFrame.LookVector * moveVector.Z)
                    flyVelocity.VectorVelocity = flightDir.Unit * FLY_SPEED
                else
                    flyVelocity.VectorVelocity = Vector3.zero
                end
            end
        end
    end

    if humanoid then
        if jumpEnabled then
            pcall(function()
                humanoid.UseJumpPower = true
                humanoid.JumpPower = jumpPowerValue
                -- BUG FIX #9: don't force JumpHeight = 0 unless it was originally using Height
                if humanoid.JumpHeight ~= 0 then
                    humanoid.JumpHeight = 0
                end
            end)
        end
    end
end)

